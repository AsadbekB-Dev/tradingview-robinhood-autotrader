f_diagPage1C8(table t) =>
    f_header(t, 8, "MANAGEMENT COHORTS", "Trades | WR | PF")
    f_pair(t, 8, 1, "Low-Loss Armed", f_diagArrLine(diagMgmtT, diagMgmtW, diagMgmtGP, diagMgmtGL, 0), f_diagArrColor(diagMgmtT, diagMgmtW, diagMgmtGP, diagMgmtGL, 0))
