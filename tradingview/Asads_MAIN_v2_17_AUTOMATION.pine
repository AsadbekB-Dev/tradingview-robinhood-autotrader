    f_pair(t, 6, 6, "FP mild opposed", f_diagArrLine(diagFPT, diagFPW, diagFPGP, diagFPGL, 1), f_diagArrColor(diagFPT, diagFPW, diagFPGP, diagFPGL, 1))
    f_pair(t, 6, 7, "FP neutral/aligned", f_diagArrLine(diagFPT, diagFPW, diagFPGP, diagFPGL, 2), f_diagArrColor(diagFPT, diagFPW, diagFPGP, diagFPGL, 2))
    f_pair(t, 6, 8, "FP strong aligned", f_diagArrLine(diagFPT, diagFPW, diagFPGP, diagFPGL, 3), f_diagArrColor(diagFPT, diagFPW, diagFPGP, diagFPGL, 3))
    f_pair(t, 6, 11, "FP live delta", fpAvailable ? str.tostring(fpDeltaPct * 100.0, "#.1") + "%" : "N/A", color.white)
    f_pair(t, 6, 12, "Cross live", crossState, color.white)

