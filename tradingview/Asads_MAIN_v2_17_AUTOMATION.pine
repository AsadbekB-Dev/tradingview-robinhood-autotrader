v23PutOpeningOnly0700to0800 = input.bool(true, "PUT Opening Breakout Only 10:00-11:00 ET", group = groupV23)
v23PutBreakoutOnly0800to0900 = input.bool(true, "PUT Normal Breakout Only 11:00-12:00 ET", group = groupV23)

groupV24 = "5AA. v2.6 Core Opportunity Engine"
