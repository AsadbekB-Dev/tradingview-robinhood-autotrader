    f_pair(t, 2, 7, "MAE < .15", f_diagArrLine(diagMAET, diagMAEW, diagMAEGP, diagMAEGL, 0), f_diagArrColor(diagMAET, diagMAEW, diagMAEGP, diagMAEGL, 0))
    f_pair(t, 2, 8, "MAE .15-.30", f_diagArrLine(diagMAET, diagMAEW, diagMAEGP, diagMAEGL, 1), f_diagArrColor(diagMAET, diagMAEW, diagMAEGP, diagMAEGL, 1))
    f_pair(t, 2, 9, "MAE .30-.50", f_diagArrLine(diagMAET, diagMAEW, diagMAEGP, diagMAEGL, 2), f_diagArrColor(diagMAET, diagMAEW, diagMAEGP, diagMAEGL, 2))
    f_pair(t, 2, 10, "MAE >= .50", f_diagArrLine(diagMAET, diagMAEW, diagMAEGP, diagMAEGL, 3), f_diagArrColor(diagMAET, diagMAEW, diagMAEGP, diagMAEGL, 3))
