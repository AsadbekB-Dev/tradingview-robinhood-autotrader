var array<float> diagTierGL = array.new_float(1, 0.0)

var int diagLongCandidates = 0
var int diagShortCandidates = 0

var int diagV29RawA = 0
var int diagV29ATRBlocked = 0
var int diagV29EffBlocked = 0
var int diagV29BodyBlocked = 0
var int diagV29AcceptedA = 0
var int diagV210ATRRescued = 0
var int diagLongAccepted = 0
var int diagShortAccepted = 0
var array<int> diagLongFilter = array.new_int(18, 0)
var array<int> diagShortFilter = array.new_int(18, 0)
var array<int> diagRawLongSetup = array.new_int(6, 0)
var array<int> diagRawShortSetup = array.new_int(6, 0)

bool callEntryEvent = false
bool putEntryEvent = false
bool exitEvent = false
bool stopDayEvent = false

float histEntryLine = tradeDirection != 0 ? entryPrice : na
float histStopLine = tradeDirection != 0 ? stopPrice : na
float histHardStopLine = tradeDirection != 0 ? hardStopPrice : na
float histTargetLine = tradeDirection != 0 ? targetPrice : na

currentlyInPosition = strategy.position_size != 0
newClosedTrade = strategy.closedtrades > nz(strategy.closedtrades[1], 0)

orphanTradeState =
     tradeDirection != 0 and
     strategy.position_size == 0 and
     not closingRequested and
     not na(entryBar) and
     bar_index > entryBar + 1

barsSinceExit = na(lastExitBar) ? 9999 : bar_index - lastExitBar
cooldownOK = barsSinceExit > cooldownBars

if reentryBlockedDirection == 1
    bool longReset =
         (low <= ema9 and close >= ema9) or
         low <= ema21 + atr * resetTouchATR or
         efficiency < minEntryEfficiency * 0.80 or
         (not na(reentryBlockBar) and bar_index - reentryBlockBar >= sameDirResetMaxBars)
    if longReset
        reentryBlockedDirection := 0
        reentryBlockBar := na

if reentryBlockedDirection == -1
    bool shortReset =
         (high >= ema9 and close <= ema9) or
         high >= ema21 - atr * resetTouchATR or
         efficiency < minEntryEfficiency * 0.80 or
         (not na(reentryBlockBar) and bar_index - reentryBlockBar >= sameDirResetMaxBars)
    if shortReset
        reentryBlockedDirection := 0
        reentryBlockBar := na

bool executionReady = executionMode == "Live - Intrabar" or barstate.isconfirmed

canEnter =
     inTradeSession and
     dayAllowed and
     not fpRequiredMissing and
     not inHardStop and
     not dayDone and
     tradeDirection == 0 and
     strategy.position_size == 0 and
     cooldownOK and
     executionReady

longBaseTrigger = longTrigger or pressureContinuationLong
shortBaseTrigger = shortTrigger or pressureContinuationShort

longSpecialSetup = pullbackLong or vwapReclaimLong
shortSpecialSetup = pullbackShort or vwapReclaimShort
longOpeningSetup = orBreakLong
shortOpeningSetup = orBreakShort
longContinuationSetup = breakoutLong or pressureContinuationLong or orBreakLong
shortContinuationSetup = breakoutShort or pressureContinuationShort or orBreakShort

currentMinuteET = hour(time, sessionTZ) * 60 + minute(time, sessionTZ)
after1200ET = currentMinuteET >= 720
after1300ET = currentMinuteET >= 780
inOpeningHourET = currentMinuteET >= 570 and currentMinuteET < 630

longExt9Now = atr > 0 ? (close - ema9) / atr : 0.0
shortExt9Now = atr > 0 ? (ema9 - close) / atr : 0.0
longExt21Now = atr > 0 ? (close - ema21) / atr : 0.0
shortExt21Now = atr > 0 ? (ema21 - close) / atr : 0.0
longMove3Now = atr > 0 ? (close - close[3]) / atr : 0.0
shortMove3Now = atr > 0 ? (close[3] - close) / atr : 0.0
signalBodyATRNow = atr > 0 ? body / atr : 0.0
signalRangeATRNow = atr > 0 ? barRange / atr : 0.0

longBreakoutStyle = breakoutLong or pressureContinuationLong or orBreakLong
shortBreakoutStyle = breakoutShort or pressureContinuationShort or orBreakShort

longChaseScore =
     (longExt9Now >= openingChaseExt9ATR ? 1 : 0) +
     (longMove3Now >= openingChaseMove3ATR ? 1 : 0) +
     (signalBodyATRNow >= openingChaseBodyATR ? 1 : 0) +
     (signalRangeATRNow >= openingChaseRangeATR ? 1 : 0)

shortChaseScore =
     (shortExt9Now >= openingChaseExt9ATR ? 1 : 0) +
     (shortMove3Now >= openingChaseMove3ATR ? 1 : 0) +
     (signalBodyATRNow >= openingChaseBodyATR ? 1 : 0) +
     (signalRangeATRNow >= openingChaseRangeATR ? 1 : 0)

openingLongChase =
     useOpeningChaseFilter and
     inOpeningHourET and
     longBreakoutStyle and
     longChaseScore >= openingChaseVotes

openingShortChase =
     useOpeningChaseFilter and
     inOpeningHourET and
     shortBreakoutStyle and
     shortChaseScore >= openingChaseVotes

longClimaxScore =
     (longExt9Now >= climaxExt9ATR ? 1 : 0) +
     (longExt21Now >= climaxExt21ATR ? 1 : 0) +
     (longMove3Now >= climaxMove3ATR ? 1 : 0) +
     (signalBodyATRNow >= climaxBodyATR ? 1 : 0) +
     (rvol >= climaxRVOL ? 1 : 0) +
     (atrRatio >= climaxATRRatio ? 1 : 0)

shortClimaxScore =
     (shortExt9Now >= climaxExt9ATR ? 1 : 0) +
     (shortExt21Now >= climaxExt21ATR ? 1 : 0) +
     (shortMove3Now >= climaxMove3ATR ? 1 : 0) +
     (signalBodyATRNow >= climaxBodyATR ? 1 : 0) +
     (rvol >= climaxRVOL ? 1 : 0) +
     (atrRatio >= climaxATRRatio ? 1 : 0)

firstHourLongBreakoutClimax =
     useFirstHourBreakoutClimaxFilter and
     inOpeningHourET and
     breakoutLong and not orBreakLong and
     longClimaxScore >= climaxVotes

firstHourShortBreakoutClimax =
     useFirstHourBreakoutClimaxFilter and
     inOpeningHourET and
     breakoutShort and not orBreakShort and
     shortClimaxScore >= climaxVotes

longSpecialQuality =
     not longSpecialSetup or
     (longContextCount == 3 and
      adx >= specialSetupMinADX and
      efficiency >= specialSetupMinEfficiency and
      crossLongNotOpposed)

shortSpecialQuality =
     not shortSpecialSetup or
     (shortContextCount == 3 and
      adx >= specialSetupMinADX and
      efficiency >= specialSetupMinEfficiency and
      crossShortNotOpposed)

putEarlyContinuationOK =
     not pressureContinuationShort or
     (not disablePutEarlyContinuation and
      strongShortTrend and crossStrongShort)

exceptionalEarlyPutBreakout =
     strongShortTrend and
     adx >= earlyPutBreakoutMinADX and
     efficiency >= earlyPutBreakoutMinEfficiency and
     shortContextCount == 3 and
     ema9 < ema9[1] and ema21 < ema21[1] and
     close < ema9 and close < ema21 and close < vwap and
     (not earlyPutBreakoutNeedCrossStrong or crossStrongShort)

putBreakoutOK =
     not breakoutShort or
     shortOpeningSetup or
     (
       adx >= putBreakoutMinADX and
       efficiency >= putBreakoutMinEfficiency and
       shortContextCount == 3 and
       ema9 < ema9[1] and ema21 <= ema21[1] and
       close < ema9 and close < ema21 and close < vwap and
       (not putBreakoutNeedsExternalConfirm or (strongShortTrend and crossStrongShort)) and
       (
         not restrictPutBreakoutBefore0900 or
         after1200ET or
         exceptionalEarlyPutBreakout
       )
     )

putEMAPullbackOK =
     not pullbackShort or
     (
       not disablePutEMAPullback and
       (
         not putEMAPullbackNeedsStrongTrend or
         (strongShortTrend and crossStrongShort and
          adx >= putBreakoutMinADX and
          efficiency >= putBreakoutMinEfficiency)
       )
     )

putSideQuality =
     shortOpeningSetup or
     (adx >= putMinADX and
      efficiency >= putMinEfficiency and
      (not putRequireFullContext or shortContextCount == 3) and
      putEarlyContinuationOK and
      putBreakoutOK and
      putEMAPullbackOK and
      (crossStrongShort or strongShortTrend))

lateLongQuality =
     not lateSessionStrict or not after1300ET or
     (longContinuationSetup and
      longContextCount == 3 and
      adx >= lateSessionMinADX and
      efficiency >= lateSessionMinEfficiency and
      (crossStrongLong or strongLongTrend))

lateShortQuality =
     not lateSessionStrict or not after1300ET or
     (shortContinuationSetup and
      shortContextCount == 3 and
      adx >= lateSessionMinADX and
      efficiency >= lateSessionMinEfficiency and
      (crossStrongShort or strongShortTrend))

bool v23ATRZoneOK = not v23AvoidATRTransition or atrRatio < 0.80 or atrRatio >= 1.00
bool v23NormalShapeLong =
     longLeadScore >= v23NormalLeadMin and longLeadScore < v23NormalLeadMax and
     efficiency >= v23MinEfficiency and efficiency < v23MaxEfficiency and
     rvol < v23MaxRVOL and
     signalRangeATRNow < v23MaxRangeATR and
     longExt9Now < v23MaxExt9ATR and
     not strongLongTrend

bool v23NormalShapeShort =
     shortLeadScore >= v23NormalLeadMin and shortLeadScore < v23NormalLeadMax and
     efficiency >= v23MinEfficiency and efficiency < v23MaxEfficiency and
     rvol < v23MaxRVOL and
     signalRangeATRNow < v23MaxRangeATR and
     shortExt9Now < v23MaxExt9ATR and
     not strongShortTrend

bool v23EarlyShapeLong =
     pressureContinuationLong and not longTrigger and
     longLeadScore >= v23EarlyLeadMin and longLeadScore < v23EarlyLeadMax and
     signalRangeATRNow < v23MaxRangeATR * 1.15 and
     rvol < v23MaxRVOL * 1.35

bool v23CallTimeOK =
     currentMinuteET >= 570 and currentMinuteET < 780 and
     (not v23BlockCall0700to0800 or currentMinuteET < 600 or currentMinuteET >= 660) and
     (not v23BlockCallAfter1000 or currentMinuteET < 780)

bool v23PutORTimeOK =
     not v23PutOpeningOnly0700to0800 or
     (currentMinuteET >= 600 and currentMinuteET < 660)

bool v23PutBreakTimeOK =
     not v23PutBreakoutOnly0800to0900 or
     (currentMinuteET >= 660 and currentMinuteET < 720)

bool v23CallFamily =
     v23EarlyShapeLong or
     (breakoutLong and not orBreakLong and v23NormalShapeLong)

bool v23PutFamily =
     (orBreakShort and v23PutORTimeOK and
      shortLeadScore >= v23NormalLeadMin and shortLeadScore < v23NormalLeadMax and
      efficiency >= v23MinEfficiency and efficiency < v23MaxEfficiency and
      signalRangeATRNow < v23MaxRangeATR and rvol < v23MaxRVOL) or
     (breakoutShort and not orBreakShort and v23PutBreakTimeOK and v23NormalShapeShort)

bool v23PrecisionLongSignal =
     canEnter and reentryBlockedDirection != 1 and
     v23CallTimeOK and v23ATRZoneOK and v23CallFamily and
     longContextOK and adx >= minEntryADX and
     crossLongNotOpposed and fpLongNotOpposed and
     not chopCondition and not bullReversalRisk and
     not openingLongChase and not firstHourLongBreakoutClimax

bool v23PrecisionShortSignal =
     canEnter and reentryBlockedDirection != -1 and
     v23ATRZoneOK and v23PutFamily and
     shortContextOK and adx >= minEntryADX and
     crossShortNotOpposed and fpShortNotOpposed and
     not chopCondition and not bearReversalRisk and
     not openingShortChase and not firstHourShortBreakoutClimax

bool v24CloseWindow = currentMinuteET >= 930 and currentMinuteET < 960
bool v24DailyRoom = v24EntriesToday < v24MaxEntriesPerDay

bool v24NormalCanEnter =
     inTradeSession and dayAllowed and not fpRequiredMissing and
     not inHardStop and not dayDone and tradeDirection == 0 and
     strategy.position_size == 0 and cooldownOK and executionReady and
     v24DailyRoom and currentMinuteET < 900

bool v24CloseCanEnter =
     inTradeSession and dayAllowed and not fpRequiredMissing and
     tradeDirection == 0 and strategy.position_size == 0 and
     cooldownOK and executionReady and v24DailyRoom and v24CloseWindow

float v24LongSetupPts =
     pressureContinuationLong and not longTrigger ? 34.0 :
     breakoutLong and not orBreakLong ? 30.0 :
     orBreakLong ? 16.0 :
     liquiditySweepLong ? 14.0 :
     vwapReclaimLong ? 12.0 :
     pullbackLong ? 10.0 : 0.0

float v24ShortSetupPts =
     orBreakShort ? 26.0 :
     breakoutShort and not orBreakShort ? 24.0 :
     pressureContinuationShort and not shortTrigger ? 18.0 :
     liquiditySweepShort ? 14.0 :
     vwapReclaimShort ? 8.0 :
     pullbackShort ? 8.0 : 0.0

float v24LongTimePts =
     currentMinuteET < 600 ? 15.0 :
     currentMinuteET < 660 ? -4.0 :
     currentMinuteET < 720 ? 15.0 :
     currentMinuteET < 780 ? 7.0 :
     currentMinuteET < 840 ? -14.0 :
     currentMinuteET < 900 ? 0.0 : -20.0

float v24ShortTimePts =
     currentMinuteET < 600 ? 5.0 :
     currentMinuteET < 660 ? 12.0 :
     currentMinuteET < 720 ? 15.0 :
     currentMinuteET < 780 ? -10.0 :
     currentMinuteET < 840 ? -12.0 :
     currentMinuteET < 900 ? 0.0 : -20.0

float v24LongLeadPts =
     longLeadScore >= 80 ? 6.0 :
     longLeadScore >= 60 ? 10.0 :
     longLeadScore >= 50 ? 4.0 : -8.0

float v24ShortLeadPts =
     shortLeadScore >= 80 ? 6.0 :
     shortLeadScore >= 60 ? 10.0 :
     shortLeadScore >= 50 ? 4.0 : -8.0

float v24EfficiencyPts =
     efficiency >= 0.27 and efficiency < 0.55 ? 8.0 :
     efficiency >= 0.18 and efficiency < 0.27 ? 2.0 :
     efficiency >= 0.55 ? -4.0 : -8.0

float v24ADXPts =
     adx >= 18 and adx < 23 ? 6.0 :
     adx >= minEntryADX and adx < 18 ? 4.0 :
     adx >= 23 and adx < 30 ? 0.0 :
     adx >= 30 ? -2.0 : -8.0

float v24LongContextPts = longContextCount == 2 ? 7.0 : longContextCount >= 3 ? 2.0 : -10.0
float v24ShortContextPts = shortContextCount == 2 ? 7.0 : shortContextCount >= 3 ? 2.0 : -10.0

float v24RVOLPts = rvol < 1.30 ? 4.0 : -5.0
float v24ATRPts =
     atrRatio < 0.80 ? -5.0 :
     atrRatio < 1.00 ? -2.0 :
     atrRatio < 1.20 ? 6.0 : 4.0

float v24RangePts =
     signalRangeATRNow < 1.20 ? 5.0 :
     signalRangeATRNow < 1.60 ? 0.0 : -7.0

float v24LongExtPts =
     longExt9Now >= 0.25 and longExt9Now < 0.80 ? 4.0 :
     longExt9Now < 1.20 ? 1.0 : -6.0

float v24ShortExtPts =
     shortExt9Now >= 0.25 and shortExt9Now < 0.80 ? 4.0 :
     shortExt9Now < 1.20 ? 1.0 : -6.0

float v24LongCrossPts = crossStrongLong ? 4.0 : crossMixed ? -2.0 : 0.0
float v24ShortCrossPts = crossStrongShort ? 4.0 : crossMixed ? -2.0 : 0.0
float v24LongFPPts = fpMode == "Off" or not fpAvailable ? 0.0 : fpStrongBuy ? 4.0 : fpDeltaPct >= 0 ? 2.0 : 0.0
float v24ShortFPPts = fpMode == "Off" or not fpAvailable ? 0.0 : fpStrongSell ? 4.0 : fpDeltaPct <= 0 ? 2.0 : 0.0

float v24LongOpportunityScore =
     v24LongSetupPts + v24LongTimePts + v24LongLeadPts +
     v24EfficiencyPts + v24ADXPts + v24LongContextPts +
     v24RVOLPts + v24ATRPts + v24RangePts + v24LongExtPts +
     v24LongCrossPts + v24LongFPPts

float v24ShortOpportunityScore =
     v24ShortSetupPts + v24ShortTimePts + v24ShortLeadPts +
     v24EfficiencyPts + v24ADXPts + v24ShortContextPts +
     v24RVOLPts + v24ATRPts + v24RangePts + v24ShortExtPts +
     v24ShortCrossPts + v24ShortFPPts

bool v24LongScoreSignal =
     v24NormalCanEnter and reentryBlockedDirection != 1 and
     longBaseTrigger and longContextOK and adx >= minEntryADX and
     not chopCondition and crossLongNotOpposed and fpLongNotOpposed and
     not bullReversalRisk and not openingLongChase and
     not firstHourLongBreakoutClimax and
     v24LongOpportunityScore >= v24LongScoreMin

bool v24ShortScoreSignal =
     v24NormalCanEnter and reentryBlockedDirection != -1 and
     shortBaseTrigger and shortContextOK and adx >= minEntryADX and
     not chopCondition and crossShortNotOpposed and fpShortNotOpposed and
     not bearReversalRisk and not openingShortChase and
     not firstHourShortBreakoutClimax and
     v24ShortOpportunityScore >= v24ShortScoreMin

float v24OpeningDriveATR =
     atr > 0 and not na(sessionOpenPrice) and not na(openingClosePrice) ?
     (openingClosePrice - sessionOpenPrice) / atr : 0.0

bool v24LongCloseMomentum =
     v24EnableCloseMomentum and v24CloseCanEnter and
     v24OpeningDriveATR >= v24CloseOpenDriveATR and
     close > sessionOpenPrice and close > vwap and
     ema9 > ema21 and plusDI > minusDI and
     longContextCount >= 2 and longLeadScore >= v24CloseLeadMin and
     efficiency >= v24CloseMinEfficiency and
     crossLongNotOpposed and fpLongNotOpposed and
     not bullReversalRisk and signalRangeATRNow < 1.60

bool v24ShortCloseMomentum =
     v24EnableCloseMomentum and v24CloseCanEnter and
     v24OpeningDriveATR <= -v24CloseOpenDriveATR and
     close < sessionOpenPrice and close < vwap and
     ema9 < ema21 and minusDI > plusDI and
     shortContextCount >= 2 and shortLeadScore >= v24CloseLeadMin and
     efficiency >= v24CloseMinEfficiency and
     crossShortNotOpposed and fpShortNotOpposed and
     not bearReversalRisk and signalRangeATRNow < 1.60

bool v29ATRInDeadZone =
     v29SkipATRDeadZone and atrRatio >= v29ATRDeadLow and atrRatio < v29ATRDeadHigh

bool v29EfficiencyQualityOK =
     not v29UseEfficiencyCap or efficiency <= v29MaxEfficiency

bool v29BodyQualityOK =
     not v29UseMinBody or signalBodyATRNow >= v29MinBodyATR

bool v210LongContextOK = not v210RequireContext3 or longContextCount >= 3
bool v210ShortContextOK = not v210RequireContext3 or shortContextCount >= 3

bool v210LongDI_OK = not v210RequireDirectionDI or plusDI > minusDI
bool v210ShortDI_OK = not v210RequireDirectionDI or minusDI > plusDI

bool v210LongFlowOK =
     not v210RequireOneFlowConfirm or
     crossStrongLong or fpStrongBuy

bool v210ShortFlowOK =
     not v210RequireOneFlowConfirm or
     crossStrongShort or fpStrongSell

bool v210LongATRRescue =
     useV210ATRRescue and v29ATRInDeadZone and
     v210LongContextOK and longLeadScore >= v210MinLead and adx >= v210MinADX and
     v210LongDI_OK and v210LongFlowOK and
     crossLongNotOpposed and fpLongNotOpposed and
     not chopCondition and not bullReversalRisk

bool v210ShortATRRescue =
     useV210ATRRescue and v29ATRInDeadZone and
     v210ShortContextOK and shortLeadScore >= v210MinLead and adx >= v210MinADX and
     v210ShortDI_OK and v210ShortFlowOK and
     crossShortNotOpposed and fpShortNotOpposed and
     not chopCondition and not bearReversalRisk

bool v210LongATRQualityOK =
     not v29SkipATRDeadZone or not v29ATRInDeadZone or v210LongATRRescue

bool v210ShortATRQualityOK =
     not v29SkipATRDeadZone or not v29ATRInDeadZone or v210ShortATRRescue

bool v29LongCoreQualityOK =
     not useV29CorePruning or
     (v210LongATRQualityOK and v29EfficiencyQualityOK and v29BodyQualityOK)

bool v29ShortCoreQualityOK =
     not useV29CorePruning or
     (v210ShortATRQualityOK and v29EfficiencyQualityOK and v29BodyQualityOK)

bool v214LongEarlyContinuation = pressureContinuationLong and not longTrigger
bool v214ShortEarlyContinuation = pressureContinuationShort and not shortTrigger

bool v215WednesdayORWindow = dayofweek == dayofweek.wednesday and currentMinuteET >= 660 and currentMinuteET < 720
bool v215LongHistoryOK =
     not (v215BlockWednesdayOR1112 and v215WednesdayORWindow and longSetupType == "OPENING BREAKOUT")
bool v215ShortHistoryOK =
     not (v215BlockFridayShortBreakout and dayofweek == dayofweek.friday and shortSetupType == "BREAKOUT") and
     not (v215BlockWednesdayOR1112 and v215WednesdayORWindow and shortSetupType == "OPENING BREAKOUT")

float v217GapSmallATR = 0.15
float v217GapLargeATR = 0.40
float v217DailyVolLow = 0.85
float v217DailyVolHigh = 1.10
float v217RangeADX = 18.0
float v217TrendEfficiency = 0.27

bool v217LongFlowOpposed = crossStrongShort or fpStrongSell
bool v217LongFlowF1 =
     not v217LongFlowOpposed and
     ((crossStrongLong and not fpStrongBuy) or (fpStrongBuy and not crossStrongLong))

bool v217LongLowVolFlowSetup =
     longSetupType == "BREAKOUT" or
     longSetupType == "OPENING BREAKOUT" or
     longSetupType == "VWAP RECLAIM"

bool v217LongLowVolFlowTrap =
     v217BlockLowVolLongFlow and
     v217LongLowVolFlowSetup and
     v217DailyVolRatio < v217DailyVolLow and
     v217LongFlowF1

bool v217LongFlatGap = math.abs(v217GapATR) < v217GapSmallATR
bool v217ShortFlatGap = v217LongFlatGap

bool v217LongLowVolFlatGapBreakout =
     v217BlockLowVolFlatGapBreakout and
     longSetupType == "BREAKOUT" and
     v217DailyVolRatio < v217DailyVolLow and
     v217LongFlatGap

bool v217ShortLowVolFlatGapBreakout =
     v217BlockLowVolFlatGapBreakout and
     shortSetupType == "BREAKOUT" and
     v217DailyVolRatio < v217DailyVolLow and
     v217ShortFlatGap

bool v217RangeState = adx < v217RangeADX or efficiency < v217TrendEfficiency
bool v217HighDailyVol = v217DailyVolRatio >= v217DailyVolHigh

float v217LongSideGap = v217GapATR
float v217ShortSideGap = -v217GapATR
bool v217LongSmallAdverseGap = v217LongSideGap <= -v217GapSmallATR and v217LongSideGap > -v217GapLargeATR
bool v217ShortSmallAdverseGap = v217ShortSideGap <= -v217GapSmallATR and v217ShortSideGap > -v217GapLargeATR

bool v217LongRangeTrapSetup =
     longSetupType == "BREAKOUT" or
     longSetupType == "OPENING BREAKOUT" or
     longSetupType == "VWAP RECLAIM"
bool v217ShortRangeTrapSetup =
     shortSetupType == "BREAKOUT" or
     shortSetupType == "OPENING BREAKOUT" or
     shortSetupType == "VWAP RECLAIM"

bool v217LongRangeHighVolTrap =
     v217BlockRangeHighVolAdverseGap and
     v217LongRangeTrapSetup and v217RangeState and v217HighDailyVol and v217LongSmallAdverseGap

bool v217ShortRangeHighVolTrap =
     v217BlockRangeHighVolAdverseGap and
     v217ShortRangeTrapSetup and v217RangeState and v217HighDailyVol and v217ShortSmallAdverseGap

bool v217LongAligned = v217DailyBull
bool v217ShortAligned = v217DailyBear

bool v217LongAlignedLowVolAdverseGapBreakout =
     v217BlockAlignedLowVolAdverseGapBreakout and
     longSetupType == "BREAKOUT" and v217LongAligned and
     v217DailyVolRatio < v217DailyVolLow and v217LongSmallAdverseGap

bool v217ShortAlignedLowVolAdverseGapBreakout =
     v217BlockAlignedLowVolAdverseGapBreakout and
     shortSetupType == "BREAKOUT" and v217ShortAligned and
     v217DailyVolRatio < v217DailyVolLow and v217ShortSmallAdverseGap

bool v217LongRouterOK =
     not v217UseRouter or
     not (v217LongLowVolFlowTrap or
          v217LongLowVolFlatGapBreakout or
          v217LongRangeHighVolTrap or
          v217LongAlignedLowVolAdverseGapBreakout)

bool v217ShortRouterOK =
     not v217UseRouter or
     not (v217ShortLowVolFlatGapBreakout or
          v217ShortRangeHighVolTrap or
          v217ShortAlignedLowVolAdverseGapBreakout)

bool v29LongACore =
     (v23PrecisionLongSignal or v24LongScoreSignal or v24LongCloseMomentum) and
     v29LongCoreQualityOK and not v214LongEarlyContinuation and v215LongHistoryOK and v217LongRouterOK

bool v29ShortACore =
     (v23PrecisionShortSignal or v24ShortScoreSignal or v24ShortCloseMomentum) and
     v29ShortCoreQualityOK and not v214ShortEarlyContinuation and v215ShortHistoryOK and v217ShortRouterOK

f_v29a_attribution_id(string setupName, int sideDir) =>
    string id = ""
    if v29AAttributionMode == "SETUP"
        id := setupName
    else if v29AAttributionMode == "TIME"
        id := currentMinuteET < 600 ? "09:30-10:00 ET" :
              currentMinuteET < 660 ? "10:00-11:00 ET" :
              currentMinuteET < 720 ? "11:00-12:00 ET" :
              currentMinuteET < 780 ? "12:00-13:00 ET" :
              currentMinuteET < 840 ? "13:00-14:00 ET" :
              currentMinuteET < 900 ? "14:00-15:00 ET" : "15:00+ ET"
    else if v29AAttributionMode == "DAY"
        id := dayofweek == dayofweek.monday ? "MONDAY" :
              dayofweek == dayofweek.tuesday ? "TUESDAY" :
              dayofweek == dayofweek.wednesday ? "WEDNESDAY" :
              dayofweek == dayofweek.thursday ? "THURSDAY" : "FRIDAY"
    else if v29AAttributionMode == "ATR"
        id := atrRatio < 0.80 ? "ATR <0.80" :
              atrRatio < 1.00 ? "ATR 0.80-1.00" :
              atrRatio < 1.20 ? "ATR 1.00-1.20" : "ATR >=1.20"
    else if v29AAttributionMode == "EFFICIENCY"
        id := efficiency < 0.27 ? "EFF <0.27" :
              efficiency < 0.40 ? "EFF 0.27-0.40" :
              efficiency < 0.55 ? "EFF 0.40-0.55" : "EFF >=0.55"
    else
        int ctx = sideDir == 1 ? longContextCount : shortContextCount
        id := ctx >= 3 ? "CONTEXT 3/3" : "CONTEXT 2/3"
    id

bool oldLongSignal =
     canEnter and
     reentryBlockedDirection != 1 and
     longBaseTrigger and longContextOK and entryQualityLong and
     longSweepAllowed and
     longSpecialQuality and
     lateLongQuality and
     fpLongNotOpposed and
     longLeadOK and
     not bullReversalRisk and
     not openingLongChase and
     not firstHourLongBreakoutClimax

bool oldShortSignal =
     canEnter and
     reentryBlockedDirection != -1 and
     shortBaseTrigger and shortContextOK and entryQualityShort and
     shortSweepAllowed and
     shortSpecialQuality and
     putSideQuality and
     lateShortQuality and
     fpShortNotOpposed and
     shortLeadOK and
     not bearReversalRisk and
     (not blockNewPutsAfter1000 or not after1300ET) and
     not openingShortChase and
     not firstHourShortBreakoutClimax

longSignal =
     useV24Opportunity ?
     (v24DailyRoom and v29LongACore) :
     useV23Precision ? v23PrecisionLongSignal : oldLongSignal

shortSignal =
     useV24Opportunity ?
     (v24DailyRoom and v29ShortACore) :
     useV23Precision ? v23PrecisionShortSignal : oldShortSignal

bool diagRawV29LongA =
     v23PrecisionLongSignal or v24LongScoreSignal or v24LongCloseMomentum
bool diagRawV29ShortA =
     v23PrecisionShortSignal or v24ShortScoreSignal or v24ShortCloseMomentum
bool diagRawV29A = diagRawV29LongA or diagRawV29ShortA

if tradeDirection == 0 and strategy.position_size == 0 and executionReady and diagRawV29A
    diagV29RawA += 1

    bool diagATRQuality =
         (diagRawV29LongA and v210LongATRQualityOK) or
         (diagRawV29ShortA and v210ShortATRQualityOK)
    bool diagRescued =
         (diagRawV29LongA and v210LongATRRescue) or
         (diagRawV29ShortA and v210ShortATRRescue)
    bool diagCoreQuality =
         (diagRawV29LongA and v29LongCoreQualityOK) or
         (diagRawV29ShortA and v29ShortCoreQualityOK)

    if not diagATRQuality
        diagV29ATRBlocked += 1
    if diagRescued
        diagV210ATRRescued += 1
    if not v29EfficiencyQualityOK
        diagV29EffBlocked += 1
    if not v29BodyQualityOK
        diagV29BodyBlocked += 1
    if diagCoreQuality
        diagV29AcceptedA += 1

diagCandidateWindow =
     inTradeSession and dayAllowed and
     not fpRequiredMissing and not inHardStop and not dayDone and
     tradeDirection == 0 and strategy.position_size == 0 and executionReady

if diagCandidateWindow and longBaseTrigger
    diagLongCandidates += 1
    if orBreakLong
        array.set(diagRawLongSetup, 0, array.get(diagRawLongSetup, 0) + 1)
    if breakoutLong
        array.set(diagRawLongSetup, 1, array.get(diagRawLongSetup, 1) + 1)
    if liquiditySweepLong
        array.set(diagRawLongSetup, 2, array.get(diagRawLongSetup, 2) + 1)
    if pullbackLong
        array.set(diagRawLongSetup, 3, array.get(diagRawLongSetup, 3) + 1)
    if vwapReclaimLong
        array.set(diagRawLongSetup, 4, array.get(diagRawLongSetup, 4) + 1)
    if pressureContinuationLong and not longTrigger
        array.set(diagRawLongSetup, 5, array.get(diagRawLongSetup, 5) + 1)
    if not cooldownOK
        array.set(diagLongFilter, 0, array.get(diagLongFilter, 0) + 1)
    if reentryBlockedDirection == 1
        array.set(diagLongFilter, 1, array.get(diagLongFilter, 1) + 1)
    if not longContextOK
        array.set(diagLongFilter, 2, array.get(diagLongFilter, 2) + 1)
    if not movementQualityOK
        array.set(diagLongFilter, 3, array.get(diagLongFilter, 3) + 1)
    if adx < minEntryADX
        array.set(diagLongFilter, 4, array.get(diagLongFilter, 4) + 1)
    if not (efficiencyOK or momentumBypassLong)
        array.set(diagLongFilter, 5, array.get(diagLongFilter, 5) + 1)
    if chopCondition and not momentumBypassLong
        array.set(diagLongFilter, 6, array.get(diagLongFilter, 6) + 1)
    if not crossLongNotOpposed
        array.set(diagLongFilter, 7, array.get(diagLongFilter, 7) + 1)
    if not longSweepAllowed
        array.set(diagLongFilter, 8, array.get(diagLongFilter, 8) + 1)
    if not longSpecialQuality
        array.set(diagLongFilter, 9, array.get(diagLongFilter, 9) + 1)
    if not lateLongQuality
        array.set(diagLongFilter, 10, array.get(diagLongFilter, 10) + 1)
    if not fpLongNotOpposed
        array.set(diagLongFilter, 11, array.get(diagLongFilter, 11) + 1)
    if not longLeadOK
        array.set(diagLongFilter, 12, array.get(diagLongFilter, 12) + 1)
    if bullReversalRisk
        array.set(diagLongFilter, 13, array.get(diagLongFilter, 13) + 1)
    if openingLongChase
        array.set(diagLongFilter, 14, array.get(diagLongFilter, 14) + 1)
    if firstHourLongBreakoutClimax
        array.set(diagLongFilter, 15, array.get(diagLongFilter, 15) + 1)

if diagCandidateWindow and shortBaseTrigger
    diagShortCandidates += 1
    if orBreakShort
        array.set(diagRawShortSetup, 0, array.get(diagRawShortSetup, 0) + 1)
    if breakoutShort
        array.set(diagRawShortSetup, 1, array.get(diagRawShortSetup, 1) + 1)
    if liquiditySweepShort
        array.set(diagRawShortSetup, 2, array.get(diagRawShortSetup, 2) + 1)
    if pullbackShort
        array.set(diagRawShortSetup, 3, array.get(diagRawShortSetup, 3) + 1)
    if vwapReclaimShort
        array.set(diagRawShortSetup, 4, array.get(diagRawShortSetup, 4) + 1)
    if pressureContinuationShort and not shortTrigger
        array.set(diagRawShortSetup, 5, array.get(diagRawShortSetup, 5) + 1)
    if not cooldownOK
        array.set(diagShortFilter, 0, array.get(diagShortFilter, 0) + 1)
    if reentryBlockedDirection == -1
        array.set(diagShortFilter, 1, array.get(diagShortFilter, 1) + 1)
    if not shortContextOK
        array.set(diagShortFilter, 2, array.get(diagShortFilter, 2) + 1)
    if not movementQualityOK
        array.set(diagShortFilter, 3, array.get(diagShortFilter, 3) + 1)
    if adx < minEntryADX
        array.set(diagShortFilter, 4, array.get(diagShortFilter, 4) + 1)
    if not (efficiencyOK or momentumBypassShort)
        array.set(diagShortFilter, 5, array.get(diagShortFilter, 5) + 1)
    if chopCondition and not momentumBypassShort
        array.set(diagShortFilter, 6, array.get(diagShortFilter, 6) + 1)
    if not crossShortNotOpposed
        array.set(diagShortFilter, 7, array.get(diagShortFilter, 7) + 1)
    if not shortSweepAllowed
        array.set(diagShortFilter, 8, array.get(diagShortFilter, 8) + 1)
    if not shortSpecialQuality
        array.set(diagShortFilter, 9, array.get(diagShortFilter, 9) + 1)
    if not lateShortQuality
        array.set(diagShortFilter, 10, array.get(diagShortFilter, 10) + 1)
    if not fpShortNotOpposed
        array.set(diagShortFilter, 11, array.get(diagShortFilter, 11) + 1)
    if not shortLeadOK
        array.set(diagShortFilter, 12, array.get(diagShortFilter, 12) + 1)
    if bearReversalRisk
        array.set(diagShortFilter, 13, array.get(diagShortFilter, 13) + 1)
    if openingShortChase
        array.set(diagShortFilter, 14, array.get(diagShortFilter, 14) + 1)
    if firstHourShortBreakoutClimax
        array.set(diagShortFilter, 15, array.get(diagShortFilter, 15) + 1)
    if not putSideQuality
        array.set(diagShortFilter, 16, array.get(diagShortFilter, 16) + 1)
    if blockNewPutsAfter1000 and after1300ET
        array.set(diagShortFilter, 17, array.get(diagShortFilter, 17) + 1)

r010PutBaseCandidate =
     canEnter and
     reentryBlockedDirection != -1 and
     shortBaseTrigger and shortContextOK and entryQualityShort and
     shortSweepAllowed and
     shortSpecialQuality and
     lateShortQuality and
     (not blockNewPutsAfter1000 or not after1300ET) and
     not openingShortChase

if r010PutBaseCandidate and pullbackShort and disablePutEMAPullback
    putEMABlocks += 1

if r010PutBaseCandidate and breakoutShort and not shortOpeningSetup and
   restrictPutBreakoutBefore0900 and not after1200ET and not exceptionalEarlyPutBreakout
    earlyPutBreakoutBlocks += 1

longWouldPassWithoutChase =
     canEnter and reentryBlockedDirection != 1 and
     longBaseTrigger and longContextOK and entryQualityLong and
     longSweepAllowed and longSpecialQuality and lateLongQuality

shortWouldPassWithoutChase =
     canEnter and reentryBlockedDirection != -1 and
     shortBaseTrigger and shortContextOK and entryQualityShort and
     shortSweepAllowed and shortSpecialQuality and putSideQuality and
     lateShortQuality and (not blockNewPutsAfter1000 or not after1300ET)

if longWouldPassWithoutChase and openingLongChase
    openingChaseBlocks += 1
    openingChaseCallBlocks += 1

if shortWouldPassWithoutChase and openingShortChase
    openingChaseBlocks += 1
    openingChasePutBlocks += 1

r011LongWithoutClimax =
     canEnter and reentryBlockedDirection != 1 and
     longBaseTrigger and longContextOK and entryQualityLong and
     longSweepAllowed and longSpecialQuality and lateLongQuality and
     not openingLongChase

r011ShortWithoutClimax =
     canEnter and reentryBlockedDirection != -1 and
     shortBaseTrigger and shortContextOK and entryQualityShort and
     shortSweepAllowed and shortSpecialQuality and putSideQuality and
     lateShortQuality and
     (not blockNewPutsAfter1000 or not after1300ET) and
     not openingShortChase

if r011LongWithoutClimax and firstHourLongBreakoutClimax
    firstHourClimaxCallBlocks += 1

if r011ShortWithoutClimax and firstHourShortBreakoutClimax
    firstHourClimaxPutBlocks += 1

takeLong = longSignal and (not shortSignal or longContextCount > shortContextCount)
takeShort = shortSignal and (not longSignal or shortContextCount > longContextCount)

if longSignal and shortSignal
    diagSignalConflicts += 1

if takeLong
    diagLongAccepted += 1
if takeShort
    diagShortAccepted += 1

if takeLong
    bool isFast = breakoutLong or orBreakLong or vwapReclaimLong or v24LongCloseMomentum
    bool isSpecialCapture = pullbackLong or vwapReclaimLong
    string chosenSetup = v24LongCloseMomentum ? "CLOSE MOMENTUM" : pressureContinuationLong and not longTrigger ? "EARLY CONTINUATION" : longSetupType
    bool highConvictionRunner =
         useSelectiveRunner and
         (chosenSetup == "BREAKOUT" or chosenSetup == "OPENING BREAKOUT") and
         longContextCount >= 3 and atrRatio >= selectiveRunnerMinATRRatio and
         adx >= selectiveRunnerMinADX and longLeadScore >= selectiveRunnerMinLead and
         (crossStrongLong or fpStrongBuy)
    float chosenTargetATR =
         highConvictionRunner ? selectiveRunnerTargetATR :
         isSpecialCapture ? specialSetupTargetATR :
         strongLongTrend and crossStrongLong ? strongTargetATR :
         baseTargetATR
    float rawStop = close - atr * baseStopATR
    float structuralCandidate = not na(recentLow) ? recentLow - atr * 0.05 : na
    float chosenStop = not na(structuralCandidate) and structuralCandidate > rawStop and structuralCandidate < close ? structuralCandidate : rawStop

    string chosenTier = "A"
    string chosenEntryId = f_v29a_attribution_id(chosenSetup, 1)

    strategy.entry(chosenEntryId, strategy.long, comment = chosenEntryId,
         alert_message = "SOURCE MAIN | LONG QQQ | " + chosenSetup +
              " | ENTRY " + str.tostring(close, format.mintick) +
              " | TARGET " + str.tostring(close + atr * chosenTargetATR, format.mintick) +
              " | SL " + str.tostring(chosenStop, format.mintick) +
              " | TV_TS " + str.tostring(timenow))
    v24EntriesToday += 1

    tradeDirection := 1
    entryTime := time
    entryBar := bar_index
    entryPrice := close
    entryATR := atr
    stopPrice := chosenStop
    hardStopPrice := chosenStop
    targetPrice := close + atr * chosenTargetATR
    originalTarget := targetPrice
    entryLeadScore := longLeadScore
    tradeMFE := 0.0
    tradeMAE := 0.0
    expectedMinutes := isSpecialCapture ? specialSetupExpectedMinutes : isFast ? fastExpectedMinutes : pullbackExpectedMins
    targetExtended := false
    closingRequested := false
    activeSetup := chosenSetup
    activeEntryTier := "A-TIER"
    pendingExitReason := ""
    lastMFEBar := bar_index
    runnerActivated := false
    selectiveRunnerTrade := highConvictionRunner
    diagEntryADX := adx
    diagEntryEfficiency := efficiency
    diagEntryRVOL := rvol
    diagEntryATRRatio := atrRatio
    diagEntryLead := longLeadScore
    diagEntryLeadEdge := longLeadScore - shortLeadScore
    diagEntryExt9ATR := longExt9Now
    diagEntryVWAPDistATR := atr > 0 ? math.abs(close - vwap) / atr : 0.0
    diagEntryBodyATR := signalBodyATRNow
    diagEntryRangeATR := signalRangeATRNow
    diagEntryFPDirectional := fpAvailable ? fpDeltaPct : na
    diagEntryContextCount := longContextCount
    diagEntryCrossClass := crossStrongLong ? 2 : crossMixed ? 0 : 1
    diagEntryFPClass := fpMode == "Off" or not fpAvailable ? 0 : fpStrongBuy ? 3 : fpDeltaPct >= 0 ? 2 : 1
    diagEntryMinuteET := currentMinuteET
    diagEntryDOW := dayofweek
    diagEntryMonth := month
    diagEntryExhaustion := exhaustionCount
    diagEntryChop := chopCondition
    diagEntryStrongTrend := strongLongTrend
    diagLowLossArmed := false
    diagProfitFloorStarted := false
    diagStrongFloorStarted := false
    callEntryEvent := true
    histEntryLine := entryPrice
    histStopLine := stopPrice
    histHardStopLine := hardStopPrice
    histTargetLine := targetPrice

    if showLabels
        label.new(
             bar_index, low,
             "LONG / CALL\n" + activeSetup +
             "\nEntry " + str.tostring(entryPrice, format.mintick) +
             "\nTarget " + str.tostring(targetPrice, format.mintick) +
             "\nSL " + str.tostring(stopPrice, format.mintick) +
             "\nLead " + str.tostring(longLeadScore, "#") +
             "\nOpp " + str.tostring(v24LongOpportunityScore, "#") + " | " + activeEntryTier,
             style = label.style_label_up,
             color = color.lime,
             textcolor = color.black,
             size = size.small
        )

else if takeShort
    bool isFast = breakoutShort or orBreakShort or vwapReclaimShort or v24ShortCloseMomentum
    bool isSpecialCapture = pullbackShort or vwapReclaimShort
    string chosenSetup = v24ShortCloseMomentum ? "CLOSE MOMENTUM" : pressureContinuationShort and not shortTrigger ? "EARLY CONTINUATION" : shortSetupType
    bool highConvictionRunner =
         useSelectiveRunner and
         (chosenSetup == "BREAKOUT" or chosenSetup == "OPENING BREAKOUT") and
         shortContextCount >= 3 and atrRatio >= selectiveRunnerMinATRRatio and
         adx >= selectiveRunnerMinADX and shortLeadScore >= selectiveRunnerMinLead and
         (crossStrongShort or fpStrongSell)
    float chosenTargetATR =
         highConvictionRunner ? selectiveRunnerTargetATR :
         isSpecialCapture ? putSpecialSetupTargetATR :
         strongShortTrend and crossStrongShort ? strongTargetATR :
         baseTargetATR
    float rawStop = close + atr * baseStopATR
    float structuralCandidate = not na(recentHigh) ? recentHigh + atr * 0.05 : na
    float chosenStop = not na(structuralCandidate) and structuralCandidate < rawStop and structuralCandidate > close ? structuralCandidate : rawStop

    string chosenTier = "A"
    string chosenEntryId = f_v29a_attribution_id(chosenSetup, -1)

    strategy.entry(chosenEntryId, strategy.short, comment = chosenEntryId,
         alert_message = "SOURCE MAIN | SHORT QQQ | " + chosenSetup +
              " | ENTRY " + str.tostring(close, format.mintick) +
              " | TARGET " + str.tostring(close - atr * chosenTargetATR, format.mintick) +
              " | SL " + str.tostring(chosenStop, format.mintick) +
              " | TV_TS " + str.tostring(timenow))
    v24EntriesToday += 1

    tradeDirection := -1
    entryTime := time
    entryBar := bar_index
    entryPrice := close
    entryATR := atr
    stopPrice := chosenStop
    hardStopPrice := chosenStop
    targetPrice := close - atr * chosenTargetATR
    originalTarget := targetPrice
    entryLeadScore := shortLeadScore
    tradeMFE := 0.0
    tradeMAE := 0.0
    expectedMinutes := isSpecialCapture ? putSpecialExpectedMinutes : isFast ? fastExpectedMinutes : pullbackExpectedMins
    targetExtended := false
    closingRequested := false
    activeSetup := chosenSetup
    activeEntryTier := "A-TIER"
    pendingExitReason := ""
    lastMFEBar := bar_index
    runnerActivated := false
    selectiveRunnerTrade := highConvictionRunner
    diagEntryADX := adx
    diagEntryEfficiency := efficiency
    diagEntryRVOL := rvol
    diagEntryATRRatio := atrRatio
    diagEntryLead := shortLeadScore
    diagEntryLeadEdge := shortLeadScore - longLeadScore
    diagEntryExt9ATR := shortExt9Now
    diagEntryVWAPDistATR := atr > 0 ? math.abs(close - vwap) / atr : 0.0
    diagEntryBodyATR := signalBodyATRNow
    diagEntryRangeATR := signalRangeATRNow
    diagEntryFPDirectional := fpAvailable ? -fpDeltaPct : na
    diagEntryContextCount := shortContextCount
    diagEntryCrossClass := crossStrongShort ? 2 : crossMixed ? 0 : 1
    diagEntryFPClass := fpMode == "Off" or not fpAvailable ? 0 : fpStrongSell ? 3 : fpDeltaPct <= 0 ? 2 : 1
    diagEntryMinuteET := currentMinuteET
    diagEntryDOW := dayofweek
    diagEntryMonth := month
    diagEntryExhaustion := exhaustionCount
    diagEntryChop := chopCondition
    diagEntryStrongTrend := strongShortTrend
    diagLowLossArmed := false
    diagProfitFloorStarted := false
    diagStrongFloorStarted := false
    putEntryEvent := true
    histEntryLine := entryPrice
    histStopLine := stopPrice
    histHardStopLine := hardStopPrice
    histTargetLine := targetPrice

    if showLabels
        label.new(
             bar_index, high,
             "SHORT / PUT\n" + activeSetup +
             "\nEntry " + str.tostring(entryPrice, format.mintick) +
             "\nTarget " + str.tostring(targetPrice, format.mintick) +
             "\nSL " + str.tostring(stopPrice, format.mintick) +
             "\nLead " + str.tostring(shortLeadScore, "#") +
             "\nOpp " + str.tostring(v24ShortOpportunityScore, "#") + " | " + activeEntryTier,
             style = label.style_label_down,
             color = color.red,
             textcolor = color.white,
             size = size.small
        )

float tradeAgeMinutes = tradeDirection != 0 and not na(entryTime) ? (time - entryTime) / 60000.0 : na
float targetDistance = tradeDirection == 1 ? targetPrice - entryPrice : tradeDirection == -1 ? entryPrice - targetPrice : na
float currentProgress = 0.0

if tradeDirection == 1
    float priorMFE = tradeMFE
    if not na(entryBar) and bar_index > entryBar
        tradeMFE := math.max(tradeMFE, high - entryPrice)
        tradeMAE := math.max(tradeMAE, entryPrice - low)
    else if not na(entryBar) and bar_index == entryBar and executionMode == "Live - Intrabar"
        tradeMFE := math.max(tradeMFE, close - entryPrice)
        tradeMAE := math.max(tradeMAE, entryPrice - close)
    if tradeMFE > priorMFE + syminfo.mintick * 0.5
        lastMFEBar := bar_index
    currentProgress := f_safeDiv(close - entryPrice, targetDistance, 0.0)

if tradeDirection == -1
    float priorMFE = tradeMFE
    if not na(entryBar) and bar_index > entryBar
        tradeMFE := math.max(tradeMFE, entryPrice - low)
        tradeMAE := math.max(tradeMAE, high - entryPrice)
    else if not na(entryBar) and bar_index == entryBar and executionMode == "Live - Intrabar"
        tradeMFE := math.max(tradeMFE, entryPrice - close)
        tradeMAE := math.max(tradeMAE, close - entryPrice)
    if tradeMFE > priorMFE + syminfo.mintick * 0.5
        lastMFEBar := bar_index
    currentProgress := f_safeDiv(entryPrice - close, targetDistance, 0.0)

continuationLong =
     tradeDirection == 1 and
     strongLongTrend and
     crossLongNotOpposed and
     efficiency >= minEntryEfficiency and
     close > ema9 and close > vwap

continuationShort =
     tradeDirection == -1 and
     strongShortTrend and
     crossShortNotOpposed and
     efficiency >= minEntryEfficiency and
     close < ema9 and close < vwap

float mfeATR = tradeDirection != 0 and entryATR > 0 ? tradeMFE / entryATR : 0.0

runnerQualifiesLong =
     tradeDirection == 1 and
     mfeATR >= runnerActivationATR and
     adx >= runnerMinADX and
     efficiency >= runnerMinEfficiency and
     strongLongTrend and
     crossStrongLong and
     ema9 > ema21 and close > ema21 and close > vwap and
     plusDI > minusDI

runnerQualifiesShort =
     tradeDirection == -1 and
     mfeATR >= runnerActivationATR and
     adx >= runnerMinADX and
     efficiency >= runnerMinEfficiency and
     strongShortTrend and
     crossStrongShort and
     ema9 < ema21 and close < ema21 and close < vwap and
     minusDI > plusDI

if not runnerActivated and (runnerQualifiesLong or runnerQualifiesShort)
    runnerActivated := true

runnerLong = runnerActivated and tradeDirection == 1
runnerShort = runnerActivated and tradeDirection == -1

if allowTargetExtension and tradeDirection == 1 and not targetExtended and currentProgress >= 0.85 and runnerLong
    targetPrice += entryATR * targetExtensionATR
    targetExtended := true
    histTargetLine := targetPrice

if allowTargetExtension and tradeDirection == -1 and not targetExtended and currentProgress >= 0.85 and runnerShort
    targetPrice -= entryATR * targetExtensionATR
    targetExtended := true
    histTargetLine := targetPrice

bool lowLossThreatLong =
     useLowLossStop and tradeDirection == 1 and mfeATR < lowLossMaxMFEATR and
     close < entryPrice and close < ema9 and minusDI > plusDI and
     (close < vwap or bearDisplacement or fpStrongSell)

bool lowLossThreatShort =
     useLowLossStop and tradeDirection == -1 and mfeATR < lowLossMaxMFEATR and
     close > entryPrice and close > ema9 and plusDI > minusDI and
     (close > vwap or bullDisplacement or fpStrongBuy)

if lowLossThreatLong and not closingRequested
    diagLowLossArmed := true
    stopPrice := math.max(stopPrice, entryPrice - entryATR * lowLossStopATR)
    histStopLine := stopPrice

if lowLossThreatShort and not closingRequested
    diagLowLossArmed := true
    stopPrice := math.min(stopPrice, entryPrice + entryATR * lowLossStopATR)
    histStopLine := stopPrice

if tradeDirection != 0 and mfeATR >= hardFloorStartMFEATR
    diagProfitFloorStarted := true
if tradeDirection != 0 and mfeATR >= hardFloorStrongMFEATR
    diagStrongFloorStarted := true

if tradeDirection == 1 and not closingRequested and not useProofTrail
    float protectedStop = stopPrice

    if mfeATR >= hardFloorStrongMFEATR
        protectedStop := math.max(protectedStop, entryPrice + entryATR * hardFloorStrongLockATR)
    else if mfeATR >= hardFloorStartMFEATR
        protectedStop := math.max(protectedStop, entryPrice + entryATR * hardFloorStartLockATR)

    if runnerLong
        float runnerStructure = math.max(ema21 - atr * runnerStructureBufferATR, ta.lowest(low, 2) - atr * runnerStructureBufferATR)
        protectedStop := math.max(protectedStop, runnerStructure)
    else
        if mfeATR >= profitLockRunnerATR
            protectedStop := math.max(protectedStop, entryPrice + tradeMFE * lockFraction3)
        else if mfeATR >= profitLockStrongATR
            protectedStop := math.max(protectedStop, entryPrice + tradeMFE * lockFraction2)
        else if mfeATR >= profitProtectTriggerATR
            protectedStop := math.max(protectedStop, entryPrice + tradeMFE * lockFraction1)
    protectedStop := math.min(protectedStop, close - syminfo.mintick)
    stopPrice := math.max(stopPrice, protectedStop)
    histStopLine := stopPrice

if tradeDirection == -1 and not closingRequested and not useProofTrail
    float protectedStop = stopPrice

    if mfeATR >= hardFloorStrongMFEATR
        protectedStop := math.min(protectedStop, entryPrice - entryATR * hardFloorStrongLockATR)
    else if mfeATR >= hardFloorStartMFEATR
        protectedStop := math.min(protectedStop, entryPrice - entryATR * hardFloorStartLockATR)

    if runnerShort
        float runnerStructure = math.min(ema21 + atr * runnerStructureBufferATR, ta.highest(high, 2) + atr * runnerStructureBufferATR)
        protectedStop := math.min(protectedStop, runnerStructure)
    else
        if mfeATR >= profitLockRunnerATR
            protectedStop := math.min(protectedStop, entryPrice - tradeMFE * lockFraction3)
        else if mfeATR >= profitLockStrongATR
            protectedStop := math.min(protectedStop, entryPrice - tradeMFE * lockFraction2)
        else if mfeATR >= profitProtectTriggerATR
            protectedStop := math.min(protectedStop, entryPrice - tradeMFE * lockFraction1)
    protectedStop := math.max(protectedStop, close + syminfo.mintick)
    stopPrice := math.min(stopPrice, protectedStop)
    histStopLine := stopPrice

float activeProofTrailOffsetATR = selectiveRunnerTrade ? selectiveRunnerTrailOffsetATR : proofTrailOffsetATR
float activeProofTrailActivateATR = selectiveRunnerTrade ? selectiveRunnerTrailActivateATR : proofTrailActivateATR
int proofTrailTicks = tradeDirection != 0 and not na(entryATR) ?
     int(math.max(1.0, math.round(entryATR * activeProofTrailOffsetATR / syminfo.mintick))) : 1
float proofTrailActivation =
     tradeDirection == 1 ? entryPrice + entryATR * activeProofTrailActivateATR :
     tradeDirection == -1 ? entryPrice - entryATR * activeProofTrailActivateATR : na

if tradeDirection == 1 and not closingRequested
    if useProofTrail
        strategy.exit("CALL BRACKET", stop = stopPrice, limit = targetPrice,
             trail_price = proofTrailActivation, trail_offset = proofTrailTicks,
             alert_message = "SOURCE MAIN | EXIT QQQ | BRACKET | TV_TS " + str.tostring(timenow),
             alert_profit = "SOURCE MAIN | EXIT QQQ | TARGET | TV_TS " + str.tostring(timenow),
             alert_loss = "SOURCE MAIN | EXIT QQQ | STOP | TV_TS " + str.tostring(timenow),
             alert_trailing = "SOURCE MAIN | EXIT QQQ | TRAIL | TV_TS " + str.tostring(timenow))
    else
        strategy.exit("CALL BRACKET", stop = stopPrice, limit = targetPrice,
             alert_message = "SOURCE MAIN | EXIT QQQ | BRACKET | TV_TS " + str.tostring(timenow),
             alert_profit = "SOURCE MAIN | EXIT QQQ | TARGET | TV_TS " + str.tostring(timenow),
             alert_loss = "SOURCE MAIN | EXIT QQQ | STOP | TV_TS " + str.tostring(timenow))

if tradeDirection == -1 and not closingRequested
    if useProofTrail
        strategy.exit("PUT BRACKET", stop = stopPrice, limit = targetPrice,
             trail_price = proofTrailActivation, trail_offset = proofTrailTicks,
             alert_message = "SOURCE MAIN | EXIT QQQ | BRACKET | TV_TS " + str.tostring(timenow),
             alert_profit = "SOURCE MAIN | EXIT QQQ | TARGET | TV_TS " + str.tostring(timenow),
             alert_loss = "SOURCE MAIN | EXIT QQQ | STOP | TV_TS " + str.tostring(timenow),
             alert_trailing = "SOURCE MAIN | EXIT QQQ | TRAIL | TV_TS " + str.tostring(timenow))
    else
        strategy.exit("PUT BRACKET", stop = stopPrice, limit = targetPrice,
             alert_message = "SOURCE MAIN | EXIT QQQ | BRACKET | TV_TS " + str.tostring(timenow),
             alert_profit = "SOURCE MAIN | EXIT QQQ | TARGET | TV_TS " + str.tostring(timenow),
             alert_loss = "SOURCE MAIN | EXIT QQQ | STOP | TV_TS " + str.tostring(timenow))

if tradeDirection == 1 and pendingExitReason == ""
    if low <= stopPrice and high >= targetPrice
        pendingExitReason := "STOP / TARGET SAME BAR"
    else if low <= stopPrice
        pendingExitReason := "STOP"
    else if high >= targetPrice
        pendingExitReason := "TARGET"

if tradeDirection == -1 and pendingExitReason == ""
    if high >= stopPrice and low <= targetPrice
        pendingExitReason := "STOP / TARGET SAME BAR"
    else if high >= stopPrice
        pendingExitReason := "STOP"
    else if low <= targetPrice
        pendingExitReason := "TARGET"

barsSinceMFE = tradeDirection != 0 and not na(lastMFEBar) ? bar_index - lastMFEBar : 0

float currentDirectionalProfit =
     tradeDirection == 1 ? close - entryPrice :
     tradeDirection == -1 ? entryPrice - close : 0.0
float peakGivebackPct = tradeMFE > syminfo.mintick ? math.max(0.0, (tradeMFE - currentDirectionalProfit) / tradeMFE) : 0.0
float allowedGivebackPct =
     mfeATR >= peakGivebackRunnerATR ? maxGivebackRunnerPct :
     mfeATR >= peakGivebackMidATR ? maxGivebackMidPct :
     maxGivebackEarlyPct

bool oppositeThreatLong =
     tradeDirection == 1 and
     shortLeadScore >= exitThreatScore and
     shortLeadScore >= longLeadScore + exitThreatEdge

bool oppositeThreatShort =
     tradeDirection == -1 and
     longLeadScore >= exitThreatScore and
     longLeadScore >= shortLeadScore + exitThreatEdge

bool reversalBankLong =
     tradeDirection == 1 and
     currentDirectionalProfit > 0 and
     mfeATR >= reversalBankMinMFEATR and
     oppositeThreatLong and
     (bearishRejection or bearDisplacement or fpStrongSell or close < ema9)

bool reversalBankShort =
     tradeDirection == -1 and
     currentDirectionalProfit > 0 and
     mfeATR >= reversalBankMinMFEATR and
     oppositeThreatShort and
     (bullishRejection or bullDisplacement or fpStrongBuy or close > ema9)

float structureHealth =
     tradeDirection == 1 ? ((ema9 >= ema21 or close >= vwap) ? 20.0 : 0.0) :
     tradeDirection == -1 ? ((ema9 <= ema21 or close <= vwap) ? 20.0 : 0.0) : 0.0

float levelHealth =
     tradeDirection == 1 ? (close >= entryPrice ? 20.0 : close >= stopPrice ? 10.0 : 0.0) :
     tradeDirection == -1 ? (close <= entryPrice ? 20.0 : close <= stopPrice ? 10.0 : 0.0) : 0.0

float flowHealth =
     tradeDirection == 1 ? (fpStrongSell ? 0.0 : minusDI > plusDI ? 8.0 : fpStrongBuy ? 20.0 : 15.0) :
     tradeDirection == -1 ? (fpStrongBuy ? 0.0 : plusDI > minusDI ? 8.0 : fpStrongSell ? 20.0 : 15.0) : 0.0

float momentumHealth =
     tradeDirection == 1 ? (bearDisplacement ? 0.0 : close < ema9 ? 8.0 : efficiency >= minEntryEfficiency ? 20.0 : 12.0) :
     tradeDirection == -1 ? (bullDisplacement ? 0.0 : close > ema9 ? 8.0 : efficiency >= minEntryEfficiency ? 20.0 : 12.0) : 0.0

float progressHealth =
     tradeDirection == 0 ? 0.0 :
     currentDirectionalProfit > 0 ? 20.0 :
     not na(tradeAgeMinutes) and tradeAgeMinutes >= staleCheckMinutes and tradeMFE < entryATR * staleProgressATR ? 4.0 : 12.0

float tradeHealth = math.max(0.0, math.min(100.0, structureHealth + levelHealth + flowHealth + momentumHealth + progressHealth))

bool healthBankLong =
     useTradeHealthExit and tradeDirection == 1 and
     currentDirectionalProfit > 0 and mfeATR >= reversalBankMinMFEATR and
     tradeHealth <= healthExitLevel and
     (oppositeThreatLong or bearDisplacement or fpStrongSell)

bool healthBankShort =
     useTradeHealthExit and tradeDirection == -1 and
     currentDirectionalProfit > 0 and mfeATR >= reversalBankMinMFEATR and
     tradeHealth <= healthExitLevel and
     (oppositeThreatShort or bullDisplacement or fpStrongBuy)

fastImpulseLong =
     tradeDirection == 1 and
     not na(tradeAgeMinutes) and tradeAgeMinutes <= impulseWindowMinutes and
     mfeATR >= impulseActivationATR

fastImpulseShort =
     tradeDirection == -1 and
     not na(tradeAgeMinutes) and tradeAgeMinutes <= impulseWindowMinutes and
     mfeATR >= impulseActivationATR

impulseBankLong =
     fastImpulseLong and
     currentDirectionalProfit > 0 and
     peakGivebackPct >= impulseGivebackPct and
     close < open and close < ema9

impulseBankShort =
     fastImpulseShort and
     currentDirectionalProfit > 0 and
     peakGivebackPct >= impulseGivebackPct and
     close > open and close > ema9

runnerExhaustLong =
     runnerLong and
     currentDirectionalProfit > 0 and
     barsSinceMFE >= 1 and
     peakGivebackPct >= runnerMaxGivebackPct and
     close < ema9 and
     (efficiency < runnerMinEfficiency or minusDI >= plusDI)

runnerExhaustShort =
     runnerShort and
     currentDirectionalProfit > 0 and
     barsSinceMFE >= 1 and
     peakGivebackPct >= runnerMaxGivebackPct and
     close > ema9 and
     (efficiency < runnerMinEfficiency or plusDI >= minusDI)

peakGivebackExit =
     tradeDirection != 0 and
     not runnerActivated and
     mfeATR >= peakGivebackStartATR and
     currentDirectionalProfit > 0 and
     peakGivebackPct >= allowedGivebackPct and
     not ((continuationLong or continuationShort) and peakGivebackPct < allowedGivebackPct + 0.10)

profitStallLong =
     tradeDirection == 1 and
     not runnerLong and
     mfeATR >= stallExitMinMFEATR and
     barsSinceMFE >= stallBarsAfterProfit and
     currentDirectionalProfit > 0 and
     not continuationLong and
     (close < ema9 or efficiency < minEntryEfficiency or peakGivebackPct >= 0.30)

profitStallShort =
     tradeDirection == -1 and
     not runnerShort and
     mfeATR >= stallExitMinMFEATR and
     barsSinceMFE >= stallBarsAfterProfit and
     currentDirectionalProfit > 0 and
     not continuationShort and
     (close > ema9 or efficiency < minEntryEfficiency or peakGivebackPct >= 0.30)

int failureVotesLong =
     (close < ema9 ? 1 : 0) +
     (close < vwap ? 1 : 0) +
     (close < ema21 ? 1 : 0) +
     (minusDI > plusDI ? 1 : 0) +
     (fpStrongSell ? 1 : 0) +
     (crossStrongShort ? 1 : 0) +
     ((bearDisplacement or bearishRejection or shortLeadScore >= longLeadScore + failureCutLeadEdge) ? 1 : 0)

int failureVotesShort =
     (close > ema9 ? 1 : 0) +
     (close > vwap ? 1 : 0) +
     (close > ema21 ? 1 : 0) +
     (plusDI > minusDI ? 1 : 0) +
     (fpStrongBuy ? 1 : 0) +
     (crossStrongLong ? 1 : 0) +
     ((bullDisplacement or bullishRejection or longLeadScore >= shortLeadScore + failureCutLeadEdge) ? 1 : 0)

float currentAdverseATR =
     tradeDirection == 1 ? math.max(0.0, entryPrice - close) / math.max(entryATR, syminfo.mintick) :
     tradeDirection == -1 ? math.max(0.0, close - entryPrice) / math.max(entryATR, syminfo.mintick) : 0.0

bool selectiveFailureCutLong =
     useFailureCut and tradeDirection == 1 and
     not na(tradeAgeMinutes) and
     tradeAgeMinutes >= failureCutGraceMinutes and tradeAgeMinutes <= failureCutMaxMinutes and
     currentDirectionalProfit < 0 and
     currentAdverseATR >= failureCutMinAdverseATR and
     mfeATR <= failureCutMaxMFEATR and
     close < ema9 and minusDI > plusDI and
     failureVotesLong >= failureCutMinVotes

bool selectiveFailureCutShort =
     useFailureCut and tradeDirection == -1 and
     not na(tradeAgeMinutes) and
     tradeAgeMinutes >= failureCutGraceMinutes and tradeAgeMinutes <= failureCutMaxMinutes and
     currentDirectionalProfit < 0 and
     currentAdverseATR >= failureCutMinAdverseATR and
     mfeATR <= failureCutMaxMFEATR and
     close > ema9 and plusDI > minusDI and
     failureVotesShort >= failureCutMinVotes

fastFailureLong =
     tradeDirection == 1 and
     not na(tradeAgeMinutes) and
     tradeAgeMinutes <= fastFailureMinutes and
     tradeMAE >= entryATR * fastFailureMAEATR and
     tradeMFE < entryATR * profitProtectTriggerATR and
     close < ema21 and close < vwap

fastFailureShort =
     tradeDirection == -1 and
     not na(tradeAgeMinutes) and
     tradeAgeMinutes <= fastFailureMinutes and
     tradeMAE >= entryATR * fastFailureMAEATR and
     tradeMFE < entryATR * profitProtectTriggerATR and
     close > ema21 and close > vwap

staleTrade =
     tradeDirection != 0 and
     not runnerActivated and
     not na(tradeAgeMinutes) and
     tradeAgeMinutes >= staleCheckMinutes and
     tradeMFE < entryATR * staleProgressATR and
     (chopCondition or efficiency < chopEfficiency)

expectedWindowFailed =
     tradeDirection != 0 and
     not na(tradeAgeMinutes) and
     tradeAgeMinutes >= expectedMinutes and
     currentProgress < 0.45 and
     not (continuationLong or continuationShort)

longThesisBroken =
     tradeDirection == 1 and
     close < vwap and ema9 < ema21 and minusDI > plusDI

shortThesisBroken =
     tradeDirection == -1 and
     close > vwap and ema9 > ema21 and plusDI > minusDI

absoluteTimeExit =
     tradeDirection != 0 and
     not na(tradeAgeMinutes) and
     tradeAgeMinutes >= maxTradeMinutes

adaptiveSessionExit =
     tradeDirection != 0 and
     inStopEval and
     sessionExhaustedPersistent and
     tradeAgeMinutes >= staleCheckMinutes

hardTimeExit = tradeDirection != 0 and inHardStop

customExit =
     tradeDirection != 0 and
     not closingRequested and
     (reversalBankLong or reversalBankShort or
      healthBankLong or healthBankShort or
      impulseBankLong or impulseBankShort or
      runnerExhaustLong or runnerExhaustShort or
      peakGivebackExit or
      profitStallLong or profitStallShort or
      selectiveFailureCutLong or selectiveFailureCutShort or
      fastFailureLong or fastFailureShort or
      staleTrade or expectedWindowFailed or
      longThesisBroken or shortThesisBroken or
      absoluteTimeExit or adaptiveSessionExit or hardTimeExit)

if customExit
    if selectiveFailureCutLong or selectiveFailureCutShort
        diagSelectiveFailureCuts += 1
    pendingExitReason :=
         hardTimeExit ? "HARD SESSION STOP" :
         adaptiveSessionExit ? "SESSION EDGE GONE" :
         (reversalBankLong or reversalBankShort) ? "REVERSAL DEVELOPING / BANK PROFIT" :
         (healthBankLong or healthBankShort) ? "TRADE HEALTH WEAK / BANK PROFIT" :
         (impulseBankLong or impulseBankShort) ? "FAST IMPULSE / BANK MOVE" :
         (runnerExhaustLong or runnerExhaustShort) ? "RUNNER EXHAUSTED" :
         peakGivebackExit ? "PEAK GIVEBACK / BANK MOVE" :
         (profitStallLong or profitStallShort) ? "MOVE STALLED / TAKE PROFIT" :
         (selectiveFailureCutLong or selectiveFailureCutShort) ? "SELECTIVE FAILURE CUT" :
         (fastFailureLong or fastFailureShort) ? "FAST FAILURE" :
         staleTrade ? "NO MOVE / CHOP" :
         expectedWindowFailed ? "MOVE TOO SLOW" :
         absoluteTimeExit ? "MAX TIME" :
         "DIRECTION FLIPPED"

    strategy.close_all(alert_message = "SOURCE MAIN | EXIT QQQ | " + pendingExitReason + " | TV_TS " + str.tostring(timenow), immediately = true)

    closingRequested := true

if newClosedTrade and tradeDirection != 0
    researchTrades += 1
    bool dirHit = tradeMFE >= entryATR * directionHitATR
    researchDirHits += dirHit ? 1 : 0
    totalDurationMinutes += nz(tradeAgeMinutes, 0)

    int closedIdx = strategy.closedtrades - 1
    float realizedExit = strategy.closedtrades.exit_price(closedIdx)
    float realizedDirectionalMove = tradeDirection == 1 ? realizedExit - entryPrice : entryPrice - realizedExit
    bool realizedWinner = realizedDirectionalMove > 0
    float cashProfit = strategy.closedtrades.profit(closedIdx)
    float cashWin = math.max(cashProfit, 0.0)
    float cashLoss = math.max(-cashProfit, 0.0)

    if tradeDirection == 1
        diagCallTrades += 1
        diagCallWins += realizedWinner ? 1 : 0
        diagCallGP += cashWin
        diagCallGL += cashLoss
    else
        diagPutTrades += 1
        diagPutWins += realizedWinner ? 1 : 0
        diagPutGP += cashWin
        diagPutGL += cashLoss

    int tierIdx = 0
    f_diagAdd(diagTierT, diagTierW, diagTierGP, diagTierGL, tierIdx, realizedWinner, cashWin, cashLoss)

    if activeSetup == "OPENING BREAKOUT"
        diagORTrades += 1
        diagORWins += realizedWinner ? 1 : 0
        diagORGP += cashWin
        diagORGL += cashLoss
    else if activeSetup == "BREAKOUT"
        diagBOTrades += 1
        diagBOWins += realizedWinner ? 1 : 0
        diagBOGP += cashWin
        diagBOGL += cashLoss
    else if activeSetup == "LIQUIDITY REVERSAL"
        diagLiqTrades += 1
        diagLiqWins += realizedWinner ? 1 : 0
        diagLiqGP += cashWin
        diagLiqGL += cashLoss
    else if activeSetup == "EMA PULLBACK"
        diagEMATrades += 1
        diagEMAWins += realizedWinner ? 1 : 0
        diagEMAGP += cashWin
        diagEMAGL += cashLoss
    else if activeSetup == "VWAP RECLAIM"
        diagVWAPTrades += 1
        diagVWAPWins += realizedWinner ? 1 : 0
        diagVWAPGP += cashWin
        diagVWAPGL += cashLoss
    else if activeSetup == "EARLY CONTINUATION"
        diagEarlyTrades += 1
        diagEarlyWins += realizedWinner ? 1 : 0
        diagEarlyGP += cashWin
        diagEarlyGL += cashLoss

    float capturePct = tradeMFE > syminfo.mintick ? math.max(0.0, math.min(100.0, realizedDirectionalMove / tradeMFE * 100.0)) : 0.0
    float givebackPct = tradeMFE > syminfo.mintick ? math.max(0.0, math.min(100.0, (tradeMFE - realizedDirectionalMove) / tradeMFE * 100.0)) : 0.0
    totalCapturePct += capturePct
    if realizedWinner
        researchWinners += 1
        winnerCapturePctTotal += capturePct
        if tradeDirection == 1
            diagCallWinnerCaptureTotal += capturePct
        else
            diagPutWinnerCaptureTotal += capturePct
    if dirHit
        dirHitWins += realizedWinner ? 1 : 0
        dirHitLosses += realizedWinner ? 0 : 1
        dirHitGivebackPctTotal += givebackPct

    float mfeATRClosed = entryATR > 0 ? tradeMFE / entryATR : 0.0
    float maeATRClosed = entryATR > 0 ? tradeMAE / entryATR : 0.0
    float realizedRClosed = entryATR > 0 ? realizedDirectionalMove / entryATR : 0.0
    float durationClosed = nz(tradeAgeMinutes, 0.0)

    diagTotalMFEATR += mfeATRClosed
    diagTotalMAEATR += maeATRClosed
    diagTotalRealizedR += realizedRClosed
    if realizedWinner
        diagWinnerMFEATR += mfeATRClosed
        diagWinnerMAEATR += maeATRClosed
        diagWinnerRealizedR += realizedRClosed
        diagWinnerDuration += durationClosed
        diagWinnerCaptureUnder25 += capturePct < 25 ? 1 : 0
        diagWinnerCaptureUnder50 += capturePct < 50 ? 1 : 0
        diagWinnerCaptureOver75 += capturePct >= 75 ? 1 : 0
    else
        diagLosers += 1
        diagLoserMFEATR += mfeATRClosed
        diagLoserMAEATR += maeATRClosed
        diagLoserRealizedR += realizedRClosed
        diagLoserDuration += durationClosed
        diagLossAfterMFE15 += mfeATRClosed >= 0.15 ? 1 : 0
        diagLossAfterMFE30 += mfeATRClosed >= 0.30 ? 1 : 0
        diagLossAfterMFE50 += mfeATRClosed >= 0.50 ? 1 : 0
        if tradeDirection == 1
            diagCallLossAfterMFE30 += mfeATRClosed >= 0.30 ? 1 : 0
            diagCallLossAfterMFE50 += mfeATRClosed >= 0.50 ? 1 : 0
        else
            diagPutLossAfterMFE30 += mfeATRClosed >= 0.30 ? 1 : 0
            diagPutLossAfterMFE50 += mfeATRClosed >= 0.50 ? 1 : 0
        diagLossAfterMFE75 += mfeATRClosed >= 0.75 ? 1 : 0
        diagLossAfterMFE100 += mfeATRClosed >= 1.00 ? 1 : 0

    int setupIdx = f_setupIndex(activeSetup)
    if setupIdx >= 0
        int setupSideIdx = setupIdx + (tradeDirection == -1 ? 6 : 0)
        f_diagAdd(diagSetupSideT, diagSetupSideW, diagSetupSideGP, diagSetupSideGL, setupSideIdx, realizedWinner, cashWin, cashLoss)

    int dayIdx =
         diagEntryDOW == dayofweek.monday ? 0 :
         diagEntryDOW == dayofweek.tuesday ? 1 :
         diagEntryDOW == dayofweek.wednesday ? 2 :
         diagEntryDOW == dayofweek.thursday ? 3 :
         diagEntryDOW == dayofweek.friday ? 4 : -1
    f_diagAdd(diagDayT, diagDayW, diagDayGP, diagDayGL, dayIdx, realizedWinner, cashWin, cashLoss)

    int timeIdx =
         na(diagEntryMinuteET) ? -1 :
         diagEntryMinuteET < 600 ? 0 :
         diagEntryMinuteET < 660 ? 1 :
         diagEntryMinuteET < 720 ? 2 :
         diagEntryMinuteET < 780 ? 3 :
         diagEntryMinuteET < 840 ? 4 :
         diagEntryMinuteET < 900 ? 5 : 6
    f_diagAdd(diagTimeT, diagTimeW, diagTimeGP, diagTimeGL, timeIdx, realizedWinner, cashWin, cashLoss)
    int sideTimeIdx = timeIdx >= 0 ? timeIdx + (tradeDirection == -1 ? 7 : 0) : -1
    f_diagAdd(diagSideTimeT, diagSideTimeW, diagSideTimeGP, diagSideTimeGL, sideTimeIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagMonthT, diagMonthW, diagMonthGP, diagMonthGL, na(diagEntryMonth) ? -1 : diagEntryMonth - 1, realizedWinner, cashWin, cashLoss)

    int adxIdx = na(diagEntryADX) ? -1 : diagEntryADX < 18 ? 0 : diagEntryADX < 23 ? 1 : diagEntryADX < 30 ? 2 : 3
    int effIdx = na(diagEntryEfficiency) ? -1 : diagEntryEfficiency < 0.27 ? 0 : diagEntryEfficiency < 0.40 ? 1 : diagEntryEfficiency < 0.55 ? 2 : 3
    int rvolIdx = na(diagEntryRVOL) ? -1 : diagEntryRVOL < 0.80 ? 0 : diagEntryRVOL < 1.00 ? 1 : diagEntryRVOL < 1.30 ? 2 : 3
    int atrIdx = na(diagEntryATRRatio) ? -1 : diagEntryATRRatio < 0.80 ? 0 : diagEntryATRRatio < 1.00 ? 1 : diagEntryATRRatio < 1.20 ? 2 : 3
    int leadIdx = na(diagEntryLead) ? -1 : diagEntryLead < 60 ? 0 : diagEntryLead < 70 ? 1 : diagEntryLead < 80 ? 2 : 3
    int leadEdgeIdx = na(diagEntryLeadEdge) ? -1 : diagEntryLeadEdge < 8 ? 0 : diagEntryLeadEdge < 15 ? 1 : diagEntryLeadEdge < 25 ? 2 : 3
    int contextIdx = na(diagEntryContextCount) ? -1 : diagEntryContextCount >= 3 ? 1 : 0
    int extIdx = na(diagEntryExt9ATR) ? -1 : diagEntryExt9ATR < 0.25 ? 0 : diagEntryExt9ATR < 0.50 ? 1 : diagEntryExt9ATR < 0.80 ? 2 : 3
    int vwapDistIdx = na(diagEntryVWAPDistATR) ? -1 : diagEntryVWAPDistATR < 0.15 ? 0 : diagEntryVWAPDistATR < 0.30 ? 1 : diagEntryVWAPDistATR < 0.60 ? 2 : 3
    int bodyIdx = na(diagEntryBodyATR) ? -1 : diagEntryBodyATR < 0.25 ? 0 : diagEntryBodyATR < 0.40 ? 1 : diagEntryBodyATR < 0.65 ? 2 : 3
    int rangeIdx = na(diagEntryRangeATR) ? -1 : diagEntryRangeATR < 0.50 ? 0 : diagEntryRangeATR < 0.80 ? 1 : diagEntryRangeATR < 1.20 ? 2 : 3
    int stateIdx = diagEntryChop ? 0 : diagEntryStrongTrend ? 2 : 1
    int exhaustIdx = na(diagEntryExhaustion) ? -1 : diagEntryExhaustion <= 1 ? 0 : diagEntryExhaustion <= 3 ? 1 : 2

    f_diagAdd(diagADXT, diagADXW, diagADXGP, diagADXGL, adxIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagEffT, diagEffW, diagEffGP, diagEffGL, effIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagRVOLT, diagRVOLW, diagRVOLGP, diagRVOLGL, rvolIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagATRT, diagATRW, diagATRGP, diagATRGL, atrIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagLeadT, diagLeadW, diagLeadGP, diagLeadGL, leadIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagLeadEdgeT, diagLeadEdgeW, diagLeadEdgeGP, diagLeadEdgeGL, leadEdgeIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagCrossT, diagCrossW, diagCrossGP, diagCrossGL, nz(diagEntryCrossClass, -1), realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagFPT, diagFPW, diagFPGP, diagFPGL, nz(diagEntryFPClass, -1), realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagContextT, diagContextW, diagContextGP, diagContextGL, contextIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagExtT, diagExtW, diagExtGP, diagExtGL, extIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagVWAPDistT, diagVWAPDistW, diagVWAPDistGP, diagVWAPDistGL, vwapDistIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagBodyT, diagBodyW, diagBodyGP, diagBodyGL, bodyIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagRangeT, diagRangeW, diagRangeGP, diagRangeGL, rangeIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagStateT, diagStateW, diagStateGP, diagStateGL, stateIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagExhaustT, diagExhaustW, diagExhaustGP, diagExhaustGL, exhaustIdx, realizedWinner, cashWin, cashLoss)

    if mfeATRClosed >= 0.15
        f_diagAdd(diagMFET, diagMFEW, diagMFEGP, diagMFEGL, 0, realizedWinner, cashWin, cashLoss)
    if mfeATRClosed >= 0.30
        f_diagAdd(diagMFET, diagMFEW, diagMFEGP, diagMFEGL, 1, realizedWinner, cashWin, cashLoss)
    if mfeATRClosed >= 0.50
        f_diagAdd(diagMFET, diagMFEW, diagMFEGP, diagMFEGL, 2, realizedWinner, cashWin, cashLoss)
    if mfeATRClosed >= 0.75
        f_diagAdd(diagMFET, diagMFEW, diagMFEGP, diagMFEGL, 3, realizedWinner, cashWin, cashLoss)
    if mfeATRClosed >= 1.00
        f_diagAdd(diagMFET, diagMFEW, diagMFEGP, diagMFEGL, 4, realizedWinner, cashWin, cashLoss)

    int sideMFEBase = tradeDirection == -1 ? 5 : 0
    if mfeATRClosed >= 0.15
        f_diagAdd(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, sideMFEBase + 0, realizedWinner, cashWin, cashLoss)
    if mfeATRClosed >= 0.30
        f_diagAdd(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, sideMFEBase + 1, realizedWinner, cashWin, cashLoss)
    if mfeATRClosed >= 0.50
        f_diagAdd(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, sideMFEBase + 2, realizedWinner, cashWin, cashLoss)
    if mfeATRClosed >= 0.75
        f_diagAdd(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, sideMFEBase + 3, realizedWinner, cashWin, cashLoss)
    if mfeATRClosed >= 1.00
        f_diagAdd(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, sideMFEBase + 4, realizedWinner, cashWin, cashLoss)

    int maeIdx = maeATRClosed < 0.15 ? 0 : maeATRClosed < 0.30 ? 1 : maeATRClosed < 0.50 ? 2 : 3
    int durationIdx = durationClosed < 5 ? 0 : durationClosed < 10 ? 1 : durationClosed < 20 ? 2 : 3
    f_diagAdd(diagMAET, diagMAEW, diagMAEGP, diagMAEGL, maeIdx, realizedWinner, cashWin, cashLoss)
    f_diagAdd(diagDurationT, diagDurationW, diagDurationGP, diagDurationGL, durationIdx, realizedWinner, cashWin, cashLoss)

    if diagLowLossArmed
        f_diagAdd(diagMgmtT, diagMgmtW, diagMgmtGP, diagMgmtGL, 0, realizedWinner, cashWin, cashLoss)
    if diagProfitFloorStarted
        f_diagAdd(diagMgmtT, diagMgmtW, diagMgmtGP, diagMgmtGL, 1, realizedWinner, cashWin, cashLoss)
    if diagStrongFloorStarted
        f_diagAdd(diagMgmtT, diagMgmtW, diagMgmtGP, diagMgmtGL, 2, realizedWinner, cashWin, cashLoss)
    if runnerActivated
        f_diagAdd(diagMgmtT, diagMgmtW, diagMgmtGP, diagMgmtGL, 3, realizedWinner, cashWin, cashLoss)
    if targetExtended
        f_diagAdd(diagMgmtT, diagMgmtW, diagMgmtGP, diagMgmtGL, 4, realizedWinner, cashWin, cashLoss)

    int exitIdx = 15
    if pendingExitReason == "TARGET"
        exitIdx := 0
    else if pendingExitReason == "STOP / TARGET SAME BAR"
        exitIdx := 15
    else if pendingExitReason == "STOP"
        bool positiveStop = tradeDirection == 1 ? stopPrice > entryPrice + syminfo.mintick * 0.5 : stopPrice < entryPrice - syminfo.mintick * 0.5
        bool tightenedStop = tradeDirection == 1 ? stopPrice > hardStopPrice + syminfo.mintick * 0.5 : stopPrice < hardStopPrice - syminfo.mintick * 0.5
        exitIdx := positiveStop ? 3 : tightenedStop ? 2 : 1
    else if pendingExitReason == "REVERSAL DEVELOPING / BANK PROFIT"
        exitIdx := 4
    else if pendingExitReason == "TRADE HEALTH WEAK / BANK PROFIT"
        exitIdx := 5
    else if pendingExitReason == "FAST IMPULSE / BANK MOVE"
        exitIdx := 6
    else if pendingExitReason == "RUNNER EXHAUSTED"
        exitIdx := 7
    else if pendingExitReason == "PEAK GIVEBACK / BANK MOVE"
        exitIdx := 8
    else if pendingExitReason == "MOVE STALLED / TAKE PROFIT"
        exitIdx := 9
    else if pendingExitReason == "FAST FAILURE"
        exitIdx := 10
    else if pendingExitReason == "NO MOVE / CHOP"
        exitIdx := 11
    else if pendingExitReason == "MOVE TOO SLOW"
        exitIdx := 12
    else if pendingExitReason == "DIRECTION FLIPPED"
        exitIdx := 13
    else if pendingExitReason == "HARD SESSION STOP" or pendingExitReason == "SESSION EDGE GONE" or pendingExitReason == "MAX TIME"
        exitIdx := 14
    f_diagAdd(diagExitT, diagExitW, diagExitGP, diagExitGL, exitIdx, realizedWinner, cashWin, cashLoss)

    bool sameBarAmbiguous = pendingExitReason == "STOP / TARGET SAME BAR"
    if sameBarAmbiguous
        ambiguousSameBarTrades += 1
    else
        cleanTrades += 1
        cleanWins += realizedWinner ? 1 : 0

    if realizedWinner and mfeATR >= profitProtectTriggerATR
        reentryBlockedDirection := tradeDirection
        reentryBlockBar := bar_index

    lastExitBar := bar_index
    exitEvent := true

    string resultText = dirHit ? "DIR HIT" : "DIR MISS"
    string reasonText = pendingExitReason == "" ? "CLOSED" : pendingExitReason
    string outcomeText = realizedWinner ? "WIN" : realizedDirectionalMove < 0 ? "LOSS" : "FLAT"

    if showLabels
        label.new(
             bar_index,
             tradeDirection == 1 ? high : low,
             outcomeText + " / EXIT " + (tradeDirection == 1 ? "LONG" : "SHORT") +
             "\n" + reasonText +
             "\nExit " + str.tostring(realizedExit, format.mintick) +
             "\nMove " + str.tostring(realizedDirectionalMove, "#.##") +
             "\n" + resultText,
             style = tradeDirection == 1 ? label.style_label_down : label.style_label_up,
             color = realizedWinner ? color.lime : realizedDirectionalMove < 0 ? color.red : color.orange,
             textcolor = realizedWinner ? color.black : color.white,
             size = size.small
        )

    tradeDirection := 0
    entryTime := na
    entryBar := na
    entryPrice := na
    entryATR := na
    stopPrice := na
    hardStopPrice := na
    targetPrice := na
    originalTarget := na
    entryLeadScore := na
    tradeMFE := 0.0
    tradeMAE := 0.0
    expectedMinutes := na
    targetExtended := false
    closingRequested := false
    activeSetup := ""
    activeEntryTier := ""
    pendingExitReason := ""
    lastMFEBar := na
    runnerActivated := false
    selectiveRunnerTrade := false
    diagEntryADX := na
    diagEntryEfficiency := na
    diagEntryRVOL := na
    diagEntryATRRatio := na
    diagEntryLead := na
    diagEntryLeadEdge := na
    diagEntryExt9ATR := na
    diagEntryVWAPDistATR := na
    diagEntryBodyATR := na
    diagEntryRangeATR := na
    diagEntryFPDirectional := na
    diagEntryContextCount := na
    diagEntryCrossClass := na
    diagEntryFPClass := na
    diagEntryMinuteET := na
    diagEntryDOW := na
    diagEntryMonth := na
    diagEntryExhaustion := na
    diagEntryChop := false
    diagEntryStrongTrend := false
    diagLowLossArmed := false
    diagProfitFloorStarted := false
    diagStrongFloorStarted := false

if orphanTradeState
    tradeDirection := 0
    entryTime := na
    entryBar := na
    entryPrice := na
    entryATR := na
    stopPrice := na
    hardStopPrice := na
    targetPrice := na
    originalTarget := na
    entryLeadScore := na
    tradeMFE := 0.0
    tradeMAE := 0.0
    expectedMinutes := na
    targetExtended := false
    closingRequested := false
    activeSetup := ""
    activeEntryTier := ""
    pendingExitReason := ""
    lastMFEBar := na
    runnerActivated := false
    selectiveRunnerTrade := false
    diagEntryADX := na
    diagEntryEfficiency := na
    diagEntryRVOL := na
    diagEntryATRRatio := na
    diagEntryLead := na
    diagEntryLeadEdge := na
    diagEntryExt9ATR := na
    diagEntryVWAPDistATR := na
    diagEntryBodyATR := na
    diagEntryRangeATR := na
    diagEntryFPDirectional := na
    diagEntryContextCount := na
    diagEntryCrossClass := na
    diagEntryFPClass := na
    diagEntryMinuteET := na
    diagEntryDOW := na
    diagEntryMonth := na
    diagEntryExhaustion := na
    diagEntryChop := false
    diagEntryStrongTrend := false
    diagLowLossArmed := false
    diagProfitFloorStarted := false
    diagStrongFloorStarted := false

if not dayDone and inStopEval and sessionExhaustedPersistent and tradeDirection == 0 and strategy.position_size == 0
    dayDone := true
    dayDoneEvent := true
    stopDayEvent := true

if not dayDone and inHardStop and (not useV24Opportunity or not v24EnableCloseMomentum or currentMinuteET >= 960)
    dayDone := true
    dayDoneEvent := true
    stopDayEvent := true

if stopDayEvent
    if showLabels
        label.new(
             bar_index, high,
             "STOP TRADING FOR TODAY\n" +
             (inHardStop ? "TIME CUTOFF" : "SESSION EDGE EXHAUSTED"),
             style = label.style_label_down,
             color = color.gray,
             textcolor = color.white,
             size = size.normal
        )

plot(showEMAs ? ema9 : na, "EMA 9", color = color.yellow, linewidth = 1)
plot(showEMAs ? ema21 : na, "EMA 21", color = color.orange, linewidth = 2)
plot(showEMAs ? ema50 : na, "EMA 50", color = color.aqua, linewidth = 2)
plot(showVWAP ? vwap : na, "VWAP", color = color.white, linewidth = 2)

plot(showOR and not inOpeningRange ? openingHigh : na, "Opening Range High", color = color.new(color.lime, 35), style = plot.style_linebr)
plot(showOR and not inOpeningRange ? openingLow : na, "Opening Range Low", color = color.new(color.red, 35), style = plot.style_linebr)
plot(showPD ? pdh : na, "PDH", color = color.new(color.blue, 35), style = plot.style_linebr)
plot(showPD ? pdl : na, "PDL", color = color.new(color.blue, 35), style = plot.style_linebr)

plot(showTradeLines ? histEntryLine : na, "Trade Entry", color = color.yellow, linewidth = 2, style = plot.style_linebr)
plot(showTradeLines ? histTargetLine : na, "Trade Target", color = color.lime, linewidth = 3, style = plot.style_linebr)
plot(showTradeLines ? histStopLine : na, "Active / Low-Loss Stop", color = color.orange, linewidth = 3, style = plot.style_linebr)
plot(showTradeLines ? histHardStopLine : na, "Original Hard Stop", color = color.red, linewidth = 2, style = plot.style_linebr)

plot(longLeadScore, "Hidden Long Development Score", display = display.data_window)
plot(shortLeadScore, "Hidden Short Development Score", display = display.data_window)
plot(tradeDirection != 0 ? tradeHealth : na, "Hidden Trade Health", display = display.data_window)
plot(fpAvailable ? fpDeltaPct * 100.0 : na, "Footprint Delta %", display = display.data_window)
float proofTrailVisual =
     tradeDirection == 1 and tradeMFE >= entryATR * proofTrailActivateATR ? entryPrice + tradeMFE - entryATR * proofTrailOffsetATR :
     tradeDirection == -1 and tradeMFE >= entryATR * proofTrailActivateATR ? entryPrice - tradeMFE + entryATR * proofTrailOffsetATR : na
plot(proofTrailVisual, "v2.3 Proof Trail", display = display.data_window)

color stateBg =
     fpRequiredMissing ? color.new(color.orange, 90) :
     dayDone and inTradeSession ? color.new(color.gray, 95) : na
bgcolor(stateBg)

dirHitRate = researchTrades > 0 ? researchDirHits * 100.0 / researchTrades : na
avgDuration = researchTrades > 0 ? totalDurationMinutes / researchTrades : na
winRate = strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : na
avgCapturePct = researchTrades > 0 ? totalCapturePct / researchTrades : na
avgWinnerCapturePct = researchWinners > 0 ? winnerCapturePctTotal / researchWinners : na
dirHitToWinPct = researchDirHits > 0 ? dirHitWins * 100.0 / researchDirHits : na
avgDirHitGivebackPct = researchDirHits > 0 ? dirHitGivebackPctTotal / researchDirHits : na
cleanWinRate = cleanTrades > 0 ? cleanWins * 100.0 / cleanTrades : na

string managementMode =
     tradeDirection == 0 ? "-" :
     runnerActivated ? "RUNNER" :
     (fastImpulseLong or fastImpulseShort) ? "IMPULSE" :
     "NORMAL"

string actionState =
     dayDone ? "STOP TRADING" :
     tradeDirection == 1 ? "HOLD CALL" :
     tradeDirection == -1 ? "HOLD PUT" :
     longSignal ? "ENTER CALL" :
     shortSignal ? "ENTER PUT" :
     inTradeSession ? "SCANNING" : "CLOSED"

string marketState =
     chopCondition ? "CHOP" :
     strongLongTrend ? "STRONG UP" :
     strongShortTrend ? "STRONG DOWN" :
     efficiency >= minEntryEfficiency ? "MOVING" : "MIXED"

string crossState =
     not useCrossMarket ? "OFF" :
     crossBullCount >= 2 ? "BULL" :
     crossBearCount >= 2 ? "BEAR" : "MIXED"

float strategyPFDiag = f_diagPF(diagCallGP + diagPutGP, diagCallGL + diagPutGL)
float avgMFEATRAll = researchTrades > 0 ? diagTotalMFEATR / researchTrades : na
float avgMAEATRAll = researchTrades > 0 ? diagTotalMAEATR / researchTrades : na
float avgWinnerMFEATR = researchWinners > 0 ? diagWinnerMFEATR / researchWinners : na
float avgWinnerMAEATR = researchWinners > 0 ? diagWinnerMAEATR / researchWinners : na
float avgLoserMFEATR = diagLosers > 0 ? diagLoserMFEATR / diagLosers : na
float avgLoserMAEATR = diagLosers > 0 ? diagLoserMAEATR / diagLosers : na
float avgRealizedRAll = researchTrades > 0 ? diagTotalRealizedR / researchTrades : na
float avgWinnerR = researchWinners > 0 ? diagWinnerRealizedR / researchWinners : na
float avgLoserR = diagLosers > 0 ? diagLoserRealizedR / diagLosers : na
float avgWinnerTime = researchWinners > 0 ? diagWinnerDuration / researchWinners : na
float avgLoserTime = diagLosers > 0 ? diagLoserDuration / diagLosers : na
float longAcceptPct = diagLongCandidates > 0 ? diagLongAccepted * 100.0 / diagLongCandidates : na
float shortAcceptPct = diagShortCandidates > 0 ? diagShortAccepted * 100.0 / diagShortCandidates : na

f_diagPage1C0(table t) =>
    f_header(t, 0, "LIVE / MARKET", syminfo.ticker + " / " + timeframe.period)
    f_pair(t, 0, 1, "ACTION", actionState, dayDone ? color.gray : tradeDirection == 1 or longSignal ? color.lime : tradeDirection == -1 or shortSignal ? color.red : color.white)
    f_pair(t, 0, 2, "Setup", tradeDirection != 0 ? activeSetup + " / " + activeEntryTier : "-", color.white)
    f_pair(t, 0, 3, "Age / Expected", tradeDirection != 0 ? str.tostring(nz(tradeAgeMinutes, 0), "#.0") + " / " + str.tostring(expectedMinutes, "#") + "m" : "-", color.white)
    f_pair(t, 0, 4, "Move Progress", tradeDirection != 0 ? str.tostring(currentProgress * 100.0, "#") + "%" : "-", currentProgress >= 0.5 ? color.lime : color.white)
    f_pair(t, 0, 5, "Market", marketState, marketState == "CHOP" ? color.orange : color.white)
    f_pair(t, 0, 6, "Efficiency", str.tostring(efficiency, "#.##"), efficiency >= minEntryEfficiency ? color.lime : color.orange)
    f_pair(t, 0, 7, "ADX", str.tostring(adx, "#.0"), adx >= strongTrendADX ? color.lime : color.white)
    f_pair(t, 0, 8, "ATR Regime", str.tostring(atrRatio, "#.##") + "x", atrRatio >= 1.0 ? color.lime : color.white)
    f_pair(t, 0, 9, "RVOL", str.tostring(rvol, "#.##") + "x", rvol >= 1.0 ? color.lime : color.white)
    f_pair(t, 0, 10, "Cross Market", crossState, crossState == "BULL" ? color.lime : crossState == "BEAR" ? color.red : color.white)
    f_pair(t, 0, 11, "Footprint Delta", fpAvailable ? str.tostring(fpDeltaPct * 100.0, "#.1") + "%" : "N/A", fpStrongBuy ? color.lime : fpStrongSell ? color.red : color.white)
    f_pair(t, 0, 12, "Long / Short Dev", str.tostring(longLeadScore, "#") + " / " + str.tostring(shortLeadScore, "#"), color.white)
    f_pair(t, 0, 13, "Trade Health", tradeDirection != 0 ? str.tostring(tradeHealth, "#") : "-", tradeDirection != 0 and tradeHealth <= healthExitLevel ? color.orange : color.white)
    f_pair(t, 0, 14, "Day Exhaust", str.tostring(exhaustionCount) + "/7", sessionExhaustedPersistent ? color.orange : color.white)
    f_pair(t, 0, 15, "Trade Mode", managementMode, managementMode == "RUNNER" ? color.lime : managementMode == "IMPULSE" ? color.yellow : color.white)
    f_pair(t, 0, 16, "Exec Mode", executionMode, color.aqua)
    f_pair(t, 0, 17, "Mode", "FULL GRID", color.aqua)

f_diagPage1C2(table t) =>
    f_header(t, 2, "QUALITY / CAPTURE", "v2.5")
    f_pair(t, 2, 1, "Strategy WR", strategy.closedtrades > 0 ? str.tostring(winRate, "#.1") + "% (" + str.tostring(strategy.wintrades) + "/" + str.tostring(strategy.closedtrades) + ")" : "-", strategy.closedtrades > 0 and winRate >= 55 ? color.lime : color.orange)
    f_pair(t, 2, 2, "Strategy PF", na(strategyPFDiag) ? "-" : str.tostring(strategyPFDiag, "#.##"), not na(strategyPFDiag) and strategyPFDiag >= 1.25 ? color.lime : not na(strategyPFDiag) and strategyPFDiag < 1 ? color.orange : color.white)
    f_pair(t, 2, 3, "Dir Hit Rate", researchTrades > 0 ? str.tostring(dirHitRate, "#.1") + "% (" + str.tostring(researchDirHits) + "/" + str.tostring(researchTrades) + ")" : "-", dirHitRate >= 70 ? color.lime : color.white)
    f_pair(t, 2, 4, "Dir Hit -> Win", researchDirHits > 0 ? str.tostring(dirHitToWinPct, "#.1") + "%" : "-", dirHitToWinPct >= 80 ? color.lime : color.orange)
    f_pair(t, 2, 5, "Dir Hit Losses", str.tostring(dirHitLosses), dirHitLosses > 0 ? color.orange : color.white)
    f_pair(t, 2, 6, "Avg Capture", researchTrades > 0 ? str.tostring(avgCapturePct, "#.1") + "%" : "-", avgCapturePct >= 50 ? color.lime : color.orange)
    f_pair(t, 2, 7, "Winner Capture", researchWinners > 0 ? str.tostring(avgWinnerCapturePct, "#.1") + "%" : "-", avgWinnerCapturePct >= 60 ? color.lime : color.orange)
    f_pair(t, 2, 8, "Dir Hit Giveback", researchDirHits > 0 ? str.tostring(avgDirHitGivebackPct, "#.1") + "%" : "-", avgDirHitGivebackPct <= 35 ? color.lime : color.orange)
    f_pair(t, 2, 9, "Avg MFE / MAE", researchTrades > 0 ? str.tostring(avgMFEATRAll, "#.2") + "R / " + str.tostring(avgMAEATRAll, "#.2") + "R" : "-", color.white)
    f_pair(t, 2, 10, "Winner MFE / MAE", researchWinners > 0 ? str.tostring(avgWinnerMFEATR, "#.2") + " / " + str.tostring(avgWinnerMAEATR, "#.2") : "-", color.lime)
    f_pair(t, 2, 11, "Loser MFE / MAE", diagLosers > 0 ? str.tostring(avgLoserMFEATR, "#.2") + " / " + str.tostring(avgLoserMAEATR, "#.2") : "-", color.orange)
    f_pair(t, 2, 12, "Avg R / Trade", researchTrades > 0 ? str.tostring(avgRealizedRAll, "#.3") : "-", avgRealizedRAll > 0 ? color.lime : color.orange)
    f_pair(t, 2, 13, "Avg Win R", researchWinners > 0 ? str.tostring(avgWinnerR, "#.3") : "-", color.lime)
    f_pair(t, 2, 14, "Avg Loss R", diagLosers > 0 ? str.tostring(avgLoserR, "#.3") : "-", color.orange)
    f_pair(t, 2, 15, "Avg Trade Time", researchTrades > 0 ? str.tostring(avgDuration, "#.1") + "m" : "-", color.white)
    f_pair(t, 2, 16, "Same-Bar Ambig", str.tostring(ambiguousSameBarTrades), ambiguousSameBarTrades > 0 ? color.orange : color.white)
    f_pair(t, 2, 17, "Clean WR", cleanTrades > 0 ? str.tostring(cleanWinRate, "#.1") + "%" : "-", cleanWinRate >= 55 ? color.lime : color.white)

f_diagPage1C4(table t) =>
    f_header(t, 4, "SETUP PERFORMANCE", "Trades | WR | PF")
    f_pair(t, 4, 1, "CALL", f_diagLine(diagCallTrades, diagCallWins, diagCallGP, diagCallGL), f_diagColor(diagCallTrades, diagCallWins, diagCallGP, diagCallGL))
    f_pair(t, 4, 2, "PUT", f_diagLine(diagPutTrades, diagPutWins, diagPutGP, diagPutGL), f_diagColor(diagPutTrades, diagPutWins, diagPutGP, diagPutGL))
    f_pair(t, 4, 3, "Opening Range BO", f_diagLine(diagORTrades, diagORWins, diagORGP, diagORGL), f_diagColor(diagORTrades, diagORWins, diagORGP, diagORGL))
    f_pair(t, 4, 4, "Breakout", f_diagLine(diagBOTrades, diagBOWins, diagBOGP, diagBOGL), f_diagColor(diagBOTrades, diagBOWins, diagBOGP, diagBOGL))
    f_pair(t, 4, 5, "Liquidity Rev", f_diagLine(diagLiqTrades, diagLiqWins, diagLiqGP, diagLiqGL), f_diagColor(diagLiqTrades, diagLiqWins, diagLiqGP, diagLiqGL))
    f_pair(t, 4, 6, "EMA Pullback", f_diagLine(diagEMATrades, diagEMAWins, diagEMAGP, diagEMAGL), f_diagColor(diagEMATrades, diagEMAWins, diagEMAGP, diagEMAGL))
    f_pair(t, 4, 7, "VWAP Reclaim", f_diagLine(diagVWAPTrades, diagVWAPWins, diagVWAPGP, diagVWAPGL), f_diagColor(diagVWAPTrades, diagVWAPWins, diagVWAPGP, diagVWAPGL))
    f_pair(t, 4, 8, "Early Continuation", f_diagLine(diagEarlyTrades, diagEarlyWins, diagEarlyGP, diagEarlyGL), f_diagColor(diagEarlyTrades, diagEarlyWins, diagEarlyGP, diagEarlyGL))
    f_pair(t, 4, 10, "CALL Accept", diagLongCandidates > 0 ? str.tostring(diagLongAccepted) + "/" + str.tostring(diagLongCandidates) + " = " + str.tostring(longAcceptPct, "#.1") + "%" : "-", color.white)
    f_pair(t, 4, 11, "PUT Accept", diagShortCandidates > 0 ? str.tostring(diagShortAccepted) + "/" + str.tostring(diagShortCandidates) + " = " + str.tostring(shortAcceptPct, "#.1") + "%" : "-", color.white)
    f_pair(t, 4, 12, "Signal Conflicts", str.tostring(diagSignalConflicts), diagSignalConflicts > 0 ? color.orange : color.white)
    f_pair(t, 4, 13, "Chase Blocks C/P", str.tostring(openingChaseCallBlocks) + " / " + str.tostring(openingChasePutBlocks), color.orange)
    f_pair(t, 4, 14, "Climax Blocks C/P", str.tostring(firstHourClimaxCallBlocks) + " / " + str.tostring(firstHourClimaxPutBlocks), color.orange)
    f_pair(t, 4, 15, "PUT EMA Blocks", str.tostring(putEMABlocks), color.orange)
    f_pair(t, 4, 16, "Early PUT BO Blocks", str.tostring(earlyPutBreakoutBlocks), color.orange)
    f_pair(t, 4, 17, "VERSION", "v2.10 CONTEXT RESCUE", color.aqua)

