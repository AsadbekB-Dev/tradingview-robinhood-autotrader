    f_pair(t, 8, 8, "VWAP >= .60", f_diagArrLine(diagVWAPDistT, diagVWAPDistW, diagVWAPDistGP, diagVWAPDistGL, 3), f_diagArrColor(diagVWAPDistT, diagVWAPDistW, diagVWAPDistGP, diagVWAPDistGL, 3))
