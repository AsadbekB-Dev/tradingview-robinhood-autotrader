f_diagPage4C8(table t) =>
    f_header(t, 8, "DAMAGE / SALVAGE", "Counts / clues")
    f_pair(t, 8, 1, "Loss after .15 MFE", str.tostring(diagLossAfterMFE15), diagLossAfterMFE15 > 0 ? color.orange : color.white)
    f_pair(t, 8, 2, "Loss after .30 MFE", str.tostring(diagLossAfterMFE30), diagLossAfterMFE30 > 0 ? color.orange : color.white)
