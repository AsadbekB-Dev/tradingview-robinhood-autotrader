    f_pair(t, 8, 8, "MFE >= .30", f_diagArrLine(diagMFET, diagMFEW, diagMFEGP, diagMFEGL, 1), f_diagArrColor(diagMFET, diagMFEW, diagMFEGP, diagMFEGL, 1))
    f_pair(t, 8, 9, "MFE >= .50", f_diagArrLine(diagMFET, diagMFEW, diagMFEGP, diagMFEGL, 2), f_diagArrColor(diagMFET, diagMFEW, diagMFEGP, diagMFEGL, 2))
