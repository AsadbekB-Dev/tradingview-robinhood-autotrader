    f_pair(t, 2, 15, ">= 20 min", f_diagArrLine(diagDurationT, diagDurationW, diagDurationGP, diagDurationGL, 3), f_diagArrColor(diagDurationT, diagDurationW, diagDurationGP, diagDurationGL, 3))

