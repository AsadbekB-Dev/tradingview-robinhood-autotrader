groupV29A = "5AH. Deep Attribution"
v29AAttributionMode = input.string(
     "SETUP",
     "Deep Attribution Mode",
     options = ["SETUP", "TIME", "DAY", "ATR", "EFFICIENCY", "CONTEXT"],
     group = groupV29A,
     tooltip = "Does NOT change trading logic. It only changes strategy entry IDs so TradingView Deep Backtest → Breakdown → By signals can show full-year performance by one dimension at a time."
)

