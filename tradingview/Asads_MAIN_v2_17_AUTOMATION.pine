openingChaseRangeATR  = input.float(1.85, "Opening Chase Signal Range ATR", minval = 0.50, step = 0.05, group = groupEntry)
openingChaseVotes     = input.int(3, "Opening Chase Conditions Required", minval = 2, maxval = 4, group = groupEntry)

useFirstHourBreakoutClimaxFilter = input.bool(true, "Use First-Hour Normal Breakout Climax Filter", group = groupEntry)
climaxExt9ATR     = input.float(1.65, "Climax EMA9 Extension ATR", minval = 0.50, step = 0.05, group = groupEntry)
climaxExt21ATR    = input.float(2.45, "Climax EMA21 Extension ATR", minval = 0.75, step = 0.05, group = groupEntry)
climaxMove3ATR    = input.float(1.75, "Climax 3-Bar Move ATR", minval = 0.50, step = 0.05, group = groupEntry)
climaxBodyATR     = input.float(0.95, "Climax Signal Body ATR", minval = 0.20, step = 0.05, group = groupEntry)
climaxRVOL        = input.float(1.80, "Climax Minimum RVOL", minval = 0.50, step = 0.10, group = groupEntry)
