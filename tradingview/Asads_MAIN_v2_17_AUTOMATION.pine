    f_pair(t, 8, 15, "Target extension", f_diagArrLine(diagMgmtT, diagMgmtW, diagMgmtGP, diagMgmtGL, 4), f_diagArrColor(diagMgmtT, diagMgmtW, diagMgmtGP, diagMgmtGL, 4))

