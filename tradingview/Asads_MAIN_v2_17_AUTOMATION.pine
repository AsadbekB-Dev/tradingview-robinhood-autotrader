//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}
strategy(
     "Asads MAIN v2.17 • AUTOMATION",
     overlay = true,
     pyramiding = 0,
     process_orders_on_close = true,
     calc_on_every_tick = true,
     calc_on_order_fills = false,
     use_bar_magnifier = true,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 10,
     commission_type = strategy.commission.percent,
     commission_value = 0.0,
     max_labels_count = 500,
     max_lines_count = 500
)

groupSession = "1. Session"
string sessionTZ = "America/New_York"
tradeSession     = input.session("0930-1615", "Options Trading Window (ET)", group = groupSession)
stopEvalSession  = input.session("1300-1500", "Adaptive Stop-Day Window (ET)", group = groupSession)
hardStopSession  = input.session("1500-1615", "Hard Stop-Day Window (ET)", group = groupSession)
openingRangeSess = input.session("0930-1000", "Opening Range (ET)", group = groupSession)
executionMode   = input.string("Research - Bar Close", "Signal Execution Mode",
     options = ["Research - Bar Close", "Live - Intrabar"], group = groupSession)
tradeMonday     = input.bool(true, "Trade Monday", group = groupSession)
tradeTuesday    = input.bool(true, "Trade Tuesday", group = groupSession)
tradeWednesday  = input.bool(true, "Trade Wednesday", group = groupSession)
tradeThursday   = input.bool(true, "Trade Thursday", group = groupSession)
tradeFriday     = input.bool(true, "Trade Friday", group = groupSession)

groupTrend = "2. Direction Context"
emaFastLen      = input.int(9, "Fast EMA", minval = 2, group = groupTrend)
emaMidLen       = input.int(21, "Mid EMA", minval = 3, group = groupTrend)
emaSlowLen      = input.int(50, "Slow EMA", minval = 5, group = groupTrend)
adxLen          = input.int(14, "ADX Length", minval = 5, group = groupTrend)
adxSmooth       = input.int(14, "ADX Smoothing", minval = 5, group = groupTrend)
minEntryADX     = input.float(13.0, "Minimum Entry ADX", minval = 5, step = 0.5, group = groupTrend)
strongTrendADX  = input.float(23.0, "Strong Trend ADX", minval = 10, step = 0.5, group = groupTrend)
structureLen    = input.int(12, "Breakout / Liquidity Lookback", minval = 5, group = groupTrend)

groupRegime = "3. Chop / Movement Quality"
effLen              = input.int(10, "Efficiency Lookback", minval = 4, group = groupRegime)
minEntryEfficiency  = input.float(0.22, "Minimum Entry Efficiency", minval = 0.05, maxval = 0.80, step = 0.01, group = groupRegime)
chopEfficiency      = input.float(0.18, "Chop Efficiency Threshold", minval = 0.03, maxval = 0.50, step = 0.01, group = groupRegime)
chopCrossLookback   = input.int(12, "VWAP Cross Lookback", minval = 5, group = groupRegime)
chopCrossThreshold  = input.float(3.0, "VWAP Crosses = Chop", minval = 1, step = 1, group = groupRegime)
minATRRatio         = input.float(0.68, "Minimum ATR / ATR Average", minval = 0.30, step = 0.02, group = groupRegime)
rvolLen             = input.int(20, "RVOL Length", minval = 5, group = groupRegime)

groupCross = "4. Cross-Market Context"
useCrossMarket = input.bool(true, "Use SPY / QQQ / IWM Confirmation", group = groupCross)
spySymbol      = input.symbol("BATS:SPY", "SPY Symbol", group = groupCross)
qqqSymbol      = input.symbol("BATS:QQQ", "QQQ Symbol", group = groupCross)
iwmSymbol      = input.symbol("BATS:IWM", "IWM Symbol", group = groupCross)
crossBars      = input.int(3, "Cross-Market Return Bars", minval = 1, maxval = 12, group = groupCross)
crossMovePct   = input.float(0.03, "Meaningful Cross-Market Move %", minval = 0.0, step = 0.01, group = groupCross)

groupPremium = "4B. Premium Footprint / Order Flow"
fpMode = input.string("Use when available", "Footprint Mode",
     options = ["Use when available", "Required", "Off"], group = groupPremium)
fpTicks = input.int(10, "Ticks Per Footprint Row", minval = 1, maxval = 1000, group = groupPremium)
fpVA = input.int(70, "Footprint Value Area %", minval = 1, maxval = 100, group = groupPremium)
fpOpposingVeto = input.float(0.18, "Entry Veto If Opposing Delta Exceeds", minval = 0.05, maxval = 0.60, step = 0.01, group = groupPremium)
fpStrongDelta = input.float(0.12, "Strong Directional Delta", minval = 0.03, maxval = 0.50, step = 0.01, group = groupPremium)

groupEntry = "5. Entry Logic"
cooldownBars          = input.int(2, "Bars Between Trades", minval = 0, maxval = 20, group = groupEntry)
bodyATRMin            = input.float(0.22, "Displacement Body ATR", minval = 0.05, step = 0.01, group = groupEntry)
pullbackToleranceATR  = input.float(0.12, "EMA Pullback Tolerance ATR", minval = 0.02, step = 0.01, group = groupEntry)
allowVWAPReclaim      = input.bool(true, "Allow VWAP Reclaim Entries", group = groupEntry)
allowLiquiditySweep   = input.bool(true, "Allow Liquidity Sweep Entries", group = groupEntry)
allowOpeningBreakout  = input.bool(true, "Allow Opening Range Breakouts", group = groupEntry)

allowPressureContinuation = input.bool(true, "Allow Early Pressure Continuation", group = groupEntry)
pressureNearBreakATR       = input.float(0.18, "Pressure Entry Distance From Breakout ATR", minval = 0.05, maxval = 0.50, step = 0.01, group = groupEntry)

requireTransitionForCounterSweep = input.bool(true, "Require Transition For Counter-Trend Sweep", group = groupEntry)

sameDirResetMaxBars = input.int(4, "Maximum Same-Direction Re-entry Block Bars", minval = 1, maxval = 20, group = groupEntry)
resetTouchATR       = input.float(0.10, "Reset Pullback Tolerance ATR", minval = 0.0, maxval = 0.50, step = 0.01, group = groupEntry)

putRequireFullContext = input.bool(true, "PUTs Require Full 3/3 Context Unless Opening Breakout", group = groupEntry)
putMinADX              = input.float(18.0, "PUT Minimum ADX", minval = 5.0, step = 0.5, group = groupEntry)
putMinEfficiency       = input.float(0.27, "PUT Minimum Efficiency", minval = 0.05, maxval = 0.80, step = 0.01, group = groupEntry)

disablePutEarlyContinuation = input.bool(true, "Disable PUT Early Continuation", group = groupEntry)
putBreakoutMinADX          = input.float(21.0, "PUT Breakout Minimum ADX", minval = 5.0, step = 0.5, group = groupEntry)
putBreakoutMinEfficiency   = input.float(0.31, "PUT Breakout Minimum Efficiency", minval = 0.05, maxval = 0.80, step = 0.01, group = groupEntry)
putBreakoutNeedsExternalConfirm = input.bool(true, "PUT Breakout Needs Trend/Cross-Market Confirmation", group = groupEntry)
putEMAPullbackNeedsStrongTrend = input.bool(true, "PUT EMA Pullback Requires Strong Bear Trend", group = groupEntry)
blockNewPutsAfter1000 = input.bool(true, "Block New PUTs After 13:00 ET", group = groupEntry)

disablePutEMAPullback = input.bool(true, "Disable PUT EMA Pullback", group = groupEntry)
restrictPutBreakoutBefore0900 = input.bool(true, "Restrict Normal PUT Breakouts Before 12:00 ET", group = groupEntry)
earlyPutBreakoutMinADX = input.float(27.0, "Exceptional Early PUT Breakout Min ADX", minval = 10.0, step = 0.5, group = groupEntry)
earlyPutBreakoutMinEfficiency = input.float(0.42, "Exceptional Early PUT Breakout Min Efficiency", minval = 0.10, maxval = 0.90, step = 0.01, group = groupEntry)
earlyPutBreakoutNeedCrossStrong = input.bool(true, "Exceptional Early PUT Needs Cross-Market Bear Confirmation", group = groupEntry)

specialSetupMinADX        = input.float(18.0, "EMA/VWAP Minimum ADX", minval = 5.0, step = 0.5, group = groupEntry)
specialSetupMinEfficiency = input.float(0.28, "EMA/VWAP Minimum Efficiency", minval = 0.05, maxval = 0.80, step = 0.01, group = groupEntry)

lateSessionStrict = input.bool(true, "Use Strict Entry Rules After 13:00 ET", group = groupEntry)
lateSessionMinADX = input.float(20.0, "After 13:00 ET Minimum ADX", minval = 5.0, step = 0.5, group = groupEntry)
lateSessionMinEfficiency = input.float(0.30, "After 13:00 ET Minimum Efficiency", minval = 0.05, maxval = 0.80, step = 0.01, group = groupEntry)

useOpeningChaseFilter = input.bool(true, "Use 09:30-10:30 ET Breakout Chase Filter", group = groupEntry)
openingChaseExt9ATR   = input.float(2.05, "Opening Chase EMA9 Extension ATR", minval = 0.50, step = 0.05, group = groupEntry)
openingChaseMove3ATR  = input.float(2.35, "Opening Chase 3-Bar Move ATR", minval = 0.50, step = 0.05, group = groupEntry)
