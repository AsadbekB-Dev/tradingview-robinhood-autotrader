    f_pair(t, 12, 1, "09:30-10:00", f_diagArrLine(diagSideTimeT, diagSideTimeW, diagSideTimeGP, diagSideTimeGL, 7), f_diagArrColor(diagSideTimeT, diagSideTimeW, diagSideTimeGP, diagSideTimeGL, 7))
