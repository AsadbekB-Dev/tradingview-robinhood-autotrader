    f_pair(t, 8, 15, "Exhaust 0-1", f_diagArrLine(diagExhaustT, diagExhaustW, diagExhaustGP, diagExhaustGL, 0), f_diagArrColor(diagExhaustT, diagExhaustW, diagExhaustGP, diagExhaustGL, 0))
    f_pair(t, 8, 16, "Exhaust 2-3", f_diagArrLine(diagExhaustT, diagExhaustW, diagExhaustGP, diagExhaustGL, 1), f_diagArrColor(diagExhaustT, diagExhaustW, diagExhaustGP, diagExhaustGL, 1))
    f_pair(t, 8, 17, "Exhaust 4+", f_diagArrLine(diagExhaustT, diagExhaustW, diagExhaustGP, diagExhaustGL, 2), f_diagArrColor(diagExhaustT, diagExhaustW, diagExhaustGP, diagExhaustGL, 2))

f_diagPage4C0(table t) =>
    f_header(t, 0, "MOVE / PAYOFF", "Deep capture stats")
    f_pair(t, 0, 1, "Avg MFE ATR", researchTrades > 0 ? str.tostring(avgMFEATRAll, "#.3") : "-", color.white)
    f_pair(t, 0, 2, "Avg MAE ATR", researchTrades > 0 ? str.tostring(avgMAEATRAll, "#.3") : "-", color.white)
    f_pair(t, 0, 3, "Winner MFE ATR", researchWinners > 0 ? str.tostring(avgWinnerMFEATR, "#.3") : "-", color.lime)
    f_pair(t, 0, 4, "Winner MAE ATR", researchWinners > 0 ? str.tostring(avgWinnerMAEATR, "#.3") : "-", color.white)
    f_pair(t, 0, 5, "Loser MFE ATR", diagLosers > 0 ? str.tostring(avgLoserMFEATR, "#.3") : "-", color.orange)
    f_pair(t, 0, 6, "Loser MAE ATR", diagLosers > 0 ? str.tostring(avgLoserMAEATR, "#.3") : "-", color.orange)
    f_pair(t, 0, 7, "Avg R / Trade", researchTrades > 0 ? str.tostring(avgRealizedRAll, "#.3") : "-", avgRealizedRAll > 0 ? color.lime : color.orange)
    f_pair(t, 0, 8, "Avg Win R", researchWinners > 0 ? str.tostring(avgWinnerR, "#.3") : "-", color.lime)
    f_pair(t, 0, 9, "Avg Loss R", diagLosers > 0 ? str.tostring(avgLoserR, "#.3") : "-", color.orange)
    f_pair(t, 0, 10, "Avg Capture", researchTrades > 0 ? str.tostring(avgCapturePct, "#.1") + "%" : "-", color.white)
    f_pair(t, 0, 11, "Winner Capture", researchWinners > 0 ? str.tostring(avgWinnerCapturePct, "#.1") + "%" : "-", color.white)
    f_pair(t, 0, 12, "Dir Hit Giveback", researchDirHits > 0 ? str.tostring(avgDirHitGivebackPct, "#.1") + "%" : "-", color.orange)
    f_pair(t, 0, 13, "Dir Hit -> Win", researchDirHits > 0 ? str.tostring(dirHitToWinPct, "#.1") + "%" : "-", color.white)
    f_pair(t, 0, 14, "Avg Winner Time", researchWinners > 0 ? str.tostring(avgWinnerTime, "#.1") + "m" : "-", color.lime)
    f_pair(t, 0, 15, "Avg Loser Time", diagLosers > 0 ? str.tostring(avgLoserTime, "#.1") + "m" : "-", color.orange)
    f_pair(t, 0, 17, "Diag Page", "4 / 5", color.aqua)

f_diagPage4C2(table t) =>
