f_diagExtraC14(table t) =>
    f_header(t, 14, "CALL MFE COHORT", "Trades | WR | PF")
    f_pair(t, 14, 1, "MFE >= .15", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 0), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 0))
    f_pair(t, 14, 2, "MFE >= .30", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 1), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 1))
    f_pair(t, 14, 3, "MFE >= .50", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 2), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 2))
    f_pair(t, 14, 4, "MFE >= .75", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 3), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 3))
    f_pair(t, 14, 5, "MFE >= 1.00", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 4), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 4))

f_diagExtraC16(table t) =>
    f_header(t, 16, "PUT MFE COHORT", "Trades | WR | PF")
    f_pair(t, 16, 1, "MFE >= .15", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 5), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 5))
    f_pair(t, 16, 2, "MFE >= .30", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 6), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 6))
    f_pair(t, 16, 3, "MFE >= .50", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 7), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 7))
    f_pair(t, 16, 4, "MFE >= .75", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 8), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 8))
    f_pair(t, 16, 5, "MFE >= 1.00", f_diagArrLine(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 9), f_diagArrColor(diagSideMFET, diagSideMFEW, diagSideMFEGP, diagSideMFEGL, 9))

f_diagExtraC18(table t) =>
    f_header(t, 18, "SIDE GIVEBACK", "Counts / capture")
    f_pair(t, 18, 1, "CALL loss after .30", str.tostring(diagCallLossAfterMFE30), diagCallLossAfterMFE30 > 0 ? color.orange : color.white)
    f_pair(t, 18, 2, "CALL loss after .50", str.tostring(diagCallLossAfterMFE50), diagCallLossAfterMFE50 > 0 ? color.orange : color.white)
    f_pair(t, 18, 3, "PUT loss after .30", str.tostring(diagPutLossAfterMFE30), diagPutLossAfterMFE30 > 0 ? color.orange : color.white)
    f_pair(t, 18, 4, "PUT loss after .50", str.tostring(diagPutLossAfterMFE50), diagPutLossAfterMFE50 > 0 ? color.orange : color.white)
    f_pair(t, 18, 6, "CALL winner capture", diagCallWins > 0 ? str.tostring(diagCallWinnerCaptureTotal / diagCallWins, "#.1") + "%" : "-", color.white)
    f_pair(t, 18, 7, "PUT winner capture", diagPutWins > 0 ? str.tostring(diagPutWinnerCaptureTotal / diagPutWins, "#.1") + "%" : "-", color.white)

var table dash = table.new(position.top_left, 20, 64, bgcolor = color.new(color.black, 8), border_width = 0)

if barstate.islast and showTable
    table.clear(dash, 0, 0, 19, 63)

    diagRowOffset := 0
    diagColOffset := -2
    f_diagPage1C2(dash)
    f_diagPage1C4(dash)
    f_diagPage1C6(dash)
    f_diagPage1C8(dash)

    diagColOffset := 8
    f_diagPage2C0(dash)
    f_diagPage2C2(dash)
    f_diagPage2C4(dash)
    f_diagPage2C6(dash)
    f_diagPage2C8(dash)

    diagColOffset := 18
    f_diagPage3C0(dash)

    diagRowOffset := 18
    diagColOffset := -2
    f_diagPage3C2(dash)
    f_diagPage3C4(dash)
    f_diagPage3C6(dash)
    f_diagPage3C8(dash)

    diagColOffset := 8
    f_diagPage4C0(dash)
    f_diagPage4C2(dash)
    f_diagPage4C4(dash)
    f_diagPage4C6(dash)
    f_diagPage4C8(dash)

    diagColOffset := 18
    f_diagPage5C0(dash)

    diagRowOffset := 36
    diagColOffset := -2
    f_diagPage5C2(dash)
    f_diagPage5C4(dash)
    f_diagPage5C6(dash)
    f_diagPage5C8(dash)

    diagColOffset := 0
    f_diagExtraC8(dash)
    f_diagExtraC10(dash)
    f_diagExtraC12(dash)
    f_diagExtraC14(dash)
    f_diagExtraC16(dash)
    f_diagExtraC18(dash)

    diagColOffset := 0
    diagRowOffset := 0
