    f_header(t, 10, "CALL BY TIME", "Trades | WR | PF")
    f_pair(t, 10, 1, "09:30-10:00", f_diagArrLine(diagSideTimeT, diagSideTimeW, diagSideTimeGP, diagSideTimeGL, 0), f_diagArrColor(diagSideTimeT, diagSideTimeW, diagSideTimeGP, diagSideTimeGL, 0))
    f_pair(t, 10, 2, "10:00-11:00", f_diagArrLine(diagSideTimeT, diagSideTimeW, diagSideTimeGP, diagSideTimeGL, 1), f_diagArrColor(diagSideTimeT, diagSideTimeW, diagSideTimeGP, diagSideTimeGL, 1))
