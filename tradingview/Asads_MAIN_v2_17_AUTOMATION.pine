    f_pair(t, 8, 1, "Range < .50 ATR", f_diagArrLine(diagRangeT, diagRangeW, diagRangeGP, diagRangeGL, 0), f_diagArrColor(diagRangeT, diagRangeW, diagRangeGP, diagRangeGL, 0))
    f_pair(t, 8, 2, "Range .50-.80", f_diagArrLine(diagRangeT, diagRangeW, diagRangeGP, diagRangeGL, 1), f_diagArrColor(diagRangeT, diagRangeW, diagRangeGP, diagRangeGL, 1))
    f_pair(t, 8, 3, "Range .80-1.20", f_diagArrLine(diagRangeT, diagRangeW, diagRangeGP, diagRangeGL, 2), f_diagArrColor(diagRangeT, diagRangeW, diagRangeGP, diagRangeGL, 2))
    f_pair(t, 8, 4, "Range >= 1.20", f_diagArrLine(diagRangeT, diagRangeW, diagRangeGP, diagRangeGL, 3), f_diagArrColor(diagRangeT, diagRangeW, diagRangeGP, diagRangeGL, 3))
    f_pair(t, 8, 6, "Entry CHOP", f_diagArrLine(diagStateT, diagStateW, diagStateGP, diagStateGL, 0), f_diagArrColor(diagStateT, diagStateW, diagStateGP, diagStateGL, 0))
    f_pair(t, 8, 7, "Entry normal", f_diagArrLine(diagStateT, diagStateW, diagStateGP, diagStateGL, 1), f_diagArrColor(diagStateT, diagStateW, diagStateGP, diagStateGL, 1))
    f_pair(t, 8, 8, "Entry strong trend", f_diagArrLine(diagStateT, diagStateW, diagStateGP, diagStateGL, 2), f_diagArrColor(diagStateT, diagStateW, diagStateGP, diagStateGL, 2))
    f_pair(t, 8, 10, "A-tier", f_diagArrLine(diagTierT, diagTierW, diagTierGP, diagTierGL, 0), f_diagArrColor(diagTierT, diagTierW, diagTierGP, diagTierGL, 0))
    f_pair(t, 8, 17, "v2.9 Raw A", str.tostring(diagV29RawA), color.white)
    f_pair(t, 8, 18, "ATR dead-zone veto", str.tostring(diagV29ATRBlocked), diagV29ATRBlocked > 0 ? color.orange : color.white)
    f_pair(t, 8, 19, "ATR rescued v2.10", str.tostring(diagV210ATRRescued), diagV210ATRRescued > 0 ? color.aqua : color.white)
    f_pair(t, 8, 20, "High-eff veto", str.tostring(diagV29EffBlocked), diagV29EffBlocked > 0 ? color.orange : color.white)
    f_pair(t, 8, 21, "Tiny-body veto", str.tostring(diagV29BodyBlocked), diagV29BodyBlocked > 0 ? color.orange : color.white)
    f_pair(t, 8, 22, "v2.10 Accepted A", str.tostring(diagV29AcceptedA), color.aqua)

