selectiveRunnerMinADX = input.float(23.0, "Selective Runner Min ADX", minval = 10.0, maxval = 50.0, step = 0.5, group = groupTrade)
selectiveRunnerMinLead = input.float(70.0, "Selective Runner Min Development", minval = 50.0, maxval = 90.0, step = 1.0, group = groupTrade)

useFailureCut = input.bool(false, "Use Selective Failure Cut (diagnostic; no effect in v2.12)", group = groupTrade)
failureCutGraceMinutes = input.int(5, "Failure Cut Grace Minutes", minval = 0, maxval = 20, group = groupTrade)
failureCutMaxMinutes = input.int(20, "Failure Cut Max Age Minutes", minval = 5, maxval = 45, group = groupTrade)
failureCutMinAdverseATR = input.float(0.18, "Failure Cut Minimum Adverse Close ATR", minval = 0.08, maxval = 0.50, step = 0.01, group = groupTrade)
failureCutMaxMFEATR = input.float(0.22, "Failure Cut Max MFE ATR", minval = 0.05, maxval = 0.50, step = 0.01, group = groupTrade)
failureCutMinVotes = input.int(4, "Failure Cut Evidence Votes", minval = 3, maxval = 7, group = groupTrade)
failureCutLeadEdge = input.float(8.0, "Failure Cut Opposing Lead Edge", minval = 0.0, maxval = 25.0, step = 1.0, group = groupTrade)

groupV215 = "6C. v2.15 Robust History Veto"
v215BlockFridayShortBreakout = input.bool(true, "Block Friday PUT Breakouts", group = groupV215)
v215BlockWednesdayOR1112 = input.bool(true, "Block Wednesday Opening Breakouts 11:00-12:00 ET", group = groupV215)

groupV217 = "6D. v2.17 Regime Router"
v217UseRouter = input.bool(true, "Enable Regime Router", group = groupV217)
v217BlockLowVolLongFlow = input.bool(true, "Block Low-Vol Long Partial-Flow Trap", group = groupV217)
v217BlockLowVolFlatGapBreakout = input.bool(true, "Block Low-Vol Flat-Gap Breakout", group = groupV217)
v217BlockRangeHighVolAdverseGap = input.bool(true, "Block Range + High-Vol Adverse-Gap Trap", group = groupV217)
v217BlockAlignedLowVolAdverseGapBreakout = input.bool(true, "Block Aligned Low-Vol Adverse-Gap Breakout", group = groupV217)

groupDay = "7. Stop Trading For Today"
exhaustPersistMinutes = input.int(10, "Exhaustion Persistence Minutes", minval = 2, maxval = 45, group = groupDay)
exhaustNeeded         = input.int(4, "Exhaustion Conditions Required", minval = 2, maxval = 7, group = groupDay)
dayRangeATRConsumed   = input.float(0.85, "Daily ATR Consumed", minval = 0.40, maxval = 1.50, step = 0.05, group = groupDay)
lateTrendEfficiency   = input.float(0.32, "Late Trend Exception Efficiency", minval = 0.10, maxval = 0.80, step = 0.01, group = groupDay)

groupDisplay = "8. Display"
showEMAs      = input.bool(false, "Show EMAs", group = groupDisplay)
showVWAP      = input.bool(false, "Show VWAP", group = groupDisplay)
showOR        = input.bool(false, "Show Opening Range", group = groupDisplay)
showPD        = input.bool(false, "Show Prior Day High / Low", group = groupDisplay)
showTradeLines = input.bool(true, "Show Entry / Target / Active SL / Hard SL Lines", group = groupDisplay)
showTable     = input.bool(true, "Show Full Diagnostics Grid", group = groupDisplay)
showLabels    = input.bool(true, "Show Entry / Exit / Stop-Day Labels", group = groupDisplay)

groupDiagnostics = "9. Deep Diagnostics"
var int diagColOffset = 0
var int diagRowOffset = 0

f_safeDiv(float num, float den, float fallback) =>
    math.abs(den) > 0.0000001 ? num / den : fallback

f_contextCount(bool a, bool b, bool c) =>
    (a ? 1 : 0) + (b ? 1 : 0) + (c ? 1 : 0)

f_diagPF(float gp, float gl) =>
    gl > 0 ? gp / gl : gp > 0 ? 99.0 : na

f_diagLine(int trades, int wins, float gp, float gl) =>
    float wr = trades > 0 ? wins * 100.0 / trades : na
    float pf = f_diagPF(gp, gl)
    trades > 0 ? str.tostring(trades) + "T | " + str.tostring(wr, "#.0") + "% | PF " + (na(pf) ? "-" : str.tostring(pf, "#.##")) : "-"

f_diagColor(int trades, int wins, float gp, float gl) =>
    float wr = trades > 0 ? wins * 100.0 / trades : na
    float pf = f_diagPF(gp, gl)
    trades == 0 ? color.gray : not na(pf) and pf >= 1.25 and wr >= 55 ? color.lime : not na(pf) and pf < 1.0 ? color.orange : color.white

f_diagAdd(array<int> t, array<int> w, array<float> gp, array<float> gl, int idx, bool won, float cashWin, float cashLoss) =>
    if idx >= 0 and idx < array.size(t)
        array.set(t, idx, array.get(t, idx) + 1)
        array.set(w, idx, array.get(w, idx) + (won ? 1 : 0))
        array.set(gp, idx, array.get(gp, idx) + cashWin)
        array.set(gl, idx, array.get(gl, idx) + cashLoss)

f_diagArrLine(array<int> t, array<int> w, array<float> gp, array<float> gl, int idx) =>
    idx >= 0 and idx < array.size(t) ? f_diagLine(array.get(t, idx), array.get(w, idx), array.get(gp, idx), array.get(gl, idx)) : "-"

f_diagArrColor(array<int> t, array<int> w, array<float> gp, array<float> gl, int idx) =>
    idx >= 0 and idx < array.size(t) ? f_diagColor(array.get(t, idx), array.get(w, idx), array.get(gp, idx), array.get(gl, idx)) : color.gray

f_setupIndex(string setupName) =>
    setupName == "OPENING BREAKOUT" ? 0 :
     setupName == "BREAKOUT" ? 1 :
     setupName == "LIQUIDITY REVERSAL" ? 2 :
     setupName == "EMA PULLBACK" ? 3 :
     setupName == "VWAP RECLAIM" ? 4 :
     setupName == "EARLY CONTINUATION" ? 5 : -1

f_pair(table t, int c, int r, string label, string value, color valueColor) =>
    int cc = c + diagColOffset
    int rr = r + diagRowOffset
    table.cell(t, cc, rr, label, text_color = color.white, text_size = size.tiny)
    table.cell(t, cc + 1, rr, value, text_color = valueColor, text_size = size.tiny)

f_header(table t, int c, string title, string subtitle) =>
    int cc = c + diagColOffset
    int rr = diagRowOffset
    table.cell(t, cc, rr, title, text_color = color.aqua, bgcolor = color.new(color.gray, 75), text_size = size.tiny)
    table.cell(t, cc + 1, rr, subtitle, text_color = color.white, bgcolor = color.new(color.gray, 75), text_size = size.tiny)

inTradeSession = not na(time(timeframe.period, tradeSession, sessionTZ))
inStopEval     = not na(time(timeframe.period, stopEvalSession, sessionTZ))
inHardStop     = not na(time(timeframe.period, hardStopSession, sessionTZ))
inOpeningRange = not na(time(timeframe.period, openingRangeSess, sessionTZ))

bool isQQQChart = syminfo.ticker == "QQQ"
bool dayAllowed =
     (dayofweek == dayofweek.monday and tradeMonday) or
     (dayofweek == dayofweek.tuesday and tradeTuesday) or
     (dayofweek == dayofweek.wednesday and tradeWednesday) or
     (dayofweek == dayofweek.thursday and tradeThursday) or
     (dayofweek == dayofweek.friday and tradeFriday)

newTradeDay = inTradeSession and not inTradeSession[1]

var bool dayDone = false
var bool dayDoneEvent = false
var int exhaustionBars = 0
var float sessionHigh = na
var float sessionLow = na
var float sessionOpenPrice = na
var float openingClosePrice = na
var float openingHigh = na
var float openingLow = na
var int v24EntriesToday = 0
var float priorSessionHigh = na
var float priorSessionLow = na
var float priorSessionRange = na
var int lastExitBar = na

if newTradeDay
    if not na(sessionHigh) and not na(sessionLow)
        priorSessionHigh := sessionHigh
        priorSessionLow := sessionLow
        priorSessionRange := sessionHigh - sessionLow
    dayDone := false
    dayDoneEvent := false
    exhaustionBars := 0
    sessionHigh := high
    sessionLow := low
    sessionOpenPrice := open
    openingClosePrice := na
    openingHigh := na
    openingLow := na
    v24EntriesToday := 0

if inTradeSession
    sessionHigh := math.max(nz(sessionHigh, high), high)
    sessionLow := math.min(nz(sessionLow, low), low)

if inOpeningRange
    openingHigh := math.max(nz(openingHigh, high), high)
    openingLow := math.min(nz(openingLow, low), low)
    openingClosePrice := close

ema9  = ta.ema(close, emaFastLen)
ema21 = ta.ema(close, emaMidLen)
ema50 = ta.ema(close, emaSlowLen)
vwap  = ta.vwap(hlc3)
atr   = ta.atr(14)
atrAvg = ta.sma(atr, 50)
atrRatio = f_safeDiv(atr, atrAvg, 1.0)

volAvg = ta.sma(volume, rvolLen)
rvol = f_safeDiv(volume, volAvg, 1.0)

[plusDI, minusDI, adx] = ta.dmi(adxLen, adxSmooth)

barRange = math.max(high - low, syminfo.mintick)
body = math.abs(close - open)
bullDisplacement = close > open and body >= atr * bodyATRMin and close >= high - barRange * 0.25
bearDisplacement = close < open and body >= atr * bodyATRMin and close <= low + barRange * 0.25

footprint fp = request.footprint(fpTicks, fpVA)
bool fpAvailable = not na(fp)
float fpTotalVolume = na
float fpDelta = na
if fpAvailable
    fpTotalVolume := footprint.total_volume(fp)
    fpDelta := footprint.delta(fp)
float fpDeltaPct = fpAvailable and fpTotalVolume > 0 ? fpDelta / fpTotalVolume : 0.0
bool fpRequiredMissing = fpMode == "Required" and not fpAvailable
bool fpLongNotOpposed = fpMode == "Off" or (fpMode == "Use when available" and not fpAvailable) or (fpAvailable and fpDeltaPct >= -fpOpposingVeto)
bool fpShortNotOpposed = fpMode == "Off" or (fpMode == "Use when available" and not fpAvailable) or (fpAvailable and fpDeltaPct <= fpOpposingVeto)
bool fpStrongBuy = fpAvailable and fpDeltaPct >= fpStrongDelta
bool fpStrongSell = fpAvailable and fpDeltaPct <= -fpStrongDelta

pathPerBar = ta.sma(math.abs(close - close[1]), effLen)
pathDistance = pathPerBar * effLen
efficiency = f_safeDiv(math.abs(close - close[effLen]), pathDistance, 0.0)

[v217DClose, v217DPrevClose, v217DEma20, v217DEma20Prev, v217DEma50, v217DAtr14, v217DAtr50] = request.security(
     syminfo.tickerid,
     "D",
     [close, close[1], ta.ema(close, 20), ta.ema(close, 20)[1], ta.ema(close, 50), ta.atr(14), ta.sma(ta.atr(14), 50)],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

float v217DailyVolRatio = f_safeDiv(v217DAtr14, v217DAtr50, 1.0)
float v217GapATR = not na(sessionOpenPrice) ? f_safeDiv(sessionOpenPrice - v217DClose, v217DAtr14, 0.0) : 0.0

bool v217DailyBull =
     v217DClose > v217DEma20 and v217DEma20 > v217DEma50 and v217DEma20 >= v217DEma20Prev
bool v217DailyBear =
     v217DClose < v217DEma20 and v217DEma20 < v217DEma50 and v217DEma20 <= v217DEma20Prev

vwapCrossSeries = ta.cross(close, vwap) ? 1.0 : 0.0
vwapCrosses = ta.sma(vwapCrossSeries, chopCrossLookback) * chopCrossLookback
emaSpreadATR = f_safeDiv(math.abs(ema9 - ema21), atr, 0.0)

chopCondition =
     (efficiency <= chopEfficiency and vwapCrosses >= chopCrossThreshold) or
     (adx < minEntryADX and emaSpreadATR < 0.10)

recentHigh = ta.highest(high[1], structureLen)
recentLow  = ta.lowest(low[1], structureLen)

breakoutLong = not na(recentHigh) and close > recentHigh and bullDisplacement
breakoutShort = not na(recentLow) and close < recentLow and bearDisplacement

pullbackLong =
     ema9 > ema21 and ema21 > ema50 and
     low <= ema21 + atr * pullbackToleranceATR and
     close > ema9 and close > open

pullbackShort =
     ema9 < ema21 and ema21 < ema50 and
     high >= ema21 - atr * pullbackToleranceATR and
     close < ema9 and close < open

vwapReclaimLong = allowVWAPReclaim and ta.crossover(close, vwap) and ema9 >= ema21 and plusDI > minusDI
vwapReclaimShort = allowVWAPReclaim and ta.crossunder(close, vwap) and ema9 <= ema21 and minusDI > plusDI

liquiditySweepLong =
     allowLiquiditySweep and not na(recentLow) and
     low < recentLow and close > recentLow and close > open

liquiditySweepShort =
     allowLiquiditySweep and not na(recentHigh) and
     high > recentHigh and close < recentHigh and close < open

orBreakLong =
     allowOpeningBreakout and not inOpeningRange and not na(openingHigh) and
     close > openingHigh and close[1] <= openingHigh and bullDisplacement

orBreakShort =
     allowOpeningBreakout and not inOpeningRange and not na(openingLow) and
     close < openingLow and close[1] >= openingLow and bearDisplacement

longTrigger = breakoutLong or pullbackLong or vwapReclaimLong or liquiditySweepLong or orBreakLong
shortTrigger = breakoutShort or pullbackShort or vwapReclaimShort or liquiditySweepShort or orBreakShort

string longSetupType =
     orBreakLong ? "OPENING BREAKOUT" :
     breakoutLong ? "BREAKOUT" :
     liquiditySweepLong ? "LIQUIDITY REVERSAL" :
     pullbackLong ? "EMA PULLBACK" :
     vwapReclaimLong ? "VWAP RECLAIM" : "LONG"

string shortSetupType =
     orBreakShort ? "OPENING BREAKOUT" :
     breakoutShort ? "BREAKOUT" :
     liquiditySweepShort ? "LIQUIDITY REVERSAL" :
     pullbackShort ? "EMA PULLBACK" :
     vwapReclaimShort ? "VWAP RECLAIM" : "SHORT"

spyRet = request.security(spySymbol, timeframe.period, close / close[crossBars] - 1.0)
qqqRet = request.security(qqqSymbol, timeframe.period, close / close[crossBars] - 1.0)
iwmRet = request.security(iwmSymbol, timeframe.period, close / close[crossBars] - 1.0)

crossThreshold = crossMovePct / 100.0

crossBullCount =
     (spyRet > crossThreshold ? 1 : 0) +
     (qqqRet > crossThreshold ? 1 : 0) +
     (iwmRet > crossThreshold ? 1 : 0)

crossBearCount =
     (spyRet < -crossThreshold ? 1 : 0) +
     (qqqRet < -crossThreshold ? 1 : 0) +
     (iwmRet < -crossThreshold ? 1 : 0)

crossLongNotOpposed = not useCrossMarket or crossBearCount < 2
crossShortNotOpposed = not useCrossMarket or crossBullCount < 2
crossStrongLong = not useCrossMarket or crossBullCount >= 2
crossStrongShort = not useCrossMarket or crossBearCount >= 2
crossMixed = useCrossMarket and crossBullCount < 2 and crossBearCount < 2

pdh = priorSessionHigh
pdl = priorSessionLow
priorDailyATR = priorSessionRange

sessionRange = not na(sessionHigh) and not na(sessionLow) ? sessionHigh - sessionLow : 0.0
rangeConsumed = not na(priorDailyATR) and priorDailyATR > 0 and sessionRange >= priorDailyATR * dayRangeATRConsumed

longTrendContext = ema9 > ema21 and ema21 >= ema50
shortTrendContext = ema9 < ema21 and ema21 <= ema50

longVWAPContext = close > vwap
shortVWAPContext = close < vwap

longForceContext = plusDI > minusDI
shortForceContext = minusDI > plusDI

longContextCount = f_contextCount(longTrendContext, longVWAPContext, longForceContext)
shortContextCount = f_contextCount(shortTrendContext, shortVWAPContext, shortForceContext)

longContextOK = longContextCount >= 2
shortContextOK = shortContextCount >= 2

strongLongTrend =
     longTrendContext and longVWAPContext and plusDI > minusDI and
     adx >= strongTrendADX and efficiency >= minEntryEfficiency

strongShortTrend =
     shortTrendContext and shortVWAPContext and minusDI > plusDI and
     adx >= strongTrendADX and efficiency >= minEntryEfficiency

pressureContinuationLong =
     allowPressureContinuation and
     strongLongTrend and
     bullDisplacement and
     ema9 > ema9[1] and ema21 >= ema21[1] and
     not na(recentHigh) and
     close <= recentHigh and
     close >= recentHigh - atr * pressureNearBreakATR

pressureContinuationShort =
     allowPressureContinuation and
     strongShortTrend and
     bearDisplacement and
     ema9 < ema9[1] and ema21 <= ema21[1] and
     not na(recentLow) and
     close >= recentLow and
     close <= recentLow + atr * pressureNearBreakATR

longSweepTransition =
     close > ema9 and ema9 > ema9[1] and plusDI > minusDI and
     (close > vwap or close > ema21)

shortSweepTransition =
     close < ema9 and ema9 < ema9[1] and minusDI > plusDI and
     (close < vwap or close < ema21)

longSweepAllowed =
     not liquiditySweepLong or
     not requireTransitionForCounterSweep or
     not strongShortTrend or
     longSweepTransition

shortSweepAllowed =
     not liquiditySweepShort or
     not requireTransitionForCounterSweep or
     not strongLongTrend or
     shortSweepTransition

movementQualityOK = atrRatio >= minATRRatio
efficiencyOK = efficiency >= minEntryEfficiency
momentumBypassLong = bullDisplacement and (breakoutLong or orBreakLong) and adx >= minEntryADX
momentumBypassShort = bearDisplacement and (breakoutShort or orBreakShort) and adx >= minEntryADX

entryQualityLong =
     movementQualityOK and
     adx >= minEntryADX and
     crossLongNotOpposed and
     (efficiencyOK or momentumBypassLong) and
     (not chopCondition or momentumBypassLong)

entryQualityShort =
     movementQualityOK and
     adx >= minEntryADX and
     crossShortNotOpposed and
     (efficiencyOK or momentumBypassShort) and
     (not chopCondition or momentumBypassShort)

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
upperWickFraction = barRange > 0 ? upperWick / barRange : 0.0
lowerWickFraction = barRange > 0 ? lowerWick / barRange : 0.0

bullishRejection =
     lowerWickFraction >= reversalWickFraction and
     close > open and
     close >= low + barRange * 0.55

bearishRejection =
     upperWickFraction >= reversalWickFraction and
     close < open and
     close <= high - barRange * 0.55

overextendedBull = close > ema21 and atr > 0 and (close - ema21) / atr >= reversalStretchATR
overextendedBear = close < ema21 and atr > 0 and (ema21 - close) / atr >= reversalStretchATR

bullReversalRisk =
     overextendedBull and
     (bearishRejection or close < ema9 or (rvol >= 1.80 and (close < open or fpStrongSell)))

bearReversalRisk =
     overextendedBear and
     (bullishRejection or close > ema9 or (rvol >= 1.80 and (close > open or fpStrongBuy)))

float longLeadScore = 0.0
longLeadScore += longTrendContext ? 18.0 : 0.0
longLeadScore += ema9 > ema9[1] and ema21 >= ema21[1] ? 8.0 : 0.0
longLeadScore += close > ema21 ? 7.0 : 0.0
longLeadScore += close > vwap ? 8.0 : 0.0
longLeadScore += plusDI > minusDI ? 9.0 : 0.0
longLeadScore += adx >= minEntryADX ? 6.0 : 0.0
longLeadScore += adx > adx[1] ? 4.0 : 0.0
longLeadScore += efficiency >= minEntryEfficiency ? 6.0 : 0.0
longLeadScore += rvol >= 1.0 ? 5.0 : 0.0
longLeadScore += (breakoutLong or orBreakLong or pressureContinuationLong) ? 10.0 : 0.0
longLeadScore += (pullbackLong or vwapReclaimLong or liquiditySweepLong) ? 8.0 : 0.0
longLeadScore += bullDisplacement ? 7.0 : 0.0
longLeadScore += useCrossMarket and crossBullCount >= 2 ? 5.0 : 0.0
longLeadScore += fpStrongBuy ? 5.0 : 0.0
longLeadScore -= chopCondition ? 18.0 : 0.0
longLeadScore -= overextendedBull ? 10.0 : 0.0
longLeadScore -= bullReversalRisk ? 22.0 : 0.0
longLeadScore := math.max(0.0, math.min(100.0, longLeadScore))

float shortLeadScore = 0.0
shortLeadScore += shortTrendContext ? 18.0 : 0.0
shortLeadScore += ema9 < ema9[1] and ema21 <= ema21[1] ? 8.0 : 0.0
shortLeadScore += close < ema21 ? 7.0 : 0.0
shortLeadScore += close < vwap ? 8.0 : 0.0
shortLeadScore += minusDI > plusDI ? 9.0 : 0.0
shortLeadScore += adx >= minEntryADX ? 6.0 : 0.0
shortLeadScore += adx > adx[1] ? 4.0 : 0.0
shortLeadScore += efficiency >= minEntryEfficiency ? 6.0 : 0.0
shortLeadScore += rvol >= 1.0 ? 5.0 : 0.0
shortLeadScore += (breakoutShort or orBreakShort or pressureContinuationShort) ? 10.0 : 0.0
shortLeadScore += (pullbackShort or vwapReclaimShort or liquiditySweepShort) ? 8.0 : 0.0
shortLeadScore += bearDisplacement ? 7.0 : 0.0
shortLeadScore += useCrossMarket and crossBearCount >= 2 ? 5.0 : 0.0
shortLeadScore += fpStrongSell ? 5.0 : 0.0
shortLeadScore -= chopCondition ? 18.0 : 0.0
shortLeadScore -= overextendedBear ? 10.0 : 0.0
shortLeadScore -= bearReversalRisk ? 22.0 : 0.0
shortLeadScore := math.max(0.0, math.min(100.0, shortLeadScore))

bool longLeadOK = not useLeadGate or (longLeadScore >= leadMinScore and longLeadScore >= shortLeadScore + leadMinEdge)
bool shortLeadOK = not useLeadGate or (shortLeadScore >= leadMinScore and shortLeadScore >= longLeadScore + leadMinEdge)

weakADXLate = adx < 16.0
weakEfficiencyLate = efficiency < chopEfficiency
weakRVOLLate = rvol < 0.78
weakATRRegimeLate = atrRatio < 0.82
compressedLate = chopCondition
mixedMarketsLate = crossMixed

exhaustionCount =
     (weakADXLate ? 1 : 0) +
     (weakEfficiencyLate ? 1 : 0) +
     (weakRVOLLate ? 1 : 0) +
     (weakATRRegimeLate ? 1 : 0) +
     (compressedLate ? 1 : 0) +
     (mixedMarketsLate ? 1 : 0) +
     (rangeConsumed ? 1 : 0)

lateTrendException =
     ((strongLongTrend and crossLongNotOpposed) or (strongShortTrend and crossShortNotOpposed)) and
     efficiency >= lateTrendEfficiency and
     atrRatio >= 0.90

rawSessionExhausted = inStopEval and exhaustionCount >= exhaustNeeded and not lateTrendException

chartMinutes = timeframe.in_seconds() / 60.0
exhaustPersistBars = int(math.max(2.0, math.ceil(exhaustPersistMinutes / chartMinutes)))

if rawSessionExhausted
    exhaustionBars += 1
else
    exhaustionBars := 0

sessionExhaustedPersistent = exhaustionBars >= exhaustPersistBars

varip int tradeDirection = 0       // 1 CALL direction, -1 PUT direction
varip int entryTime = na
varip int entryBar = na
varip float entryPrice = na
varip float entryATR = na
varip float stopPrice = na
varip float hardStopPrice = na
varip float targetPrice = na
varip float originalTarget = na
varip float entryLeadScore = na
varip float tradeMFE = 0.0
varip float tradeMAE = 0.0
varip float expectedMinutes = na
varip bool targetExtended = false
varip bool closingRequested = false
varip string activeSetup = ""
varip string activeEntryTier = ""
varip string pendingExitReason = ""
varip int lastMFEBar = na
varip bool runnerActivated = false
varip bool selectiveRunnerTrade = false

var int reentryBlockedDirection = 0
var int reentryBlockBar = na

var int researchTrades = 0
var int researchDirHits = 0
var int dirHitWins = 0
var int researchWinners = 0
var float totalDurationMinutes = 0.0
var float totalCapturePct = 0.0
var float winnerCapturePctTotal = 0.0
var float dirHitGivebackPctTotal = 0.0
var int ambiguousSameBarTrades = 0
var int cleanTrades = 0
var int cleanWins = 0
var int dirHitLosses = 0
var int openingChaseBlocks = 0
var int openingChaseCallBlocks = 0
var int openingChasePutBlocks = 0
var int putEMABlocks = 0
var int earlyPutBreakoutBlocks = 0
var int firstHourClimaxCallBlocks = 0
var int firstHourClimaxPutBlocks = 0

var int diagCallTrades = 0
var int diagCallWins = 0
var float diagCallGP = 0.0
var float diagCallGL = 0.0
var int diagPutTrades = 0
var int diagPutWins = 0
var float diagPutGP = 0.0
var float diagPutGL = 0.0

var int diagORTrades = 0
var int diagORWins = 0
var float diagORGP = 0.0
var float diagORGL = 0.0
var int diagBOTrades = 0
var int diagBOWins = 0
var float diagBOGP = 0.0
var float diagBOGL = 0.0
var int diagLiqTrades = 0
var int diagLiqWins = 0
var float diagLiqGP = 0.0
var float diagLiqGL = 0.0
var int diagEMATrades = 0
var int diagEMAWins = 0
var float diagEMAGP = 0.0
var float diagEMAGL = 0.0
var int diagVWAPTrades = 0
var int diagVWAPWins = 0
var float diagVWAPGP = 0.0
var float diagVWAPGL = 0.0
var int diagEarlyTrades = 0
var int diagEarlyWins = 0
var float diagEarlyGP = 0.0
var float diagEarlyGL = 0.0

varip float diagEntryADX = na
varip float diagEntryEfficiency = na
varip float diagEntryRVOL = na
varip float diagEntryATRRatio = na
varip float diagEntryLead = na
varip float diagEntryLeadEdge = na
varip float diagEntryExt9ATR = na
varip float diagEntryVWAPDistATR = na
