storyOpposingControl := storyLong ? shortControlNow : storyShort ? longControlNow : false
storyCurrentHardFailure := storyLong ? longHardFailureNow : storyShort ? shortHardFailureNow : false
storyAnchorOwned := storyLong ? (na(storyAnchor) or close >= storyAnchor - atr * 0.12) :
