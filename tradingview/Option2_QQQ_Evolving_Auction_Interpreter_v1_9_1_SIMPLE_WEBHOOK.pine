string G_QUICK = "4. QQQ options move-rider layer"
float moveMilestonePts = input.float(1.00, "Meaningful QQQ move milestone · points", 0.50, 3.00, step=0.10, group=G_QUICK,
     tooltip="Research/state milestone only. Reaching this price movement does NOT sell the trade.")
float moveMinClearRoomPts = input.float(1.00, "Preferred clear route before ARM · points", 0.25, 3.00, step=0.10, group=G_QUICK,
     tooltip="If a meaningful opposing Option1 zone sits closer than this, Option2 normally waits unless the auction is already proving a strong same-side expansion through structure.")
float moveMinEfficiency = input.float(0.28, "Minimum directional efficiency for continuation", 0.10, 0.60, step=0.02, group=G_QUICK)
float moveMinResult = input.float(0.14, "Minimum same-side result proof", 0.05, 0.50, step=0.01, group=G_QUICK)
float moveMinParticipation = input.float(0.85, "Minimum same-time participation", 0.40, 1.50, step=0.05, group=G_QUICK,
     tooltip="Uses Option1 same-weekday/same-time relative volume when available; otherwise falls back to local relative volume.")
float moveMinRangePace = input.float(0.80, "Minimum same-time range pace", 0.40, 1.50, step=0.05, group=G_QUICK,
     tooltip="Options entries still require a market that is actually moving for that time of day, but the trade itself has no fixed bar limit.")
bool enableMoveExhaustionSell = input.bool(true, "SELL when directional move degrades into opposing balance/control", group=G_QUICK,
     tooltip="No fixed timer. SELL requires market-behavior evidence: loss of same-side territory/result plus balance/chop or opposing sponsorship/counterattack.")
string G_LIFE = "5. Move life / Auction Story / AMD"
float fpStrongDeltaPct = input.float(0.10, "Brain · strong footprint delta fraction", 0.03, 0.40, step=0.01, group=G_LIFE)
int fpStackMin = input.int(2, "Brain · stacked imbalance rows", 1, 6, group=G_LIFE)
int storyQuietBars = input.int(4, "Story · bars without evidence before reset", 2, 10, group=G_LIFE)
float storyEarlyAtr = input.float(0.85, "Story · EARLY distance from cause (ATR)", 0.35, 1.50, step=0.05, group=G_LIFE)
float storyMatureAtr = input.float(1.90, "Story · MATURE distance from cause (ATR)", 1.00, 3.50, step=0.05, group=G_LIFE)
float storyExhaustedAtr = input.float(3.10, "Story · EXHAUSTED distance from cause (ATR)", 1.75, 5.00, step=0.05, group=G_LIFE)
float storyMinCapacityPts = input.float(0.90, "Story · reference remaining route (QQQ points)", 0.40, 2.50, step=0.05, group=G_LIFE)
float payoffQuestionR = input.float(1.00, "Payoff question · desired causal R", 0.50, 2.00, step=0.05, group=G_LIFE,
     tooltip="Uses the evolving story's causal invalidation, not the broad emergency stop. This is a prospective opportunity question, not a fixed take-profit.")
float payoffMinMovePts = input.float(0.75, "Payoff question · minimum useful QQQ move", 0.25, 2.00, step=0.05, group=G_LIFE,
     tooltip="Even when causal risk is tiny, an options entry should still have enough expected underlying displacement to matter.")
float payoffInvalidBufferAtr = input.float(0.08, "Payoff question · causal invalidation buffer (ATR)", 0.02, 0.20, step=0.01, group=G_LIFE,
     tooltip="Small buffer outside the story anchor or the most recent survived counterattack. It defines the question's causal risk; it does not replace the emergency structural stop.")
int flowProofWindowBars = input.int(2, "Flow proof · max bars after base thesis is ready", 1, 4, group=G_LIFE)
float flowMinDeltaFrac = input.float(0.03, "Flow proof · minimum meaningful delta fraction", 0.00, 0.15, step=0.01, group=G_LIFE)
bool enableFlowExecutionStop = input.bool(true, "Use local flow-proof invalidation while trade is unproven", group=G_LIFE,
     tooltip="Before the move proves itself, the entry timing is invalid if price breaks the local structure that created the accepted footprint proof. The broader thesis stop remains the emergency backstop.")
bool enableDirectionalEpisodeMemory = input.bool(true, "v1.9.1 remember consumed directional episodes", group=G_LIFE,
     tooltip="A same-side trade is not fresh merely because the local story reset. Freshness now requires a real balance/discovery reset or a meaningful challenge/reclaim; a new price location by itself is not enough.")
bool enableResponsiveInitiativeReasoning = input.bool(true, "v1.9.1 defense must convert to initiative before DIRECT", group=G_LIFE,
     tooltip="DEFENSE means the thesis survived, not that the defended side has initiated a new move. DIRECT participation from a defense story requires current initiative evidence such as acceptance/discovery or footprint initiative/drive.")
bool enableUnknownFlowAwareness = input.bool(true, "v1.9.1 missing footprint = UNKNOWN for DIRECT", group=G_LIFE,
     tooltip="When footprint data is unavailable, DIRECT entries are not allowed to pretend flow is confirmed. Meaningful RE-ACCEL remains eligible because its challenge/reclaim proof is structural. This is evidence-awareness, not a date filter.")
int amdAccumBars = input.int(3, "AMD · minimum accumulation bars", 2, 10, group=G_LIFE)
float amdMaxBalanceAtr = input.float(2.20, "AMD · maximum balance width in ATR", 0.75, 5.00, step=0.10, group=G_LIFE)
int amdManipConfirmBars = input.int(5, "AMD · manipulation must resolve within bars", 2, 12, group=G_LIFE)
int amdDistributionMaxBars = input.int(30, "AMD · max distribution memory bars", 8, 60, group=G_LIFE)
float lifeProofPts = input.float(0.75, "Move life · meaningful proof points", 0.25, 1.50, step=0.05, group=G_LIFE)
float lifeRunnerPts = input.float(1.75, "Move life · runner/mature distance", 0.75, 4.00, step=0.05, group=G_LIFE)
float lifeMinBankPts = input.float(0.70, "Move life · minimum profit for reasoning bank", 0.25, 1.50, step=0.05, group=G_LIFE)
int lifeEarlyFailBars = input.int(3, "Move life · failure-to-launch observation bars", 1, 8, group=G_LIFE)
float lifeEarlyFailMaxMfePts = input.float(0.40, "Move life · max MFE for failure-to-launch", 0.15, 1.00, step=0.05, group=G_LIFE)
float lifeWideGivebackPts = input.float(1.20, "Move life · EXPANDING max giveback", 0.50, 2.50, step=0.05, group=G_LIFE)
float lifeHealthyGivebackPts = input.float(0.80, "Move life · HEALTHY max giveback", 0.30, 2.00, step=0.05, group=G_LIFE)
float lifeMatureGivebackPts = input.float(0.55, "Move life · MATURE max giveback", 0.20, 1.50, step=0.05, group=G_LIFE)
float lifeMinLockedPts = input.float(0.35, "Move life · minimum positive floor once proven", 0.05, 1.00, step=0.05, group=G_LIFE)
int reentryWatchBars = input.int(12, "ENTER AGAIN watch window · bars", 4, 30, group=G_LIFE)
float reentryTargetPts = input.float(1.00, "ENTER AGAIN hard objective · QQQ points", 0.50, 2.00, step=0.10, group=G_LIFE)
float reentryMinClearRoomPts = input.float(1.25, "ENTER AGAIN minimum clear route · QQQ points", 1.00, 4.00, step=0.10, group=G_LIFE)
float reentryMaxRiskPts = input.float(1.00, "ENTER AGAIN maximum structural risk · QQQ points", 0.30, 2.00, step=0.10, group=G_LIFE)
bool enableDailyShield = input.bool(false, "Enable legacy daily execution shield", group=G_QUICK,
     tooltip="Off by default for options research. Turn on only if you intentionally want the futures prop-style daily lockout behavior.")
string TRADE_TZ = "America/Los_Angeles"
string NO_TRADE_SESSION = "0000-0400:1234567"
string PRE_RTH_TRANSITION = "0615-0630:1234567"
string PRE_CLOSE_TRANSITION = "1245-1300:1234567"
string LATE_RTH_RUNWAY = "1200-1245:1234567"
string PROP_EXECUTION_SESSION = "0630-1300:1234567"
string G_UI = "6. Display"
bool showSignals = input.bool(true, "Show ARM / ENTER / EXIT markers", group=G_UI)
bool showTradeGeometry = input.bool(true, "Show active ARM geometry", group=G_UI)
