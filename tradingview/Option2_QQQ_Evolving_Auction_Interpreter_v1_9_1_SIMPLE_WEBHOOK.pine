//@version=6
//@strategy_alert_message {{strategy.order.alert_message}} | TV_ORDER_ID {{strategy.order.id}} | TV_FILL {{strategy.order.price}}
strategy("Option2 — QQQ Evolving Auction Interpreter v1.9.1 GLOBAL RENEWAL CLEAN", overlay=true,
     pyramiding=0, initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.0,
     slippage=0, calc_on_every_tick=false, calc_on_order_fills=false,
     process_orders_on_close=false, use_bar_magnifier=true,
     max_labels_count=500, max_lines_count=80)
string G_BUS = "1. Option1 Bus — connect matching plots"
float busHeader = input.source(close, "BUS 1 — Map Header", group=G_BUS)
float busR1 = input.source(close, "BUS 2 — Resistance 1 Center", group=G_BUS)
float busR1Meta = input.source(close, "BUS 3 — Resistance 1 Meta", group=G_BUS)
float busR2 = input.source(close, "BUS 4 — Resistance 2", group=G_BUS)
float busS1 = input.source(close, "BUS 5 — Support 1 Center", group=G_BUS)
float busS1Meta = input.source(close, "BUS 6 — Support 1 Meta", group=G_BUS)
float busS2 = input.source(close, "BUS 7 — Support 2", group=G_BUS)
float busBalHi = input.source(close, "BUS 8 — Current Balance High", group=G_BUS)
float busBalLo = input.source(close, "BUS 9 — Current Balance Low", group=G_BUS)
float busContext = input.source(close, "BUS 10 — Auction Context v3", group=G_BUS,
     tooltip="Connect to Option1 BUS 10 — Auction Context v3. Telemetry only.")
float busClock = input.source(close, "BUS 11 — Market Clock + Cross-Market", group=G_BUS,
     tooltip="Connect to Option1 BUS 11 — Market Clock + Cross-Market. Telemetry only; v0.8 trade decisions remain frozen.")
float busFpEyes = input.source(close, "BUS 12 — Footprint Eyes Context", group=G_BUS)
float busFpPoc = input.source(close, "BUS 13 — Footprint POC", group=G_BUS)
float busFpValue = input.source(close, "BUS 14 — Footprint Value Mid", group=G_BUS)
float busRthVwap = input.source(close, "BUS 15 — RTH VWAP", group=G_BUS)
string G_REASON = "2. Reasoning"
int atrLen = input.int(14, "ATR length", 5, 50, group=G_REASON)
int territoryLen = input.int(6, "Territory window", 3, 12, group=G_REASON)
int contextLen = input.int(12, "Context window", 6, 30, group=G_REASON)
int volLen = input.int(24, "Effort normalization", 10, 60, group=G_REASON)
float zoneNearAtr = input.float(0.45, "Zone interaction distance · ATR", 0.15, 1.20, step=0.05, group=G_REASON)
float territoryMinAtr = input.float(0.20, "Meaningful territory gain · ATR", 0.05, 0.60, step=0.05, group=G_REASON)
float efficientMove = input.float(0.30, "Directional efficiency reference", 0.15, 0.60, step=0.02, group=G_REASON)
float routeMinimumR = input.float(0.65, "Minimum usable route for ARM (R)", 0.25, 1.25, step=0.05, group=G_REASON)
int armTriggerFreshBars = input.int(1, "ARM trigger freshness · bars", 1, 2, group=G_REASON,
     tooltip="The thesis may persist, but one specific entry trigger is only valid for this many completed bars. Default 1 means: if it does not fill on the next bar, cancel that price and re-evaluate from current structure.")
float stopBufferAtr = input.float(0.06, "Structural stop buffer · ATR", 0.02, 0.20, step=0.01, group=G_REASON)
float shortMaturityRelVol = input.float(1.80, "Short move-maturity participation reference", 1.20, 3.00, step=0.05, group=G_REASON,
     tooltip="Experimental reasoning guard from the 365-day audit. A FAILED-UP short is considered mature when buyers are already weak, downside progress is established, and participation is extreme. The bearish thesis remains alive, but Option2 waits for a pullback plus fresh seller response before ARM.")
float shortParticipationMinRelVol = input.float(0.70, "Short minimum participation for ARM", 0.40, 1.20, step=0.05, group=G_REASON,
     tooltip="Full-history reasoning check: bearish theses may keep developing below this participation level, but Bot2 will not ARM a short until relative volume recovers. This rule is intentionally short-side only.")
bool enableCausalReset = input.bool(true, "Require fresh causal reset for contradicted FAILED-UP shorts", group=G_REASON,
     tooltip="A FAILED-UP short cannot ARM while a prior DOWN shock is only stabilizing or while Option1 says R1 is accepted above. Option2 waits for a genuinely NEW bearish event after the contradiction instead of reusing the old seller story.")
string G_STRAT = "3. Strategy / exits"
bool enableEarlyExit = input.bool(true, "Allow thesis-failure early exits", group=G_STRAT)
int minEarlyBars = input.int(2, "Minimum bars before early exit", 1, 8, group=G_STRAT)
bool enableProvenProtection = input.bool(true, "v0.7 PROVEN CONTROL TRANSFER", group=G_STRAT)
const float PROVEN_R = 0.50
const float PROTECT_GIVEBACK_R = 0.30
const float MEMORY_RECLAIM_FRAC = 0.75
