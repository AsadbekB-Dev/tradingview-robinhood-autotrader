float tick = syminfo.mintick
float atr = ta.atr(atrLen)
float stopBuf = math.max(tick * 2.0, atr * stopBufferAtr)
bool noTradeWindow = not na(time(timeframe.period, NO_TRADE_SESSION, TRADE_TZ))
bool preBlackoutBar = not noTradeWindow and hour(time_close, TRADE_TZ) == 0 and minute(time_close, TRADE_TZ) == 0
bool preRthTransition = not na(time(timeframe.period, PRE_RTH_TRANSITION, TRADE_TZ))
bool preCloseTransition = not na(time(timeframe.period, PRE_CLOSE_TRANSITION, TRADE_TZ))
bool preRthBoundaryBar = not preRthTransition and hour(time_close, TRADE_TZ) == 6 and minute(time_close, TRADE_TZ) == 15
bool preCloseBoundaryBar = not preCloseTransition and hour(time_close, TRADE_TZ) == 12 and minute(time_close, TRADE_TZ) == 45
bool sessionTransitionWindow = preRthTransition or preCloseTransition
bool sessionTransitionBoundary = preRthBoundaryBar or preCloseBoundaryBar
bool sessionEntryBlock = sessionTransitionWindow or sessionTransitionBoundary
bool lateRthRunway = not na(time(timeframe.period, LATE_RTH_RUNWAY, TRADE_TZ))
var float propDailyRealizedR = 0.0
var int propDailyStops = 0
var bool propShieldActive = false
var int propDayStamp = na
var int lastShieldClosedSeen = 0
bool propExecutionWindow = not na(time(timeframe.period, PROP_EXECUTION_SESSION, TRADE_TZ))
bool propExecutionEndBoundary =
     hour(time_close, TRADE_TZ) == 13 and minute(time_close, TRADE_TZ) == 0
bool entriesAllowedNow =
     propExecutionWindow and
     not propExecutionEndBoundary and
     not noTradeWindow and
     not preBlackoutBar and
     not sessionEntryBlock and
     not (enableDailyShield and propShieldActive)
f_metaInt(float meta) =>
    na(meta) ? 0 : int(math.floor(meta + 0.000001))
f_metaStrength(float meta) =>
    int(math.floor(f_metaInt(meta) / 1000000))
f_metaState(float meta) =>
    int(math.floor((f_metaInt(meta) % 1000000) / 10000))
f_metaWidthTicks(float meta) =>
    f_metaInt(meta) % 10000
f_metaSource(float meta) =>
    if na(meta)
        0
    else
        int(math.round((meta - math.floor(meta)) * 100.0))
f_metaValid(float meta) =>
    if na(meta)
        true
    else
        int stg = f_metaStrength(meta)
        int st = f_metaState(meta)
        int src = f_metaSource(meta)
        stg >= 1 and stg <= 20 and st >= 1 and st <= 6 and src >= 1 and src <= 9
int mapVersion = int(math.floor(busHeader))
int auctionCode = int(math.round((busHeader - math.floor(busHeader)) * 100.0))
bool headerValid = mapVersion >= 1 and auctionCode >= 1 and auctionCode <= 10
int ctxWork = int(math.round(busContext))
int weekdayCtx = ctxWork % 6
ctxWork := int(math.floor(ctxWork / 6))
int s1ReactionCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int r1ReactionCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int s1BattleCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int r1BattleCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int openingRangeCtx = ctxWork % 4
ctxWork := int(math.floor(ctxWork / 4))
int openingAuctionCtx = ctxWork % 8
ctxWork := int(math.floor(ctxWork / 8))
int gapCtx = ctxWork % 6
ctxWork := int(math.floor(ctxWork / 6))
int openLocationCtx = ctxWork % 6
ctxWork := int(math.floor(ctxWork / 6))
int shockExtremeAgeCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int shockRetraceCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int shockImpulseCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int shockAgeCtx = ctxWork % 10
ctxWork := int(math.floor(ctxWork / 10))
int shockEvidenceCtx = ctxWork % 8
ctxWork := int(math.floor(ctxWork / 8))
int shockDirCodeCtx = ctxWork % 3
ctxWork := int(math.floor(ctxWork / 3))
int shockStateCtx = ctxWork % 4
ctxWork := int(math.floor(ctxWork / 4))
int ctxPrefix = ctxWork
bool ctxValid = ctxPrefix == 8
int shockDirCtx = shockDirCodeCtx - 1
int clkWork = int(math.round(busClock))
int shockEpisodeCountCtx = clkWork % 10
clkWork := int(math.floor(clkWork / 10))
int vixMoveCtx = clkWork % 6
clkWork := int(math.floor(clkWork / 6))
int vixLevelCtx = clkWork % 4
clkWork := int(math.floor(clkWork / 4))
int esContextCtx = clkWork % 6
clkWork := int(math.floor(clkWork / 6))
int calendarCtx = clkWork % 3
clkWork := int(math.floor(clkWork / 3))
int rangePaceCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int volumePaceCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int timeEffCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int timeRangeCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int timeVolCodeCtx = clkWork % 32
clkWork := int(math.floor(clkWork / 32))
int clockReadyCodeCtx = clkWork % 2
clkWork := int(math.floor(clkWork / 2))
int rthSlotCtx = clkWork % 79
clkWork := int(math.floor(clkWork / 79))
int clockPrefix = clkWork
bool clockCtxValid = clockPrefix == 7
bool clockReadyCtx = clockCtxValid and clockReadyCodeCtx == 1
float timeRelVolCtx = float(timeVolCodeCtx) / 10.0
float timeRelRangeCtx = float(timeRangeCodeCtx) / 10.0
float timeRelEffCtx = float(timeEffCodeCtx) / 10.0
float volumePaceCtx = float(volumePaceCodeCtx) / 10.0
float rangePaceCtx = float(rangePaceCodeCtx) / 10.0
int fpEyeWork = int(math.round(busFpEyes))
int fpPocLocCode = fpEyeWork % 5
fpEyeWork := int(math.floor(fpEyeWork / 5))
int fpLowerDeltaSignCode = fpEyeWork % 3
fpEyeWork := int(math.floor(fpEyeWork / 3))
int fpUpperDeltaSignCode = fpEyeWork % 3
fpEyeWork := int(math.floor(fpEyeWork / 3))
int fpBuyerAbsFactCode = fpEyeWork % 2
fpEyeWork := int(math.floor(fpEyeWork / 2))
int fpSellerAbsFactCode = fpEyeWork % 2
fpEyeWork := int(math.floor(fpEyeWork / 2))
int fpSellImbCount = fpEyeWork % 8
fpEyeWork := int(math.floor(fpEyeWork / 8))
int fpBuyImbCount = fpEyeWork % 8
fpEyeWork := int(math.floor(fpEyeWork / 8))
int fpMaxSellStack = fpEyeWork % 8
fpEyeWork := int(math.floor(fpEyeWork / 8))
int fpMaxBuyStack = fpEyeWork % 8
fpEyeWork := int(math.floor(fpEyeWork / 8))
int fpValueMigCode = fpEyeWork % 3
fpEyeWork := int(math.floor(fpEyeWork / 3))
int fpPocMigCode = fpEyeWork % 3
fpEyeWork := int(math.floor(fpEyeWork / 3))
int fpDeltaCode = fpEyeWork % 21
fpEyeWork := int(math.floor(fpEyeWork / 21))
int fpHasCode = fpEyeWork % 2
fpEyeWork := int(math.floor(fpEyeWork / 2))
int fpEyePrefix = fpEyeWork
bool fpEyesValid = fpEyePrefix == 21
bool fpHas = fpEyesValid and fpHasCode == 1 and not na(busFpPoc) and not na(busFpValue)
float fpDeltaPct = fpHas ? float(fpDeltaCode - 10) * 0.05 : na
float fpPocMid = fpHas ? busFpPoc : na
float fpValueMid = fpHas ? busFpValue : na
float fpUpperDelta = fpUpperDeltaSignCode == 2 ? 1.0 : fpUpperDeltaSignCode == 0 ? -1.0 : 0.0
float fpLowerDelta = fpLowerDeltaSignCode == 2 ? 1.0 : fpLowerDeltaSignCode == 0 ? -1.0 : 0.0
bool fpSellerAbsorptionFact = fpHas and fpSellerAbsFactCode == 1
bool fpBuyerAbsorptionFact = fpHas and fpBuyerAbsFactCode == 1
bool busValid = headerValid and f_metaValid(busR1Meta) and f_metaValid(busS1Meta) and ctxValid and clockCtxValid and fpEyesValid
int rStrength = f_metaStrength(busR1Meta)
int rState = f_metaState(busR1Meta)
int rSource = f_metaSource(busR1Meta)
float rHalf = f_metaWidthTicks(busR1Meta) * tick
float rLo = na(busR1) or na(busR1Meta) ? na : busR1 - rHalf
float rHi = na(busR1) or na(busR1Meta) ? na : busR1 + rHalf
int sStrength = f_metaStrength(busS1Meta)
int sState = f_metaState(busS1Meta)
int sSource = f_metaSource(busS1Meta)
float sHalf = f_metaWidthTicks(busS1Meta) * tick
float sLo = na(busS1) or na(busS1Meta) ? na : busS1 - sHalf
float sHi = na(busS1) or na(busS1Meta) ? na : busS1 + sHalf
float ch = close - close[1]
float upStep = math.max(ch, 0.0)
float dnStep = math.max(-ch, 0.0)
float upTravel = math.sum(upStep, territoryLen)
float dnTravel = math.sum(dnStep, territoryLen)
float totalTravel = upTravel + dnTravel
float netMove = close - close[territoryLen]
float territoryEfficiency = totalTravel > tick ? math.abs(netMove) / totalTravel : 0.0
float buyerTravelShare = totalTravel > tick ? upTravel / totalTravel : 0.5
float contextHi = ta.highest(high, contextLen)
float contextLo = ta.lowest(low, contextLen)
float contextRange = math.max(contextHi - contextLo, tick)
float rangePosition = (close - contextLo) / contextRange
bool upTerritory = netMove >= atr * territoryMinAtr and buyerTravelShare >= 0.56
bool dnTerritory = netMove <= -atr * territoryMinAtr and buyerTravelShare <= 0.44
bool upHolding = not upTerritory and netMove >= 0 and rangePosition >= 0.62 and buyerTravelShare >= 0.51
bool dnHolding = not dnTerritory and netMove <= 0 and rangePosition <= 0.38 and buyerTravelShare <= 0.49
string territoryText = upTerritory ? "BUYERS GAINING" :
     dnTerritory ? "SELLERS GAINING" :
     upHolding ? "BUYERS HOLDING" :
     dnHolding ? "SELLERS HOLDING" : "CONTESTED"
float barRange = math.max(high - low, tick)
float closeLocation = ((close - low) - (high - close)) / barRange // -1..+1
float avgVol = ta.sma(volume, volLen)
float relVol = avgVol > 0 ? volume / avgVol : 1.0
bool shortParticipationReady = relVol >= shortParticipationMinRelVol
float signedEffort = closeLocation * relVol
float effort3 = ta.ema(signedEffort, 3)
float emaChange3 = ta.ema(close - close[1], 3)
float result3 = atr > tick ? emaChange3 / atr : 0.0
float highProgress3 = atr > tick ? math.max(high - high[3], 0.0) / atr : 0.0
float lowProgress3 = atr > tick ? math.max(low[3] - low, 0.0) / atr : 0.0
float buyerEffort = math.max(effort3, 0.0)
float sellerEffort = math.max(-effort3, 0.0)
float buyerResult = math.max(result3, 0.0) + highProgress3 * 0.35
float sellerResult = math.max(-result3, 0.0) + lowProgress3 * 0.35
bool buyerPoorResult = buyerEffort >= 0.45 and buyerResult < 0.14
bool sellerPoorResult = sellerEffort >= 0.45 and sellerResult < 0.14
bool buyerSponsored = buyerEffort >= 0.25 and buyerResult >= 0.18
bool sellerSponsored = sellerEffort >= 0.25 and sellerResult >= 0.18
float counterRatio = dnTravel > tick ? upTravel / dnTravel : upTravel > tick ? 10.0 : 1.0
bool sellerCounterWeak = counterRatio >= 1.55
bool buyerCounterWeak = counterRatio <= 0.645
string counterText = sellerCounterWeak ? "SELLER RESPONSE WEAK" :
     buyerCounterWeak ? "BUYER RESPONSE WEAK" : "TWO-WAY RESPONSE"
bool downsideAlreadyEstablished =
     dnTerritory or
     (sellerResult >= 0.40 and sellerEffort >= 0.30)
float nearDist = atr * zoneNearAtr
bool nearR = not na(busR1) and math.abs(close - busR1) <= nearDist
bool nearS = not na(busS1) and math.abs(close - busS1) <= nearDist
bool touchedR = not na(rLo) and high >= rLo and low <= rHi
bool touchedS = not na(sLo) and high >= sLo and low <= sHi
bool acceptedAboveR = not na(rHi) and close > rHi and close[1] > rHi
bool acceptedBelowS = not na(sLo) and close < sLo and close[1] < sLo
bool rejectedAtR = not na(rLo) and high >= rLo and close < rLo and close < open
bool rejectedAtS = not na(sHi) and low <= sHi and close > sHi and close > open
bool sweptRFailed = not na(rHi) and high > rHi and close < rLo
bool sweptSFailed = not na(sLo) and low < sLo and close > sHi
bool balanceBreakUp = not na(busBalHi) and close > busBalHi and close[1] <= busBalHi
bool balanceBreakDn = not na(busBalLo) and close < busBalLo and close[1] >= busBalLo
bool balanceReclaimUp = not na(busBalLo) and low < busBalLo and close > busBalLo
bool balanceReclaimDn = not na(busBalHi) and high > busBalHi and close < busBalHi
bool longDiscovery =
     auctionCode == AUC_EXP_UP and
     (upTerritory or upHolding) and
     not buyerPoorResult
bool longFailedDown =
     auctionCode == AUC_FAIL_DN or
     sweptSFailed or
     balanceReclaimUp
bool longSupportDefense =
     touchedS and
     (sState == Z_DEFENDED or sStrength >= 7) and
     (rejectedAtS or sellerPoorResult) and
     not dnTerritory
bool longAcceptance =
     acceptedAboveR and
     (buyerSponsored or upTerritory) and
     not sellerSponsored
bool shortDiscovery =
     auctionCode == AUC_EXP_DN and
     (dnTerritory or dnHolding) and
     not sellerPoorResult
bool shortFailedUp =
     auctionCode == AUC_FAIL_UP or
     sweptRFailed or
     balanceReclaimDn
bool shortResistanceDefense =
     touchedR and
     (rState == Z_DEFENDED or rStrength >= 7) and
     (rejectedAtR or buyerPoorResult) and
     not upTerritory
bool shortAcceptance =
     acceptedBelowS and
     (sellerSponsored or dnTerritory) and
     not buyerSponsored
bool shortMoveMatureNow =
     shortFailedUp and
     buyerCounterWeak and
     downsideAlreadyEstablished and
     relVol >= shortMaturityRelVol
bool longReversalUnprovenNow =
     longFailedDown and
     auctionCode == AUC_TRANSITION and
     dnTerritory
bool shortReversalUnprovenNow =
     shortFailedUp and
     auctionCode == AUC_TRANSITION and
     upTerritory
bool lateFailedDownLong = longFailedDown and lateRthRunway
bool lateLongRunwayProof =
     auctionCode == AUC_EXP_UP or
     longAcceptance or
     (upTerritory and buyerResult >= 0.40 and not buyerPoorResult)
bool longSessionRunwayReady =
     not lateFailedDownLong or
     lateLongRunwayProof
bool bullSupported = longDiscovery or longFailedDown or longSupportDefense or longAcceptance
bool bearSupported = shortDiscovery or shortFailedUp or shortResistanceDefense or shortAcceptance
bool bullDeveloping =
     bullSupported or
     auctionCode == AUC_TEST_UP or
     (nearS and not sellerSponsored) or
     (upHolding and not nearR) or
     (auctionCode == AUC_TRANSITION and upTerritory)
bool bearDeveloping =
     bearSupported or
     auctionCode == AUC_TEST_DN or
     (nearR and not buyerSponsored) or
     (dnHolding and not nearS) or
     (auctionCode == AUC_TRANSITION and dnTerritory)
bool bullContradicted =
     (acceptedBelowS and dnTerritory) or
     (auctionCode == AUC_EXP_DN and sellerSponsored and dnTerritory) or
     (nearR and sweptRFailed and bearSupported)
bool bearContradicted =
     (acceptedAboveR and upTerritory) or
     (auctionCode == AUC_EXP_UP and buyerSponsored and upTerritory) or
     (nearS and sweptSFailed and bullSupported)
string longReason =
     longFailedDown ? "FAILED DOWN / RECLAIM" :
     longAcceptance ? "BREAK + ACCEPTANCE" :
     longSupportDefense ? "SUPPORT DEFENSE" :
     longDiscovery ? "UPWARD DISCOVERY" :
     bullDeveloping ? "UP MOVE DEVELOPING" : "NONE"
string shortReason =
     shortFailedUp ? "FAILED UP / REJECTION" :
     shortAcceptance ? "BREAKDOWN + ACCEPTANCE" :
     shortResistanceDefense ? "RESISTANCE DEFENSE" :
     shortDiscovery ? "DOWNWARD DISCOVERY" :
     bearDeveloping ? "DOWN MOVE DEVELOPING" : "NONE"
string thesisText = bullSupported and not bearSupported ? "BULL EXPLANATION LEADING" :
     bearSupported and not bullSupported ? "BEAR EXPLANATION LEADING" :
     bullSupported and bearSupported ? "COMPETING EXPLANATIONS" :
     bullDeveloping and not bearDeveloping ? "BULL MOVE DEVELOPING" :
     bearDeveloping and not bullDeveloping ? "BEAR MOVE DEVELOPING" :
     bullDeveloping and bearDeveloping ? "BOTH SIDES ACTIVE" : "NO CLEAR ATTEMPT"
string opponentText =
     acceptedAboveR ? "SHORT THESIS UNDER PRESSURE" :
     sweptRFailed ? "BREAKOUT LONGS VULNERABLE" :
     acceptedBelowS ? "LONG THESIS UNDER PRESSURE" :
     sweptSFailed ? "BREAKDOWN SHORTS VULNERABLE" :
     nearR ? "SHORTS MAY DEFEND R1 / BUY STOPS ABOVE" :
     nearS ? "LONGS MAY DEFEND S1 / SELL STOPS BELOW" :
     "NO IMMEDIATE FORCED-FLOW ZONE"
float recentLow = ta.lowest(low, 5)
float recentHigh = ta.highest(high, 5)
float longStop =
     longAcceptance and not na(rLo) ? rLo - stopBuf :
     (longSupportDefense or longFailedDown) and not na(sLo) ? math.min(sLo, recentLow) - stopBuf :
     recentLow - stopBuf
float shortStop =
     shortAcceptance and not na(sHi) ? sHi + stopBuf :
     (shortResistanceDefense or shortFailedUp) and not na(rHi) ? math.max(rHi, recentHigh) + stopBuf :
     recentHigh + stopBuf
float longRisk = math.max(close - longStop, tick)
float shortRisk = math.max(shortStop - close, tick)
float longDest = not na(busR1) and busR1 > close ? busR1 :
     not na(busR2) and busR2 > close ? busR2 : na
float shortDest = not na(busS1) and busS1 < close ? busS1 :
     not na(busS2) and busS2 < close ? busS2 : na
float longRoomR = not na(longDest) ? math.max(0.0, (longDest - close) / longRisk) : na
float shortRoomR = not na(shortDest) ? math.max(0.0, (close - shortDest) / shortRisk) : na
bool longRouteUsable = na(longRoomR) or longRoomR >= routeMinimumR
bool shortRouteUsable = na(shortRoomR) or shortRoomR >= routeMinimumR
float moveParticipation = clockReadyCtx ? timeRelVolCtx : relVol
float moveRangePace = clockReadyCtx ? timeRelRangeCtx : (atr > tick ? barRange / atr : 1.0)
bool moveEnvironmentReady =
     moveParticipation >= moveMinParticipation and
     moveRangePace >= moveMinRangePace
bool longMoveProof =
     longDiscovery ? (buyerResult >= moveMinResult and territoryEfficiency >= moveMinEfficiency and not buyerPoorResult) :
     longFailedDown ? (close > open and buyerResult >= moveMinResult and (buyerSponsored or upTerritory or upHolding or sellerPoorResult)) :
     longSupportDefense ? (close > open and buyerResult >= moveMinResult and (buyerSponsored or sellerPoorResult)) :
     longAcceptance ? (buyerSponsored and buyerResult >= moveMinResult) : false
bool shortMoveProof =
     shortDiscovery ? (sellerResult >= moveMinResult and territoryEfficiency >= moveMinEfficiency and not sellerPoorResult) :
     shortFailedUp ? (close < open and sellerResult >= moveMinResult and (sellerSponsored or dnTerritory or dnHolding or buyerPoorResult)) :
     shortResistanceDefense ? (close < open and sellerResult >= moveMinResult and (sellerSponsored or buyerPoorResult)) :
     shortAcceptance ? (sellerSponsored and sellerResult >= moveMinResult) : false
float longMoveTrigger = high + tick
float shortMoveTrigger = low - tick
bool r1HardObstacle = not na(busR1) and busR1 > longMoveTrigger and
     rState != Z_ACCEPTED and rState != Z_WEAK and rState != Z_CONSUMED and
     (rState == Z_DEFENDED or rStrength >= 7)
bool s1HardObstacle = not na(busS1) and busS1 < shortMoveTrigger and
     sState != Z_ACCEPTED and sState != Z_WEAK and sState != Z_CONSUMED and
     (sState == Z_DEFENDED or sStrength >= 7)
float longMoveDest = r1HardObstacle ? busR1 :
     (not na(busR2) and busR2 > longMoveTrigger ? busR2 : na)
float shortMoveDest = s1HardObstacle ? busS1 :
     (not na(busS2) and busS2 < shortMoveTrigger ? busS2 : na)
float longMoveRoomPts = not na(longMoveDest) ? math.max(0.0, longMoveDest - longMoveTrigger) : na
float shortMoveRoomPts = not na(shortMoveDest) ? math.max(0.0, shortMoveTrigger - shortMoveDest) : na
bool longExpansionCanBreak =
     auctionCode == AUC_EXP_UP and upTerritory and buyerResult >= 0.40 and
     territoryEfficiency >= moveMinEfficiency and
     moveParticipation >= 1.0 and moveRangePace >= 1.0
bool shortExpansionCanBreak =
     auctionCode == AUC_EXP_DN and dnTerritory and sellerResult >= 0.40 and
     territoryEfficiency >= moveMinEfficiency and
     moveParticipation >= 1.0 and moveRangePace >= 1.0
bool longMovePotentialReady = na(longMoveRoomPts) or longMoveRoomPts >= moveMinClearRoomPts or longExpansionCanBreak
bool shortMovePotentialReady = na(shortMoveRoomPts) or shortMoveRoomPts >= moveMinClearRoomPts or shortExpansionCanBreak
bool fpPocUp = fpHas and fpPocMigCode == 2
bool fpPocDown = fpHas and fpPocMigCode == 0
bool fpValueUp = fpHas and fpValueMigCode == 2
bool fpValueDown = fpHas and fpValueMigCode == 0
bool fpBuyStacked = fpHas and fpMaxBuyStack >= fpStackMin
bool fpSellStacked = fpHas and fpMaxSellStack >= fpStackMin
bool fpAggBuy = fpHas and fpDeltaPct >= fpStrongDeltaPct
bool fpAggSell = fpHas and fpDeltaPct <= -fpStrongDeltaPct
bool fpSellerAbsorbed = fpHas and fpSellerAbsorptionFact and
     (sellerPoorResult or rejectedAtS or sweptSFailed or closeLocation >= 0.20) and
     not dnTerritory
bool fpBuyerAbsorbed = fpHas and fpBuyerAbsorptionFact and
     (buyerPoorResult or rejectedAtR or sweptRFailed or closeLocation <= -0.20) and
     not upTerritory
bool fpLongSupport = fpHas and not fpBuyerAbsorbed and
     ((fpAggBuy and (fpPocUp or fpValueUp or fpBuyStacked or fpUpperDelta > 0)) or fpSellerAbsorbed)
bool fpShortSupport = fpHas and not fpSellerAbsorbed and
     ((fpAggSell and (fpPocDown or fpValueDown or fpSellStacked or fpLowerDelta < 0)) or fpBuyerAbsorbed)
bool fpLongContradiction = fpHas and fpAggSell and fpPocDown and
     (fpSellStacked or fpValueDown) and (dnTerritory or sellerSponsored)
bool fpShortContradiction = fpHas and fpAggBuy and fpPocUp and
     (fpBuyStacked or fpValueUp) and (upTerritory or buyerSponsored)
bool fpLongConstructive = fpHas and not fpLongContradiction and fpPocUp and
     (fpValueUp or fpBuyImbCount >= fpSellImbCount) and fpDeltaPct > -0.05
bool fpShortConstructive = fpHas and not fpShortContradiction and fpPocDown and
     (fpValueDown or fpSellImbCount >= fpBuyImbCount) and fpDeltaPct < 0.05
bool fpLongExhaustion = fpHas and fpAggBuy and not fpPocUp and
     (buyerPoorResult or rejectedAtR or closeLocation < 0.10) and
     (nearR or fpBuyerAbsorbed or fpValueDown)
bool fpShortExhaustion = fpHas and fpAggSell and not fpPocDown and
     (sellerPoorResult or rejectedAtS or closeLocation > -0.10) and
     (nearS or fpSellerAbsorbed or fpValueUp)
var int amdState = AMD_NONE
var int amdStateBar = na
var int amdBalanceCount = 0
var float amdRangeHi = na
var float amdRangeLo = na
var float amdManipExtreme = na
bool amdBalanceNow =
     (auctionCode == AUC_BALANCE or auctionCode == AUC_BUILD or auctionCode == AUC_CHOP) and
     not na(busBalHi) and not na(busBalLo) and busBalHi > busBalLo and
     (busBalHi - busBalLo) <= atr * amdMaxBalanceAtr
amdBalanceCount := amdBalanceNow ? math.min(amdBalanceCount + 1, 99) : 0
if amdBalanceCount >= amdAccumBars and
     (amdState == AMD_NONE or amdState == AMD_ACCUM or
      (amdState == AMD_DIST_UP and bar_index - amdStateBar > 4) or
      (amdState == AMD_DIST_DN and bar_index - amdStateBar > 4))
    amdState := AMD_ACCUM
    amdStateBar := bar_index
    amdRangeHi := busBalHi
    amdRangeLo := busBalLo
    amdManipExtreme := na
else if amdState == AMD_ACCUM and amdBalanceNow
    amdRangeHi := busBalHi
    amdRangeLo := busBalLo
bool amdSweepDown = amdState == AMD_ACCUM and not na(amdRangeLo) and
     low < amdRangeLo and close > amdRangeLo and
     (sweptSFailed or balanceReclaimUp or fpSellerAbsorbed or auctionCode == AUC_FAIL_DN)
bool amdSweepUp = amdState == AMD_ACCUM and not na(amdRangeHi) and
     high > amdRangeHi and close < amdRangeHi and
     (sweptRFailed or balanceReclaimDn or fpBuyerAbsorbed or auctionCode == AUC_FAIL_UP)
if amdSweepDown
    amdState := AMD_MANIP_DN
    amdStateBar := bar_index
    amdManipExtreme := low
else if amdSweepUp
    amdState := AMD_MANIP_UP
    amdStateBar := bar_index
    amdManipExtreme := high
else if amdState == AMD_MANIP_DN
    bool manipFresh = bar_index - amdStateBar <= amdManipConfirmBars
    bool distUpConfirmed = manipFresh and not bullContradicted and
         (upTerritory or longAcceptance or auctionCode == AUC_EXP_UP or balanceBreakUp) and
         (not fpHas or fpLongSupport or fpLongConstructive or fpSellerAbsorbed)
    bool breakActuallyDn = not na(amdRangeLo) and close < amdRangeLo and
         (dnTerritory or shortAcceptance) and (not fpHas or fpShortSupport)
    if distUpConfirmed
        amdState := AMD_DIST_UP
        amdStateBar := bar_index
    else if breakActuallyDn
        amdState := AMD_DIST_DN
        amdStateBar := bar_index
    else if not manipFresh
        amdState := AMD_NONE
        amdStateBar := bar_index
        amdRangeHi := na
        amdRangeLo := na
        amdManipExtreme := na
else if amdState == AMD_MANIP_UP
    bool manipFresh = bar_index - amdStateBar <= amdManipConfirmBars
    bool distDnConfirmed = manipFresh and not bearContradicted and
         (dnTerritory or shortAcceptance or auctionCode == AUC_EXP_DN or balanceBreakDn) and
         (not fpHas or fpShortSupport or fpShortConstructive or fpBuyerAbsorbed)
    bool breakActuallyUp = not na(amdRangeHi) and close > amdRangeHi and
         (upTerritory or longAcceptance) and (not fpHas or fpLongSupport)
    if distDnConfirmed
        amdState := AMD_DIST_DN
        amdStateBar := bar_index
    else if breakActuallyUp
        amdState := AMD_DIST_UP
        amdStateBar := bar_index
    else if not manipFresh
        amdState := AMD_NONE
        amdStateBar := bar_index
        amdRangeHi := na
        amdRangeLo := na
        amdManipExtreme := na
else if amdState == AMD_DIST_UP
    if bullContradicted or (bar_index - amdStateBar > amdDistributionMaxBars)
        amdState := AMD_NONE
        amdStateBar := bar_index
        amdRangeHi := na
        amdRangeLo := na
        amdManipExtreme := na
else if amdState == AMD_DIST_DN
    if bearContradicted or (bar_index - amdStateBar > amdDistributionMaxBars)
        amdState := AMD_NONE
        amdStateBar := bar_index
        amdRangeHi := na
        amdRangeLo := na
        amdManipExtreme := na
bool amdSupportsLong = amdState == AMD_MANIP_DN or amdState == AMD_DIST_UP
bool amdSupportsShort = amdState == AMD_MANIP_UP or amdState == AMD_DIST_DN
bool amdOpposesLong = amdState == AMD_DIST_DN
bool amdOpposesShort = amdState == AMD_DIST_UP
bool fpLongEffortRejected = fpHas and fpDeltaPct >= flowMinDeltaFrac and fpPocDown and
     (fpValueDown or fpBuyStacked) and not fpSellerAbsorbed
bool fpShortEffortRejected = fpHas and fpDeltaPct <= -flowMinDeltaFrac and fpPocUp and
     (fpValueUp or fpSellStacked) and not fpBuyerAbsorbed
bool fpLongAttempt = fpHas and not fpLongContradiction and
     (fpAggBuy or fpBuyStacked or fpSellerAbsorbed or
      (buyerSponsored and buyerResult >= moveMinResult))
bool fpShortAttempt = fpHas and not fpShortContradiction and
     (fpAggSell or fpSellStacked or fpBuyerAbsorbed or
      (sellerSponsored and sellerResult >= moveMinResult))
bool fpLongAcceptance = fpHas and not fpLongContradiction and not fpLongEffortRejected and
     fpPocUp and
     (fpValueUp or upTerritory or upHolding or acceptedAboveR) and
     (close > close[1] or upTerritory or upHolding)
bool fpShortAcceptance = fpHas and not fpShortContradiction and not fpShortEffortRejected and
     fpPocDown and
     (fpValueDown or dnTerritory or dnHolding or acceptedBelowS) and
     (close < close[1] or dnTerritory or dnHolding)
bool fpLongAbsorptionConfirm = fpHas and fpSellerAbsorbed[1] and fpLongAcceptance
bool fpShortAbsorptionConfirm = fpHas and fpBuyerAbsorbed[1] and fpShortAcceptance
bool fpLongInitiativeConfirm = fpHas and fpLongAttempt[1] and fpLongAcceptance
bool fpShortInitiativeConfirm = fpHas and fpShortAttempt[1] and fpShortAcceptance
bool fpLongImmediateDrive = fpHas and auctionCode == AUC_EXP_UP and
     fpAggBuy and fpBuyStacked and fpPocUp and fpValueUp and
     buyerResult >= 0.40 and upTerritory
bool fpShortImmediateDrive = fpHas and auctionCode == AUC_EXP_DN and
     fpAggSell and fpSellStacked and fpPocDown and fpValueDown and
     sellerResult >= 0.40 and dnTerritory
bool longFlowConfirmed = fpHas and
     not amdOpposesLong and
     (fpLongAbsorptionConfirm or fpLongInitiativeConfirm or fpLongImmediateDrive or
      (amdState == AMD_DIST_UP and fpLongAcceptance))
bool shortFlowConfirmed = fpHas and
     not amdOpposesShort and
     (fpShortAbsorptionConfirm or fpShortInitiativeConfirm or fpShortImmediateDrive or
      (amdState == AMD_DIST_DN and fpShortAcceptance))
bool longFlowUnknown = not fpHas
bool shortFlowUnknown = not fpHas
bool longFlowRejected = fpHas and (fpLongContradiction or fpLongEffortRejected or amdOpposesLong)
bool shortFlowRejected = fpHas and (fpShortContradiction or fpShortEffortRejected or amdOpposesShort)
bool longOptionsBase = longMoveProof and moveEnvironmentReady and longMovePotentialReady
bool shortOptionsBase = shortMoveProof and moveEnvironmentReady and shortMovePotentialReady
bool longOptionsSuitable = longOptionsBase and longFlowConfirmed
bool shortOptionsSuitable = shortOptionsBase and shortFlowConfirmed
int longCauseNow = amdState == AMD_DIST_UP ? STORY_CAUSE_AMD :
     longFailedDown ? STORY_CAUSE_FAILED_AUCTION :
     longAcceptance ? STORY_CAUSE_ACCEPTANCE :
     longSupportDefense ? STORY_CAUSE_DEFENSE :
     longDiscovery ? STORY_CAUSE_DISCOVERY :
     (upTerritory or upHolding or buyerSponsored) ? STORY_CAUSE_CONTINUATION : STORY_CAUSE_NONE
int shortCauseNow = amdState == AMD_DIST_DN ? STORY_CAUSE_AMD :
     shortFailedUp ? STORY_CAUSE_FAILED_AUCTION :
     shortAcceptance ? STORY_CAUSE_ACCEPTANCE :
     shortResistanceDefense ? STORY_CAUSE_DEFENSE :
     shortDiscovery ? STORY_CAUSE_DISCOVERY :
     (dnTerritory or dnHolding or sellerSponsored) ? STORY_CAUSE_CONTINUATION : STORY_CAUSE_NONE
float longCauseAnchorNow = longCauseNow == STORY_CAUSE_AMD ?
     (not na(amdRangeHi) ? amdRangeHi : not na(busBalHi) ? busBalHi : nz(busRthVwap, math.min(low, low[1]))) :
     longCauseNow == STORY_CAUSE_FAILED_AUCTION ?
     (not na(amdRangeLo) ? amdRangeLo : not na(busBalLo) ? busBalLo : not na(busS1) ? busS1 : math.min(low, low[1])) :
     longCauseNow == STORY_CAUSE_ACCEPTANCE ? nz(rHi, nz(busR1, close)) :
     longCauseNow == STORY_CAUSE_DEFENSE ? nz(sHi, nz(busS1, math.min(low, low[1]))) :
     longCauseNow == STORY_CAUSE_DISCOVERY ?
     (not na(busBalHi) and close > busBalHi ? busBalHi : not na(busR1) and close > busR1 ? busR1 : nz(busRthVwap, math.min(low, low[1]))) :
     longCauseNow == STORY_CAUSE_CONTINUATION ? nz(busRthVwap, math.min(low, low[1])) : na
float shortCauseAnchorNow = shortCauseNow == STORY_CAUSE_AMD ?
     (not na(amdRangeLo) ? amdRangeLo : not na(busBalLo) ? busBalLo : nz(busRthVwap, math.max(high, high[1]))) :
     shortCauseNow == STORY_CAUSE_FAILED_AUCTION ?
     (not na(amdRangeHi) ? amdRangeHi : not na(busBalHi) ? busBalHi : not na(busR1) ? busR1 : math.max(high, high[1])) :
     shortCauseNow == STORY_CAUSE_ACCEPTANCE ? nz(sLo, nz(busS1, close)) :
     shortCauseNow == STORY_CAUSE_DEFENSE ? nz(rLo, nz(busR1, math.max(high, high[1]))) :
     shortCauseNow == STORY_CAUSE_DISCOVERY ?
     (not na(busBalLo) and close < busBalLo ? busBalLo : not na(busS1) and close < busS1 ? busS1 : nz(busRthVwap, math.max(high, high[1]))) :
     shortCauseNow == STORY_CAUSE_CONTINUATION ? nz(busRthVwap, math.max(high, high[1])) : na
bool longAttemptObserved =
     longCauseNow != STORY_CAUSE_NONE or buyerSponsored or upTerritory or upHolding or
     fpLongAttempt or fpSellerAbsorbed or
     (auctionCode == AUC_TEST_DN and sellerPoorResult and close > open)
bool shortAttemptObserved =
     shortCauseNow != STORY_CAUSE_NONE or sellerSponsored or dnTerritory or dnHolding or
     fpShortAttempt or fpBuyerAbsorbed or
     (auctionCode == AUC_TEST_UP and buyerPoorResult and close < open)
bool longInitiativeControlNow =
     (upTerritory or upHolding or acceptedAboveR or longAcceptance) and
     buyerResult >= 0.14 and not buyerPoorResult and
     not (sellerSponsored and sellerResult > buyerResult and dnTerritory)
bool shortInitiativeControlNow =
     (dnTerritory or dnHolding or acceptedBelowS or shortAcceptance) and
     sellerResult >= 0.14 and not sellerPoorResult and
     not (buyerSponsored and buyerResult > sellerResult and upTerritory)
bool longOpponentFailedNow =
     (sellerSponsored or fpAggSell or auctionCode == AUC_TEST_DN) and
     (sellerPoorResult or fpSellerAbsorbed) and
     (close >= open or close > close[1] or upHolding)
bool shortOpponentFailedNow =
     (buyerSponsored or fpAggBuy or auctionCode == AUC_TEST_UP) and
     (buyerPoorResult or fpBuyerAbsorbed) and
     (close <= open or close < close[1] or dnHolding)
bool longDefenseControlNow =
     longSupportDefense and
