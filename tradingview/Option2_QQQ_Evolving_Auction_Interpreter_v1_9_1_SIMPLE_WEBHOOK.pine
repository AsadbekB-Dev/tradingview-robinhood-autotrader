     storyCurrentControl and storyAnchorOwned and not storyOpposingControl and
     not storyFlowContradicted and
     (storyStageCode == STORY_STAGE_EARLY or storyStageCode == STORY_STAGE_HEALTHY)
bool storyDirectParticipation = storyBrainReady and
     (storyFreshCausalDirect or storyDevelopedContinuationDirect)
int storyParticipationState = PART_NONE
if storySide != SIDE_NONE
    storyParticipationState := storyPullbackDangerous ? PART_PULLBACK_DANGEROUS :
         storyPullbackHealthy ? PART_PULLBACK_HEALTHY :
         storyReaccelParticipation ? PART_REACCEL :
         storyUnresolvedLevelFight and storyActionState ? PART_WAIT_LEVEL :
         storyDirectParticipation ? PART_DIRECT :
         storyActionState ? PART_WAIT_PULLBACK : PART_NONE
bool storyParticipationReady = storyParticipationState == PART_DIRECT or
     storyParticipationState == PART_REACCEL
bool longStoryParticipationReady = storySide == SIDE_LONG and storyParticipationReady
bool shortStoryParticipationReady = storySide == SIDE_SHORT and storyParticipationReady
string storyParticipationWhy = storyParticipationState == PART_DIRECT ? "DIRECT" :
     storyParticipationState == PART_REACCEL ? "RE-ACCEL" :
     storyParticipationState == PART_WAIT_LEVEL ? "WAIT LEVEL RESPONSE" :
     storyParticipationState == PART_PULLBACK_HEALTHY ? "PULLBACK HEALTHY" :
     storyParticipationState == PART_PULLBACK_DANGEROUS ? "PULLBACK DANGEROUS" :
     storyParticipationState == PART_WAIT_PULLBACK ?
          (storyStageCode == STORY_STAGE_MATURE or storyStageCode == STORY_STAGE_EXHAUSTED ?
               "WAIT RESET / NO CHASE" :
           storyParticipationCause == STORY_CAUSE_CONTINUATION and storyStageCode == STORY_STAGE_EARLY ?
               "WAIT CONTINUATION PROOF" :
               "WAIT PULLBACK / BETTER LOCATION") : "WAIT"
f_storyText(int st) =>
    st == STORY_FORMING ? "FORMING" :
     st == STORY_PROVING ? "PROVING" :
     st == STORY_ACCEPTED ? "ACCEPTED" :
     st == STORY_CHALLENGED ? "CHALLENGED" :
     st == STORY_REACCEL ? "RE-ACCEL" :
     st == STORY_FAILED ? "FAILED" : "NONE"
f_storyCauseText(int c) =>
    c == STORY_CAUSE_FAILED_AUCTION ? "FAILED AUCTION" :
     c == STORY_CAUSE_ACCEPTANCE ? "ACCEPTANCE" :
     c == STORY_CAUSE_DEFENSE ? "DEFENSE" :
     c == STORY_CAUSE_DISCOVERY ? "DISCOVERY" :
     c == STORY_CAUSE_AMD ? "AMD DISTRIBUTION" :
     c == STORY_CAUSE_CONTINUATION ? "CONTINUING CONTROL" :
     c == STORY_CAUSE_FAILED_CHALLENGE ? "FAILED CHALLENGE" : "NONE"
f_participationText(int st) =>
    st == PART_DIRECT ? "DIRECT" :
     st == PART_WAIT_PULLBACK ? "WAIT PULLBACK" :
     st == PART_PULLBACK_HEALTHY ? "PULLBACK HEALTHY" :
     st == PART_PULLBACK_DANGEROUS ? "PULLBACK DANGEROUS" :
     st == PART_REACCEL ? "RE-ACCEL" :
     st == PART_WAIT_LEVEL ? "WAIT LEVEL" : "NONE"
bool longContinuationQuality =
     not bullContradicted and not buyerCounterWeak and not fpLongContradiction and not amdOpposesLong and
     (upTerritory or upHolding or auctionCode == AUC_EXP_UP or acceptedAboveR) and
     buyerResult >= math.max(moveMinResult, 0.18) and territoryEfficiency >= moveMinEfficiency and
     moveEnvironmentReady and (not fpHas or fpLongSupport or fpLongConstructive or fpSellerAbsorbed or amdSupportsLong) and
     (not sellerSponsored or buyerResult > sellerResult or fpSellerAbsorbed)
bool shortContinuationQuality =
     not bearContradicted and not sellerCounterWeak and not fpShortContradiction and not amdOpposesShort and
     (dnTerritory or dnHolding or auctionCode == AUC_EXP_DN or acceptedBelowS) and
     sellerResult >= math.max(moveMinResult, 0.18) and territoryEfficiency >= moveMinEfficiency and
     moveEnvironmentReady and (not fpHas or fpShortSupport or fpShortConstructive or fpBuyerAbsorbed or amdSupportsShort) and
     (not buyerSponsored or sellerResult > buyerResult or fpBuyerAbsorbed)
float longReentryTriggerNow = high + tick
float shortReentryTriggerNow = low - tick
float longReentryRoomNow = not na(longMoveDest) ? math.max(0.0, longMoveDest - longReentryTriggerNow) : na
float shortReentryRoomNow = not na(shortMoveDest) ? math.max(0.0, shortReentryTriggerNow - shortMoveDest) : na
bool longReentryRouteReady = na(longReentryRoomNow) or longReentryRoomNow >= reentryMinClearRoomPts
bool shortReentryRouteReady = na(shortReentryRoomNow) or shortReentryRoomNow >= reentryMinClearRoomPts
f_amdText(int st) =>
    st == AMD_ACCUM ? "ACCUMULATION" :
     st == AMD_MANIP_DN ? "MANIP DOWN / RECLAIM WATCH" :
     st == AMD_MANIP_UP ? "MANIP UP / REJECT WATCH" :
     st == AMD_DIST_UP ? "DISTRIBUTION UP" :
     st == AMD_DIST_DN ? "DISTRIBUTION DOWN" : "NONE"
f_lifeText(int st) =>
    st == LIFE_PROVING ? "PROVING" :
     st == LIFE_EXPANDING ? "EXPANDING" :
     st == LIFE_HEALTHY ? "HEALTHY" :
     st == LIFE_MATURE ? "MATURE" :
     st == LIFE_EXHAUSTING ? "EXHAUSTING" :
     st == LIFE_TRANSFER ? "CONTROL TRANSFER" : "NONE"
f_fpText() =>
    not fpHas ? "NO FOOTPRINT" :
     fpLongExhaustion ? "BUY AGGRESSION ABSORBED" :
     fpShortExhaustion ? "SELL AGGRESSION ABSORBED" :
     fpSellerAbsorbed ? "SELL PRESSURE ABSORBED" :
     fpBuyerAbsorbed ? "BUY PRESSURE ABSORBED" :
     fpLongSupport ? "BUY FLOW CONFIRMS" :
     fpShortSupport ? "SELL FLOW CONFIRMS" :
     fpLongConstructive ? "VALUE MIGRATING UP" :
     fpShortConstructive ? "VALUE MIGRATING DOWN" :
     "TWO-WAY / NEUTRAL"
f_aucTag(int c) =>
    c == AUC_BALANCE ? "BAL" :
     c == AUC_BUILD ? "BLD" :
     c == AUC_TEST_UP ? "TUP" :
     c == AUC_TEST_DN ? "TDN" :
     c == AUC_FAIL_UP ? "FUP" :
     c == AUC_FAIL_DN ? "FDN" :
     c == AUC_EXP_UP ? "XUP" :
     c == AUC_EXP_DN ? "XDN" :
     c == AUC_CHOP ? "CHP" : "TRN"
f_reasonTag(string r) =>
    r == "FAILED DOWN / RECLAIM" ? "FAIL_DN" :
     r == "BREAK + ACCEPTANCE" ? "ACC_UP" :
     r == "SUPPORT DEFENSE" ? "SUP_DEF" :
     r == "UPWARD DISCOVERY" ? "DISC_UP" :
     r == "FAILED UP / REJECTION" ? "FAIL_UP" :
     r == "BREAKDOWN + ACCEPTANCE" ? "ACC_DN" :
     r == "RESISTANCE DEFENSE" ? "RES_DEF" :
     r == "DOWNWARD DISCOVERY" ? "DISC_DN" :
     r == "UP MOVE DEVELOPING" ? "DEV_UP" :
     r == "DOWN MOVE DEVELOPING" ? "DEV_DN" : "OTHER"
f_territoryTag() =>
    upTerritory ? "BG" :
     dnTerritory ? "SG" :
     upHolding ? "BH" :
     dnHolding ? "SH" : "CT"
f_effortTag(float e) =>
    e >= 0.75 ? "H" : e >= 0.30 ? "A" : "L"
f_resultTag(float r) =>
    r >= 0.40 ? "G" : r >= 0.14 ? "S" : "P"
f_counterTag() =>
    sellerCounterWeak ? "SW" :
     buyerCounterWeak ? "BW" : "TW"
f_oppTag() =>
    acceptedAboveR ? "SHORT_PRESS" :
     sweptRFailed ? "BRK_LONG_VULN" :
     acceptedBelowS ? "LONG_PRESS" :
     sweptSFailed ? "BRK_SHORT_VULN" :
     nearR ? "R1_DEF" :
     nearS ? "S1_DEF" : "NONE"
f_zoneTag(int st, int strength, int src) =>
    str.tostring(st) + "." + str.tostring(strength) + "." + str.tostring(src)
f_num(float x, string fmt) =>
    na(x) ? "NA" : str.tostring(x, fmt)
f_ctEventText(int ev) =>
    ev == CT_EVT_STRUCTURE ? "STRUCTURE" :
     ev == CT_EVT_FAILED_AUCTION ? "FAILED AUCTION" :
     ev == CT_EVT_DRIVE ? "DRIVE" :
     ev == CT_EVT_EFFORT_RESULT ? "EFFORT/RESULT" :
     ev == CT_EVT_RESPONSE ? "RESPONSE" :
     ev == CT_EVT_RECOVERY ? "RECOVERY" :
     ev == CT_EVT_RESPONSE_FAIL ? "RESPONSE FAIL" :
     ev == CT_EVT_ACCEPTANCE ? "ACCEPTANCE" :
     ev == CT_EVT_CONTINUATION ? "CONTINUATION" : "NONE"
f_ctEventTag(int ev) =>
    ev == CT_EVT_STRUCTURE ? "STRUCT" :
     ev == CT_EVT_FAILED_AUCTION ? "FAILAUC" :
     ev == CT_EVT_DRIVE ? "DRIVE" :
     ev == CT_EVT_EFFORT_RESULT ? "EFFRES" :
     ev == CT_EVT_RESPONSE ? "RESP" :
     ev == CT_EVT_RECOVERY ? "RECOV" :
     ev == CT_EVT_RESPONSE_FAIL ? "RESPFAIL" :
     ev == CT_EVT_ACCEPTANCE ? "ACCEPT" :
     ev == CT_EVT_CONTINUATION ? "CONT" : "NONE"
f_shockTag(int st) =>
    st == 1 ? "SHK" :
     st == 2 ? "RPR" :
     st == 3 ? "STB" : "NRM"
f_shockDirTag(int d) =>
    d > 0 ? "UP" : d < 0 ? "DN" : "NA"
f_rxTag(int rx) =>
    rx == 1 ? "FRESH" :
     rx == 2 ? "DEF1" :
     rx == 3 ? "STR" :
     rx == 4 ? "STB" :
     rx == 5 ? "WEAK" :
     rx == 6 ? "WORN" :
     rx == 7 ? "ACC_UP" :
     rx == 8 ? "ACC_DN" :
     rx == 9 ? "CONS" : "NA"
f_battleTag(int b) =>
    b == 1 ? "FRESH" :
     b == 2 ? "DEF1" :
     b == 3 ? "STR" :
     b == 4 ? "MIX" :
     b == 5 ? "WEAK" :
     b == 6 ? "2WAY" :
     b == 7 ? "ACC_UP" :
     b == 8 ? "ACC_DN" :
     b == 9 ? "CONS" : "NA"
f_openLocTag(int x) =>
    x == 1 ? "BELOW_ON" :
     x == 2 ? "ON_LOW" :
     x == 3 ? "ON_MID" :
     x == 4 ? "ON_HIGH" :
     x == 5 ? "ABOVE_ON" : "NA"
f_gapTag(int x) =>
    x == 1 ? "BIG_DN" :
     x == 2 ? "DN" :
     x == 3 ? "FLAT" :
     x == 4 ? "UP" :
     x == 5 ? "BIG_UP" : "NA"
f_openAuctionTag(int x) =>
    x == 1 ? "OPEN_IN" :
     x == 2 ? "OPEN_ABOVE" :
     x == 3 ? "OPEN_BELOW" :
     x == 4 ? "ABOVE_RECLAIM" :
     x == 5 ? "BELOW_RECLAIM" :
     x == 6 ? "IN_BREAK_UP" :
     x == 7 ? "IN_BREAK_DN" : "NA"
f_orTag(int x) =>
    x == 1 ? "BELOW" :
     x == 2 ? "INSIDE" :
     x == 3 ? "ABOVE" : "DEV"
f_dowTag(int d) =>
    d == 1 ? "MON" :
     d == 2 ? "TUE" :
     d == 3 ? "WED" :
     d == 4 ? "THU" :
     d == 5 ? "FRI" : "NA"
f_phaseTag(int slot) =>
    slot <= 0 ? "NA" :
     slot <= 12 ? "OPEN" :
     slot <= 48 ? "MID" : "LATE"
f_ptSlotTag(int slot) =>
    if slot <= 0
        "NA"
    else
        int totalMin = 390 + (slot - 1) * 5
        int hh = int(math.floor(totalMin / 60))
        int mm = totalMin % 60
        (hh < 10 ? "0" : "") + str.tostring(hh) + (mm < 10 ? "0" : "") + str.tostring(mm)
f_calendarTag(int c) =>
    c == 1 ? "ROLL" :
     c == 2 ? "EXP" : "NORMAL"
f_esTag(int c) =>
    c == 1 ? "UP_AGREE" :
     c == 2 ? "DN_AGREE" :
     c == 3 ? "QQQ_UP_DVG" :
     c == 4 ? "QQQ_DN_DVG" :
     c == 5 ? "MIX" : "NA"
f_vixLevelTag(int c) =>
    c == 1 ? "LOW" :
     c == 2 ? "NORMAL" :
     c == 3 ? "ELEV" : "NA"
f_vixMoveTag(int c) =>
    c == 1 ? "FAST_DN" :
     c == 2 ? "DN" :
     c == 3 ? "QUIET" :
     c == 4 ? "UP" :
     c == 5 ? "FAST_UP" : "NA"

f_directionalRefreshReason(bool enabled, int side, bool consumed, int memorySide,
     bool balanceSeen, int currentCause, int participation,
     int challengeQuality, float reclaimFrac, float currentAnchor, float memoryAnchor,
     bool currentControl, bool actionState, bool globalRenewalNow, float atrNow) =>
    int reason = 0
    bool sameConsumed = enabled and consumed and memorySide == side
    if not sameConsumed
        reason := 1
    else
        bool materiallyNewLocation =
             not na(currentAnchor) and not na(memoryAnchor) and
             math.abs(currentAnchor - memoryAnchor) >= atrNow * MEMORY_NEW_LOCATION_ATR

        bool balanceDiscovery =
             balanceSeen and currentControl and actionState and
             (currentCause == STORY_CAUSE_DISCOVERY or
              currentCause == STORY_CAUSE_ACCEPTANCE or
              currentCause == STORY_CAUSE_AMD)

        bool meaningfulChallengeReset =
             participation == PART_REACCEL and
             challengeQuality == CHALLENGE_MEANINGFUL and
             not na(reclaimFrac) and reclaimFrac >= MEMORY_RECLAIM_FRAC and
             materiallyNewLocation and currentControl and
             globalRenewalNow

        reason := balanceDiscovery ? 2 :
             meaningfulChallengeReset ? 4 : 0
    reason

// Automation webhook contract. This does not change trading logic; it only standardizes
// order-fill messages consumed by Asads automation. SOURCE MAIN is intentional because
// v0.7.8/v0.7.9 worker ships with MAIN enabled. TradingView evaluates these series
// strings when the strategy order actually fills, so TV_TS is the fill-event time.
const string AUTO_SOURCE = "MAIN"
const string AUTO_BOT_TAG = "OPT2V191"
// Live webhook commands are intentionally limited to exactly three actionable verbs:
// CALL, PUT, EXIT.  PRIMARY/REENTRY and exit causes are metadata only.
f_autoEntry(string direction, string leg, float entryPx, float targetPx, float stopPx) =>
    string optionAction = direction == "LONG" ? "CALL" : "PUT"
    "SOURCE " + AUTO_SOURCE + " | " + optionAction + " QQQ" +
     " | LEG " + leg +
     " | ENTRY " + str.tostring(entryPx, format.mintick) +
     " | TARGET " + str.tostring(targetPx, format.mintick) +
     " | SL " + str.tostring(stopPx, format.mintick) +
     " | TV_TS " + str.tostring(timenow) +
     " | SIG_ID " + AUTO_BOT_TAG + "-" + optionAction + "-" + leg + "-" + str.tostring(timenow)

f_autoExit(string reason, string leg) =>
    "SOURCE " + AUTO_SOURCE + " | EXIT QQQ" +
     " | LEG " + leg +
     " | REASON " + reason +
     " | TV_TS " + str.tostring(timenow) +
     " | SIG_ID " + AUTO_BOT_TAG + "-EXIT-" + leg + "-" + str.tostring(timenow)

f_autoArm(string direction, string leg, float triggerPx) =>
    string optionAction = direction == "LONG" ? "CALL" : "PUT"
    "SOURCE " + AUTO_SOURCE + " | ARM " + optionAction + " QQQ" +
     " | LEG " + leg +
     " | TRIGGER " + str.tostring(triggerPx, format.mintick) +
     " | TV_TS " + str.tostring(timenow)

f_buildArmMeta(string sideTag, string reason, float routeR, float trg, float sl, float tp, string maturityTag, string controlTag, string participationTag, int refreshCount, string sessionTag, float dayR, int dayStops, string auditSnapshot) =>
    "V=OPT2B191" +
     "|SD=" + sideTag +
     "|F=" + f_reasonTag(reason) +
     "|A=" + f_aucTag(auctionCode) +
     "|T=" + f_territoryTag() +
     "|BEC=" + f_effortTag(buyerEffort) + f_resultTag(buyerResult) +
     "|SEC=" + f_effortTag(sellerEffort) + f_resultTag(sellerResult) +
     "|BE=" + f_num(buyerEffort, "#.###") +
     "|BR=" + f_num(buyerResult, "#.###") +
     "|SE=" + f_num(sellerEffort, "#.###") +
     "|SR=" + f_num(sellerResult, "#.###") +
     "|C=" + f_counterTag() +
     "|OP=" + f_oppTag() +
     "|RR=" + f_num(routeR, "#.###") +
     "|EFF=" + f_num(territoryEfficiency, "#.###") +
     "|POS=" + f_num(rangePosition, "#.###") +
     "|RV=" + f_num(relVol, "#.###") +
     "|MAT=" + maturityTag +
     "|CTL=" + controlTag +
     "|PART=" + participationTag +
     "|REF=" + str.tostring(refreshCount) +
     "|SES=" + sessionTag +
     "|DR=" + f_num(dayR, "#.###") +
     "|DS=" + str.tostring(dayStops) +
     "|CTX=" + (ctxValid ? "1" : "0") +
     "|SH=" + f_shockTag(shockStateCtx) +
     "|SHD=" + f_shockDirTag(shockDirCtx) +
     "|SHE=" + str.tostring(shockEvidenceCtx) +
     "|SHA=" + str.tostring(shockAgeCtx) +
     "|SHI=" + str.tostring(shockImpulseCtx) +
     "|SHR=" + str.tostring(shockRetraceCtx) +
     "|SHX=" + str.tostring(shockExtremeAgeCtx) +
     "|OL=" + f_openLocTag(openLocationCtx) +
     "|GAP=" + f_gapTag(gapCtx) +
     "|OA=" + f_openAuctionTag(openingAuctionCtx) +
     "|OR=" + f_orTag(openingRangeCtx) +
     "|R1B=" + f_battleTag(r1BattleCtx) +
     "|S1B=" + f_battleTag(s1BattleCtx) +
     "|R1RX=" + f_rxTag(r1ReactionCtx) +
     "|S1RX=" + f_rxTag(s1ReactionCtx) +
     "|DOW=" + f_dowTag(weekdayCtx) +
     "|PT=" + f_ptSlotTag(rthSlotCtx) +
     "|PH=" + f_phaseTag(rthSlotCtx) +
     "|CLK=" + (clockReadyCtx ? "1" : "0") +
     "|RVT=" + f_num(timeRelVolCtx, "#.0") +
     "|RGT=" + f_num(timeRelRangeCtx, "#.0") +
     "|EFT=" + f_num(timeRelEffCtx, "#.0") +
     "|VP=" + f_num(volumePaceCtx, "#.0") +
     "|RP=" + f_num(rangePaceCtx, "#.0") +
     "|CAL=" + f_calendarTag(calendarCtx) +
     "|MKT=" + f_esTag(esContextCtx) +
     "|VXL=" + f_vixLevelTag(vixLevelCtx) +
     "|VXM=" + f_vixMoveTag(vixMoveCtx) +
     "|SHEP=" + str.tostring(shockEpisodeCountCtx) +
     "|SDC=" + ((ctxValid and shockStateCtx == 3 and shockDirCtx < 0) ? "1" : "0") +
     "|RAC=" + ((ctxValid and r1ReactionCtx == 7) ? "1" : "0") +
     "|MV=" + str.tostring(mapVersion) +
     "|R1=" + f_zoneTag(rState, rStrength, rSource) +
     "|S1=" + f_zoneTag(sState, sStrength, sSource) +
     "|BH=" + f_num(busBalHi, format.mintick) +
     "|BL=" + f_num(busBalLo, format.mintick) +
     "|AT=" + str.tostring(time) +
     "|TRG=" + f_num(trg, format.mintick) +
     "|SL=" + f_num(sl, format.mintick) +
     "|MILE=" + f_num(tp, format.mintick) +
     "|FP=" + (fpHas ? "1" : "0") +
     "|FPD=" + f_num(fpDeltaPct, "#.###") +
     "|FPI=" + str.tostring(fpBuyImbCount) + "." + str.tostring(fpSellImbCount) +
     "|FPS=" + str.tostring(fpMaxBuyStack) + "." + str.tostring(fpMaxSellStack) +
     "|FPM=" + (fpPocUp ? "U" : fpPocDown ? "D" : "N") +
     "|AMD=" + str.tostring(amdState) +
     "|FUEL=" + ((sideTag == "L" ? longFlowConfirmed : shortFlowConfirmed) ? "1" : "0") +
     "|FEV=" + (sideTag == "L" ?
          (longFlowUnknown ? "U" : longFlowRejected ? "R" : longFlowConfirmed ? "C" : "N") :
          (shortFlowUnknown ? "U" : shortFlowRejected ? "R" : shortFlowConfirmed ? "C" : "N")) +
     "|FPC=" + (sideTag == "L" ?
          (fpLongAbsorptionConfirm ? "ABS" : fpLongInitiativeConfirm ? "INIT" : fpLongImmediateDrive ? "DRIVE" : amdState == AMD_DIST_UP and fpLongAcceptance ? "AMD" : "NA") :
          (fpShortAbsorptionConfirm ? "ABS" : fpShortInitiativeConfirm ? "INIT" : fpShortImmediateDrive ? "DRIVE" : amdState == AMD_DIST_DN and fpShortAcceptance ? "AMD" : "NA")) +
     "|FPRJ=" + ((sideTag == "L" ? longFlowRejected : shortFlowRejected) ? "1" : "0") +
     "|STY=" + str.tostring(storyState) +
     "|STC=" + str.tostring(storyCause) +
     "|STO=" + str.tostring(storyOriginCause) +
     "|STR=" + str.tostring(storyCauseRevisions) +
     "|CHQ=" + str.tostring(storyChallengeQuality) +
     "|CHB=" + str.tostring(storyChallengeBars) +
     "|CHD=" + f_num(storyChallengeDepthAtr, "#.###") +
     "|CHR=" + f_num(storyChallengeReclaimFrac, "#.###") +
     "|CHE=" + f_num(storyChallengePeakOppEffort, "#.###") +
     "|CHO=" + f_num(storyChallengePeakOppResult, "#.###") +
     "|CHP=" + (storyChallengeSawPoorResult ? "1" : "0") +
     "|CHA=" + (storyChallengeSawAbsorption ? "1" : "0") +
     "|CHV=" + (storyChallengeSawValueMigration ? "1" : "0") +
     "|CHT=" + (storyChallengeSawTerritory ? "1" : "0") +
     "|STG=" + str.tostring(storyStageCode) +
     "|PST=" + str.tostring(storyParticipationState) +
     "|STA=" + f_num(storyAnchor, format.mintick) +
     "|STD=" + f_num(storyDistanceAtr, "#.###") +
     "|CAP=" + f_num(storyCapacityPts, "#.##") +
     "|QRISK=" + f_num(storyQuestionRiskPts, "#.###") +
     "|QTGT=" + f_num(storyQuestionTargetPts, "#.###") +
     "|QATR=" + f_num(storyQuestionTargetAtr, "#.###") +
     "|QINV=" + f_num(storyQuestionInvalid, format.mintick) +
     "|QPATH=" + (storyPathCanPay ? "1" : "0") +
     "|QENG=" + (storyEngineCanPay ? "1" : "0") +
     "|QOK=" + (storyPayoffReady ? "1" : "0") +
     "|QMODE=" + (storyHasFreshChallenge ? "COUNTER" : "ANCHOR") +
     "|SVW=" + f_num(busRthVwap, format.mintick) +
     auditSnapshot
var int episodeSide = SIDE_NONE
var int episodeStartBar = na
var int episodeQuietBars = 0
var bool episodeUsed = false
var string episodeReason = ""
var int dirMemorySide = SIDE_NONE
var bool dirMemoryConsumed = false
var float dirMemoryAnchor = na
var int dirMemoryCause = STORY_CAUSE_NONE
var int dirMemoryTradeBar = na
var bool dirMemoryBalanceSeen = false
var bool dirMemoryOppControlSeen = false
var int dirMemorySameSideCount = 0
var bool shortMaturityWait = false
var bool shortPullbackSeen = false
var float shortMaturityLow = na
var int shortMaturityBar = na
var bool longControlWait = false
var bool shortControlWait = false
var bool longControlRearm = false
var bool shortControlRearm = false
var int pendingSide = SIDE_NONE
var float armTrigger = na
var float armInvalid = na
var float armTarget = na
var int armBar = na
var string armReason = ""
var string armMeta = ""
var int armRefreshCount = 0
var float armQuickAtr = na
var float armQuickObjectivePts = na
var float armExecInvalid = na
var int armStoryCause = STORY_CAUSE_NONE
var float armStoryAnchor = na
var int flowWatchSide = SIDE_NONE
var int flowWatchBar = na
var float tradeEntry = na
var float tradeStop = na
var float tradeTarget = na
var int tradeEntryBar = na
var string tradeReason = ""
var string tradeMeta = ""
var float tradeQuickAtr = na
var float tradeQuickObjectivePts = na
var bool tradeMovePaid = false
var int tradeMovePaidBar = na
var float tradePeakMovePts = 0.0
var float tradeExecInvalid = na
var bool activeIsReentry = false
var bool continuationWatch = false
var int continuationSide = SIDE_NONE
var int continuationExitBar = na
var bool continuationAttempted = false
var bool continuationResetSeen = false
var int continuationResetBar = na
var float continuationResetExtreme = na
var int reentryPendingSide = SIDE_NONE
var float reentryTrigger = na
var float reentryInvalid = na
var float reentryTarget = na
var int reentryArmBar = na
var string reentryReason = ""
var int tradeLifeState = LIFE_NONE
var int tradeLifeStateBar = na
var int tradeLifeExhaustBars = 0
var float tradeProfitFloor = na
var float tradePrevPeakMovePts = 0.0
var float tradeInitialRisk = na
var float tradeMfeR = na
var float tradeMaeR = na
var bool tradeProved05 = false
var bool tradeProved075 = false
var bool tradeProved100 = false
var int tradeProof05Bar = na
var float tradeCloseR = na
var float tradeGivebackR = na
var int tradeProtectEvidence = 0
var int tradeProtectCode = 0
var int lastProtectCode = 0
var int tradeControlState = CT_UNPROVEN
var int tradeControlEventId = 0
var int tradeControlLastEvent = CT_EVT_NONE
var int tradeControlChallengeCode = CT_EVT_NONE
var int tradeControlChallengeBar = na
var int tradeControlTransferBar = na
var float tradeControlChallengeOrigin = na
var float tradeControlChallengeExtreme = na
var bool tradeControlResponseSeen = false
var int tradeControlChallengeCount = 0
var int tradeControlRecoveryCount = 0
var int tradeControlProtectEvent = CT_EVT_NONE
var int lastControlProtectEvent = CT_EVT_NONE
var int tradeControlTransferPath = CT_PATH_NONE
var float tradeControlTransferExtreme = na
var string lastExitText = "—"
var float lastExitPrice = na
var int lastClosedSeen = 0
var string actionText = "WAIT"
var string internalNote = ""
bool eventArmLong = false
bool eventArmShort = false
bool eventEnterLong = false
bool eventEnterShort = false
bool eventReenterLong = false
bool eventReenterShort = false
bool eventExitAgain = false
bool eventExitTarget = false
bool eventStop = false
bool eventExitEarly = false
bool eventExitProtect = false
bool eventExitTime = false
bool newLongPosition = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShortPosition = strategy.position_size < 0 and strategy.position_size[1] >= 0
bool newPosition = newLongPosition or newShortPosition
bool fillingReentry = newPosition and reentryPendingSide != SIDE_NONE
if newPosition
    activeIsReentry := fillingReentry
    tradeEntry := strategy.position_avg_price
    tradeEntryBar := bar_index
    if fillingReentry
        tradeStop := reentryInvalid
        tradeExecInvalid := na
        tradeTarget := newLongPosition ? tradeEntry + reentryTargetPts : tradeEntry - reentryTargetPts
        tradeReason := reentryReason
        tradeMeta := "REENTRY"
        tradeQuickAtr := atr
        tradeQuickObjectivePts := reentryTargetPts
    else
        tradeStop := armInvalid
        tradeExecInvalid := armExecInvalid
        tradeTarget := armTarget
        tradeReason := armReason
        tradeMeta := armMeta
        tradeQuickAtr := armQuickAtr
        tradeQuickObjectivePts := armQuickObjectivePts
    tradeInitialRisk := newLongPosition ?
         math.max(tradeEntry - tradeStop, tick) :
         math.max(tradeStop - tradeEntry, tick)
    tradeMfeR := 0.0
    tradeMaeR := 0.0
    tradeProved05 := false
    tradeProved075 := false
    tradeProved100 := false
    tradeProof05Bar := na
    tradeCloseR := 0.0
    tradeGivebackR := 0.0
    tradeProtectEvidence := 0
    tradeProtectCode := 0
    tradeControlState := CT_UNPROVEN
    tradeControlEventId := 0
    tradeControlLastEvent := CT_EVT_NONE
    tradeControlChallengeCode := CT_EVT_NONE
    tradeControlChallengeBar := na
    tradeControlTransferBar := na
    tradeControlChallengeOrigin := na
    tradeControlChallengeExtreme := na
    tradeControlResponseSeen := false
    tradeControlChallengeCount := 0
    tradeControlRecoveryCount := 0
    tradeControlProtectEvent := CT_EVT_NONE
    tradeControlTransferPath := CT_PATH_NONE
    tradeControlTransferExtreme := na
    tradeMovePaid := false
    tradeMovePaidBar := na
    tradePeakMovePts := 0.0
    tradePrevPeakMovePts := 0.0
    tradeLifeState := activeIsReentry ? LIFE_HEALTHY : LIFE_PROVING
    tradeLifeStateBar := bar_index
    tradeLifeExhaustBars := 0
    tradeProfitFloor := na
    flowWatchSide := SIDE_NONE
    flowWatchBar := na
    if fillingReentry
        eventReenterLong := newLongPosition
        eventReenterShort := newShortPosition
        actionText := newLongPosition ? "ENTER AGAIN CALL" : "ENTER AGAIN PUT"
        continuationWatch := false
        continuationAttempted := true
        continuationResetSeen := false
        continuationResetBar := na
        continuationResetExtreme := na
        reentryTarget := tradeTarget
        reentryPendingSide := SIDE_NONE
        reentryTrigger := na
        reentryInvalid := na
        reentryArmBar := na
        reentryReason := ""
    else
        eventEnterLong := newLongPosition
        eventEnterShort := newShortPosition
        actionText := newLongPosition ? "ENTER CALL" : "ENTER PUT"
        continuationWatch := false
        continuationSide := SIDE_NONE
        continuationExitBar := na
        continuationAttempted := false
        continuationResetSeen := false
        continuationResetBar := na
        continuationResetExtreme := na
        pendingSide := SIDE_NONE
        armTrigger := na
        armExecInvalid := na
        armTarget := na
        armBar := na
        armMeta := ""
        armRefreshCount := 0
        armQuickAtr := na
        armQuickObjectivePts := na
if pendingSide == SIDE_LONG and not na(armInvalid)
    strategy.exit("L-X", from_entry="L", stop=armInvalid,
         comment_loss="STOP", alert_loss=f_autoExit("STOP", "PRIMARY"))
if pendingSide == SIDE_SHORT and not na(armInvalid)
    strategy.exit("S-X", from_entry="S", stop=armInvalid,
         comment_loss="STOP", alert_loss=f_autoExit("STOP", "PRIMARY"))
if reentryPendingSide == SIDE_LONG and not na(reentryInvalid) and not na(reentryTarget)
    strategy.exit("L2-X", from_entry="L2", stop=reentryInvalid, limit=reentryTarget,
         comment_profit="SELL AGAIN", comment_loss="STOP AGAIN",
         alert_profit=f_autoExit("REENTRY_TARGET", "REENTRY"), alert_loss=f_autoExit("REENTRY_STOP", "REENTRY"))
if reentryPendingSide == SIDE_SHORT and not na(reentryInvalid) and not na(reentryTarget)
    strategy.exit("S2-X", from_entry="S2", stop=reentryInvalid, limit=reentryTarget,
         comment_profit="SELL AGAIN", comment_loss="STOP AGAIN",
         alert_profit=f_autoExit("REENTRY_TARGET", "REENTRY"), alert_loss=f_autoExit("REENTRY_STOP", "REENTRY"))
if strategy.position_size > 0 and not activeIsReentry and not na(tradeStop)
    bool longFlowStopActive = enableFlowExecutionStop and tradePrevPeakMovePts < lifeProofPts and
         not na(tradeExecInvalid) and tradeExecInvalid > tradeStop
    float longBaseStop = longFlowStopActive ? math.max(tradeStop, tradeExecInvalid) : tradeStop
    float liveLongStop = not na(tradeProfitFloor) ? math.max(longBaseStop, tradeProfitFloor) : longBaseStop
    if not na(tradeProfitFloor) and liveLongStop >= tradeProfitFloor and tradeProfitFloor > longBaseStop
        strategy.exit("L-X", from_entry="L", stop=liveLongStop,
             comment_loss="LOCK_FLOOR", alert_loss=f_autoExit("LOCK_FLOOR", "PRIMARY"))
    else if longFlowStopActive
        strategy.exit("L-X", from_entry="L", stop=liveLongStop,
             comment_loss="FLOW_STOP", alert_loss=f_autoExit("FLOW_STOP", "PRIMARY"))
    else
        strategy.exit("L-X", from_entry="L", stop=liveLongStop,
             comment_loss="STOP", alert_loss=f_autoExit("STOP", "PRIMARY"))
if strategy.position_size < 0 and not activeIsReentry and not na(tradeStop)
    bool shortFlowStopActive = enableFlowExecutionStop and tradePrevPeakMovePts < lifeProofPts and
         not na(tradeExecInvalid) and tradeExecInvalid < tradeStop
    float shortBaseStop = shortFlowStopActive ? math.min(tradeStop, tradeExecInvalid) : tradeStop
    float liveShortStop = not na(tradeProfitFloor) ? math.min(shortBaseStop, tradeProfitFloor) : shortBaseStop
    if not na(tradeProfitFloor) and liveShortStop <= tradeProfitFloor and tradeProfitFloor < shortBaseStop
        strategy.exit("S-X", from_entry="S", stop=liveShortStop,
             comment_loss="LOCK_FLOOR", alert_loss=f_autoExit("LOCK_FLOOR", "PRIMARY"))
    else if shortFlowStopActive
        strategy.exit("S-X", from_entry="S", stop=liveShortStop,
             comment_loss="FLOW_STOP", alert_loss=f_autoExit("FLOW_STOP", "PRIMARY"))
    else
        strategy.exit("S-X", from_entry="S", stop=liveShortStop,
             comment_loss="STOP", alert_loss=f_autoExit("STOP", "PRIMARY"))
if strategy.position_size > 0 and activeIsReentry and not na(tradeStop) and not na(tradeTarget)
    strategy.exit("L2-X", from_entry="L2", stop=tradeStop, limit=tradeTarget,
         comment_profit="SELL AGAIN", comment_loss="STOP AGAIN",
         alert_profit=f_autoExit("REENTRY_TARGET", "REENTRY"), alert_loss=f_autoExit("REENTRY_STOP", "REENTRY"))
if strategy.position_size < 0 and activeIsReentry and not na(tradeStop) and not na(tradeTarget)
    strategy.exit("S2-X", from_entry="S2", stop=tradeStop, limit=tradeTarget,
         comment_profit="SELL AGAIN", comment_loss="STOP AGAIN",
         alert_profit=f_autoExit("REENTRY_TARGET", "REENTRY"), alert_loss=f_autoExit("REENTRY_STOP", "REENTRY"))
int currentPropDayStamp = time("1D", "0000-2359:1234567", TRADE_TZ)
bool newPropDay =
     not na(currentPropDayStamp) and
     (na(propDayStamp) or currentPropDayStamp != propDayStamp)
if newPropDay
    propDayStamp := currentPropDayStamp
    propDailyRealizedR := 0.0
    propDailyStops := 0
    propShieldActive := false
    dirMemorySide := SIDE_NONE
    dirMemoryConsumed := false
    dirMemoryAnchor := na
    dirMemoryCause := STORY_CAUSE_NONE
    dirMemoryTradeBar := na
    dirMemoryBalanceSeen := false
    dirMemoryOppControlSeen := false
    dirMemorySameSideCount := 0

// A filled MAIN trade consumes the directional information that justified it.
// A later same-side entry must therefore demonstrate a real auction reset.
if newPosition and not fillingReentry
    int filledMemorySide = newLongPosition ? SIDE_LONG : SIDE_SHORT
    bool sameConsumedDirection = dirMemoryConsumed and dirMemorySide == filledMemorySide
    dirMemorySameSideCount := sameConsumedDirection ? dirMemorySameSideCount + 1 : 1
    dirMemorySide := filledMemorySide
    dirMemoryConsumed := true
    dirMemoryAnchor := armStoryAnchor
    dirMemoryCause := armStoryCause
    dirMemoryTradeBar := bar_index
    dirMemoryBalanceSeen := false
    dirMemoryOppControlSeen := false

// While flat, remember whether the old directional auction genuinely reset.
// These observations do not themselves create a trade.
if strategy.position_size == 0 and dirMemoryConsumed
    bool neutralResetNow =
         (auctionCode == AUC_BALANCE or auctionCode == AUC_CHOP) and
         not (longControlNow and not shortControlNow) and
         not (shortControlNow and not longControlNow)
    if neutralResetNow
        dirMemoryBalanceSeen := true

    bool oppositeControlNow = dirMemorySide == SIDE_LONG ?
         (shortControlNow and not longControlNow) :
         dirMemorySide == SIDE_SHORT ?
         (longControlNow and not shortControlNow) : false
    if oppositeControlNow
        dirMemoryOppControlSeen := true
if strategy.closedtrades > lastShieldClosedSeen
    int shieldIdx = strategy.closedtrades - 1
    string shieldExitComment = strategy.closedtrades.exit_comment(shieldIdx)
    float shieldExitPrice = strategy.closedtrades.exit_price(shieldIdx)
    string shieldEntryId = strategy.closedtrades.entry_id(shieldIdx)
    float resolvedR = 0.0
    if not na(tradeInitialRisk) and tradeInitialRisk > 0 and not na(tradeEntry)
        bool shieldWasLong = str.startswith(shieldEntryId, "L")
        resolvedR := shieldWasLong ?
             (shieldExitPrice - tradeEntry) / tradeInitialRisk :
             (tradeEntry - shieldExitPrice) / tradeInitialRisk
    propDailyRealizedR += resolvedR
    if shieldExitComment == "STOP"
        propDailyStops += 1
        if enableDailyShield and propDailyRealizedR <= 0.0
            propShieldActive := true
            strategy.cancel_all()
    lastShieldClosedSeen := strategy.closedtrades
bool canReasonThisBar = barstate.isconfirmed and not newPosition
if canReasonThisBar
    internalNote := ""
    if preBlackoutBar
        strategy.cancel_all()
        if strategy.position_size != 0
            strategy.close_all(comment="TIME", alert_message=f_autoExit("TIME_BLOCK", "PRIMARY"))
        pendingSide := SIDE_NONE
        armTrigger := na
        armInvalid := na
        armExecInvalid := na
        armTarget := na
        armBar := na
        armReason := ""
        armMeta := ""
        armRefreshCount := 0
        episodeSide := SIDE_NONE
        episodeStartBar := na
        episodeQuietBars := 0
        episodeUsed := false
        episodeReason := ""
        shortMaturityWait := false
        shortPullbackSeen := false
        shortMaturityLow := na
        shortMaturityBar := na
        longControlWait := false
        shortControlWait := false
        longControlRearm := false
        shortControlRearm := false
        continuationWatch := false
        continuationSide := SIDE_NONE
        continuationExitBar := na
        continuationAttempted := false
        continuationResetSeen := false
        continuationResetBar := na
        continuationResetExtreme := na
        reentryPendingSide := SIDE_NONE
        reentryTrigger := na
        reentryInvalid := na
        reentryTarget := na
        reentryArmBar := na
        reentryReason := ""
        actionText := strategy.position_size != 0 ? "EXIT TIME BLOCK" : "NO TRADE 00–04 PT"
        internalNote := "MIDNIGHT–4AM PACIFIC HARD BLOCK"
    else if noTradeWindow
        strategy.cancel_all()
        if strategy.position_size != 0
            strategy.close_all(comment="TIME", alert_message=f_autoExit("TIME_BLOCK", "PRIMARY"))
        pendingSide := SIDE_NONE
        armTrigger := na
        armInvalid := na
        armExecInvalid := na
        armTarget := na
        armBar := na
        armReason := ""
        armMeta := ""
        armRefreshCount := 0
        episodeSide := SIDE_NONE
        episodeStartBar := na
        episodeQuietBars := 0
        episodeUsed := false
        episodeReason := ""
        shortMaturityWait := false
        shortPullbackSeen := false
        shortMaturityLow := na
        shortMaturityBar := na
        longControlWait := false
        shortControlWait := false
        longControlRearm := false
        shortControlRearm := false
        continuationWatch := false
        continuationSide := SIDE_NONE
        continuationExitBar := na
        continuationAttempted := false
        continuationResetSeen := false
        continuationResetBar := na
        continuationResetExtreme := na
        reentryPendingSide := SIDE_NONE
        reentryTrigger := na
        reentryInvalid := na
        reentryTarget := na
        reentryArmBar := na
        reentryReason := ""
        actionText := "NO TRADE 00–04 PT"
        internalNote := "MIDNIGHT–4AM PACIFIC HARD BLOCK"
    else if (sessionTransitionWindow or sessionTransitionBoundary) and strategy.position_size == 0
        strategy.cancel_all()
        pendingSide := SIDE_NONE
        armTrigger := na
        armInvalid := na
        armExecInvalid := na
        armTarget := na
        armBar := na
        armReason := ""
        armMeta := ""
        armRefreshCount := 0
        episodeSide := SIDE_NONE
        episodeStartBar := na
        episodeQuietBars := 0
        episodeUsed := false
        episodeReason := ""
        shortMaturityWait := false
        shortPullbackSeen := false
        shortMaturityLow := na
        shortMaturityBar := na
        longControlWait := false
        shortControlWait := false
        longControlRearm := false
        shortControlRearm := false
        continuationWatch := false
        continuationSide := SIDE_NONE
        continuationExitBar := na
        continuationAttempted := false
        continuationResetSeen := false
        continuationResetBar := na
        continuationResetExtreme := na
        reentryPendingSide := SIDE_NONE
        reentryTrigger := na
        reentryInvalid := na
        reentryTarget := na
        reentryArmBar := na
        reentryReason := ""
        actionText := preRthTransition or preRthBoundaryBar ?
             "WAIT — RTH OPEN TRANSITION" :
             "WAIT — CASH CLOSE TRANSITION"
        internalNote := "SESSION BOUNDARY · REBUILD REASONING AFTER TRANSITION"
    else if strategy.position_size != 0
        if not na(tradeInitialRisk) and tradeInitialRisk > 0
            float liveFavR = strategy.position_size > 0 ?
                 (high - tradeEntry) / tradeInitialRisk :
                 (tradeEntry - low) / tradeInitialRisk
            float liveAdvR = strategy.position_size > 0 ?
                 (tradeEntry - low) / tradeInitialRisk :
                 (high - tradeEntry) / tradeInitialRisk
            tradeMfeR := na(tradeMfeR) ? math.max(liveFavR, 0.0) : math.max(tradeMfeR, liveFavR)
            tradeMaeR := na(tradeMaeR) ? math.max(liveAdvR, 0.0) : math.max(tradeMaeR, liveAdvR)
            bool newlyProved05 = not tradeProved05 and tradeMfeR >= PROVEN_R
            tradeProved05 := tradeProved05 or tradeMfeR >= PROVEN_R
            tradeProved075 := tradeProved075 or tradeMfeR >= 0.75
            tradeProved100 := tradeProved100 or tradeMfeR >= 1.00
            if newlyProved05
                tradeProof05Bar := bar_index
                tradeControlState := CT_PROVEN
                tradeControlLastEvent := CT_EVT_NONE
            tradeCloseR := strategy.position_size > 0 ?
                 (close - tradeEntry) / tradeInitialRisk :
                 (tradeEntry - close) / tradeInitialRisk
            tradeGivebackR := math.max(0.0, tradeMfeR - tradeCloseR)
            float liveMovePts = tradeMfeR * tradeInitialRisk
            tradePrevPeakMovePts := tradePeakMovePts
            tradePeakMovePts := math.max(tradePeakMovePts, liveMovePts)
            if activeIsReentry
                tradeProfitFloor := na
            if not tradeMovePaid and liveMovePts >= moveMilestonePts
                tradeMovePaid := true
                tradeMovePaidBar := bar_index
        int heldBars = na(tradeEntryBar) ? 0 : bar_index - tradeEntryBar
        bool longProtectTerritory = strategy.position_size > 0 and dnTerritory
        bool longProtectEffort = strategy.position_size > 0 and (sellerSponsored or (buyerPoorResult and sellerResult >= 0.14))
        bool longProtectCounter = strategy.position_size > 0 and buyerCounterWeak
        bool longProtectAuction = strategy.position_size > 0 and (auctionCode == AUC_FAIL_UP or auctionCode == AUC_EXP_DN)
        bool longProtectContradiction = strategy.position_size > 0 and bullContradicted
        bool shortProtectTerritory = strategy.position_size < 0 and upTerritory
        bool shortProtectEffort = strategy.position_size < 0 and (buyerSponsored or (sellerPoorResult and buyerResult >= 0.14))
        bool shortProtectCounter = strategy.position_size < 0 and sellerCounterWeak
        bool shortProtectAuction = strategy.position_size < 0 and (auctionCode == AUC_FAIL_DN or auctionCode == AUC_EXP_UP)
        bool shortProtectContradiction = strategy.position_size < 0 and bearContradicted
        tradeProtectEvidence := strategy.position_size > 0 ?
             (longProtectTerritory ? 1 : 0) +
             (longProtectEffort ? 1 : 0) +
             (longProtectCounter ? 1 : 0) +
             (longProtectAuction ? 1 : 0) +
             (longProtectContradiction ? 1 : 0) :
             (shortProtectTerritory ? 1 : 0) +
             (shortProtectEffort ? 1 : 0) +
             (shortProtectCounter ? 1 : 0) +
             (shortProtectAuction ? 1 : 0) +
             (shortProtectContradiction ? 1 : 0)
        tradeProtectCode := strategy.position_size > 0 ?
             (longProtectTerritory ? 1 : 0) +
             (longProtectEffort ? 2 : 0) +
             (longProtectCounter ? 4 : 0) +
             (longProtectAuction ? 8 : 0) +
             (longProtectContradiction ? 16 : 0) :
             (shortProtectTerritory ? 1 : 0) +
             (shortProtectEffort ? 2 : 0) +
             (shortProtectCounter ? 4 : 0) +
             (shortProtectAuction ? 8 : 0) +
             (shortProtectContradiction ? 16 : 0)
        bool proofWasEstablished =
             (tradeMovePaid and not na(tradeMovePaidBar) and bar_index > tradeMovePaidBar) or
             (tradeProved05 and not na(tradeProof05Bar) and bar_index > tradeProof05Bar)
        bool meaningfulGiveback = not na(tradeGivebackR) and tradeGivebackR >= PROTECT_GIVEBACK_R
        bool longFailure =
             strategy.position_size > 0 and
             heldBars >= minEarlyBars and
             ((bullContradicted and (dnTerritory or sellerSponsored)) or
              (auctionCode == AUC_FAIL_UP and dnTerritory) or
              (buyerPoorResult and sellerSponsored and close < tradeEntry))
        bool shortFailure =
             strategy.position_size < 0 and
             heldBars >= minEarlyBars and
             ((bearContradicted and (upTerritory or buyerSponsored)) or
              (auctionCode == AUC_FAIL_DN and upTerritory) or
              (sellerPoorResult and buyerSponsored and close > tradeEntry))
        bool longChallengeStructure = strategy.position_size > 0 and acceptedBelowS
        bool longChallengeFailedAuction = strategy.position_size > 0 and auctionCode == AUC_FAIL_UP
        bool longChallengeDrive = strategy.position_size > 0 and dnTerritory and (sellerSponsored or sellerResult >= 0.40)
        bool longChallengeEffortResult = strategy.position_size > 0 and buyerPoorResult and sellerResult >= 0.14 and close < close[1]
        bool shortChallengeStructure = strategy.position_size < 0 and acceptedAboveR
        bool shortChallengeFailedAuction = strategy.position_size < 0 and auctionCode == AUC_FAIL_DN
        bool shortChallengeDrive = strategy.position_size < 0 and upTerritory and (buyerSponsored or buyerResult >= 0.40)
        bool shortChallengeEffortResult = strategy.position_size < 0 and sellerPoorResult and buyerResult >= 0.14 and close > close[1]
        int adverseEventCode = strategy.position_size > 0 ?
             (longChallengeStructure ? CT_EVT_STRUCTURE :
              longChallengeFailedAuction ? CT_EVT_FAILED_AUCTION :
              longChallengeDrive ? CT_EVT_DRIVE :
              longChallengeEffortResult ? CT_EVT_EFFORT_RESULT : CT_EVT_NONE) :
             (shortChallengeStructure ? CT_EVT_STRUCTURE :
              shortChallengeFailedAuction ? CT_EVT_FAILED_AUCTION :
              shortChallengeDrive ? CT_EVT_DRIVE :
              shortChallengeEffortResult ? CT_EVT_EFFORT_RESULT : CT_EVT_NONE)
        bool adverseEvent = adverseEventCode != CT_EVT_NONE
        bool longResponseEvent = strategy.position_size > 0 and
             ((upTerritory and buyerResult >= 0.18) or
              (buyerSponsored and not dnTerritory) or
              auctionCode == AUC_FAIL_DN or sweptSFailed or balanceReclaimUp or rejectedAtS)
        bool shortResponseEvent = strategy.position_size < 0 and
             ((dnTerritory and sellerResult >= 0.18) or
              (sellerSponsored and not upTerritory) or
              auctionCode == AUC_FAIL_UP or sweptRFailed or balanceReclaimDn or rejectedAtR)
        bool longReclaimedOrigin = strategy.position_size > 0 and not na(tradeControlChallengeOrigin) and close >= tradeControlChallengeOrigin
        bool shortReclaimedOrigin = strategy.position_size < 0 and not na(tradeControlChallengeOrigin) and close <= tradeControlChallengeOrigin
        bool longRecoveryConfirmed = longResponseEvent and
             (longReclaimedOrigin or auctionCode == AUC_FAIL_DN or sweptSFailed or balanceReclaimUp or
              (upTerritory and buyerResult >= 0.40))
        bool shortRecoveryConfirmed = shortResponseEvent and
             (shortReclaimedOrigin or auctionCode == AUC_FAIL_UP or sweptRFailed or balanceReclaimDn or
              (dnTerritory and sellerResult >= 0.40))
        bool recoveryConfirmed = strategy.position_size > 0 ? longRecoveryConfirmed : shortRecoveryConfirmed
        bool responseEvent = strategy.position_size > 0 ? longResponseEvent : shortResponseEvent
        bool longOpponentRetains = strategy.position_size > 0 and not na(tradeControlChallengeOrigin) and
             close < tradeControlChallengeOrigin and
             (dnTerritory or dnHolding or sellerSponsored) and not longRecoveryConfirmed
        bool shortOpponentRetains = strategy.position_size < 0 and not na(tradeControlChallengeOrigin) and
             close > tradeControlChallengeOrigin and
             (upTerritory or upHolding or buyerSponsored) and not shortRecoveryConfirmed
        bool opponentRetains = strategy.position_size > 0 ? longOpponentRetains : shortOpponentRetains
        bool longResponseFailure = strategy.position_size > 0 and tradeControlState == CT_RECOVERING and
             not na(tradeControlChallengeOrigin) and close < tradeControlChallengeOrigin and
             (dnTerritory or sellerSponsored or auctionCode == AUC_EXP_DN) and not longRecoveryConfirmed
        bool shortResponseFailure = strategy.position_size < 0 and tradeControlState == CT_RECOVERING and
             not na(tradeControlChallengeOrigin) and close > tradeControlChallengeOrigin and
             (upTerritory or buyerSponsored or auctionCode == AUC_EXP_UP) and not shortRecoveryConfirmed
        bool responseFailure = strategy.position_size > 0 ? longResponseFailure : shortResponseFailure
        bool longStructuralAcceptance = strategy.position_size > 0 and acceptedBelowS
        bool shortStructuralAcceptance = strategy.position_size < 0 and acceptedAboveR
        bool longOriginAcceptance = strategy.position_size > 0 and not na(tradeControlChallengeOrigin) and
             close < tradeControlChallengeOrigin and close[1] < tradeControlChallengeOrigin and
             (dnTerritory or dnHolding or sellerSponsored)
        bool shortOriginAcceptance = strategy.position_size < 0 and not na(tradeControlChallengeOrigin) and
             close > tradeControlChallengeOrigin and close[1] > tradeControlChallengeOrigin and
             (upTerritory or upHolding or buyerSponsored)
        bool longAdverseAcceptance = strategy.position_size > 0 and not na(tradeControlChallengeOrigin) and
             (longStructuralAcceptance or longOriginAcceptance)
        bool shortAdverseAcceptance = strategy.position_size < 0 and not na(tradeControlChallengeOrigin) and
             (shortStructuralAcceptance or shortOriginAcceptance)
        bool adverseStructuralAcceptance = strategy.position_size > 0 ? longStructuralAcceptance : shortStructuralAcceptance
        bool adverseOriginAcceptance = strategy.position_size > 0 ? longOriginAcceptance : shortOriginAcceptance
        bool adverseAcceptance = strategy.position_size > 0 ? longAdverseAcceptance : shortAdverseAcceptance
        bool longAdverseContinuation = strategy.position_size > 0 and longOpponentRetains and
             (sellerSponsored or auctionCode == AUC_EXP_DN)
        bool shortAdverseContinuation = strategy.position_size < 0 and shortOpponentRetains and
             (buyerSponsored or auctionCode == AUC_EXP_UP)
        bool adverseContinuation = strategy.position_size > 0 ? longAdverseContinuation : shortAdverseContinuation
        bool longTransferProgress = strategy.position_size > 0 and
             tradeControlState == CT_TRANSFER_BUILDING and
             not na(tradeControlTransferExtreme) and
             close < tradeControlTransferExtreme and
             (dnTerritory or sellerSponsored or auctionCode == AUC_EXP_DN)
        bool shortTransferProgress = strategy.position_size < 0 and
             tradeControlState == CT_TRANSFER_BUILDING and
             not na(tradeControlTransferExtreme) and
             close > tradeControlTransferExtreme and
             (upTerritory or buyerSponsored or auctionCode == AUC_EXP_UP)
        bool transferProgress = strategy.position_size > 0 ? longTransferProgress : shortTransferProgress
        if tradeControlState == CT_CHALLENGED or tradeControlState == CT_RECOVERING or tradeControlState == CT_TRANSFER_BUILDING
            tradeControlChallengeExtreme := strategy.position_size > 0 ?
                 (na(tradeControlChallengeExtreme) ? low : math.min(tradeControlChallengeExtreme, low)) :
                 (na(tradeControlChallengeExtreme) ? high : math.max(tradeControlChallengeExtreme, high))
        bool provenProtection = false
        if enableProvenProtection and proofWasEstablished
            if tradeControlState == CT_UNPROVEN
                tradeControlState := CT_PROVEN
            if tradeControlState == CT_PROVEN
                if meaningfulGiveback and adverseEvent and not longFailure and not shortFailure
                    tradeControlState := CT_CHALLENGED
                    tradeControlEventId += 1
                    tradeControlLastEvent := adverseEventCode
                    tradeControlChallengeCode := adverseEventCode
                    tradeControlChallengeBar := bar_index
                    tradeControlTransferBar := na
                    tradeControlChallengeOrigin := close[1]
                    tradeControlChallengeExtreme := strategy.position_size > 0 ? low : high
                    tradeControlResponseSeen := false
                    tradeControlChallengeCount += 1
                    tradeControlProtectEvent := CT_EVT_NONE
                    tradeControlTransferPath := CT_PATH_NONE
                    tradeControlTransferExtreme := na
            else if tradeControlState == CT_CHALLENGED
                if recoveryConfirmed
                    tradeControlEventId += 1
                    tradeControlLastEvent := CT_EVT_RECOVERY
                    tradeControlRecoveryCount += 1
                    tradeControlState := CT_PROVEN
                    tradeControlChallengeBar := na
                    tradeControlTransferBar := na
                    tradeControlChallengeOrigin := na
                    tradeControlChallengeExtreme := na
                    tradeControlResponseSeen := false
                    tradeControlChallengeCode := CT_EVT_NONE
                    tradeControlTransferPath := CT_PATH_NONE
                    tradeControlTransferExtreme := na
                else if responseEvent
                    tradeControlEventId += 1
                    tradeControlLastEvent := CT_EVT_RESPONSE
                    tradeControlResponseSeen := true
                    tradeControlState := CT_RECOVERING
                else if opponentRetains
                    tradeControlEventId += 1
                    tradeControlLastEvent := CT_EVT_CONTINUATION
                    tradeControlTransferBar := bar_index
                    tradeControlTransferPath := CT_PATH_NO_RESPONSE_RETENTION
                    tradeControlTransferExtreme := strategy.position_size > 0 ? low : high
                    tradeControlState := CT_TRANSFER_BUILDING
            else if tradeControlState == CT_RECOVERING
                if recoveryConfirmed
                    tradeControlEventId += 1
                    tradeControlLastEvent := CT_EVT_RECOVERY
                    tradeControlRecoveryCount += 1
                    tradeControlState := CT_PROVEN
                    tradeControlChallengeBar := na
                    tradeControlTransferBar := na
                    tradeControlChallengeOrigin := na
                    tradeControlChallengeExtreme := na
                    tradeControlResponseSeen := false
                    tradeControlChallengeCode := CT_EVT_NONE
                    tradeControlTransferPath := CT_PATH_NONE
                    tradeControlTransferExtreme := na
                else if responseFailure
                    tradeControlEventId += 1
                    tradeControlLastEvent := CT_EVT_RESPONSE_FAIL
                    tradeControlTransferBar := bar_index
                    tradeControlTransferPath := CT_PATH_RESPONSE_FAILURE
                    tradeControlTransferExtreme := strategy.position_size > 0 ? low : high
                    tradeControlState := CT_TRANSFER_BUILDING
            else if tradeControlState == CT_TRANSFER_BUILDING
                if recoveryConfirmed
                    tradeControlEventId += 1
                    tradeControlLastEvent := CT_EVT_RECOVERY
                    tradeControlRecoveryCount += 1
                    tradeControlState := CT_PROVEN
                    tradeControlChallengeBar := na
                    tradeControlTransferBar := na
                    tradeControlChallengeOrigin := na
                    tradeControlChallengeExtreme := na
                    tradeControlResponseSeen := false
                    tradeControlChallengeCode := CT_EVT_NONE
                    tradeControlTransferPath := CT_PATH_NONE
                    tradeControlTransferExtreme := na
                else if not na(tradeControlTransferBar) and bar_index > tradeControlTransferBar and
                     (adverseStructuralAcceptance or transferProgress) and not longFailure and not shortFailure
                    tradeControlEventId += 1
                    tradeControlLastEvent := adverseStructuralAcceptance ? CT_EVT_ACCEPTANCE : CT_EVT_CONTINUATION
                    tradeControlProtectEvent := tradeControlLastEvent
                    provenProtection := true
        float closeMovePts = strategy.position_size > 0 ?
             close - tradeEntry : tradeEntry - close
        float givebackPts = math.max(0.0, tradePeakMovePts - closeMovePts)
        bool lifeProvedDistance = tradePeakMovePts >= lifeProofPts
        bool lifeRunnerDistance = tradePeakMovePts >= lifeRunnerPts
        bool longLevelFriction =
             strategy.position_size > 0 and
             ((r1HardObstacle and nearR) or rejectedAtR or
              (not na(longMoveRoomPts) and longMoveRoomPts < math.max(0.35, tick * 4.0)))
        bool shortLevelFriction =
             strategy.position_size < 0 and
             ((s1HardObstacle and nearS) or rejectedAtS or
              (not na(shortMoveRoomPts) and shortMoveRoomPts < math.max(0.35, tick * 4.0)))
        bool longPriceHealthy = strategy.position_size > 0 and not bullContradicted and not buyerCounterWeak and
             (upTerritory or upHolding or buyerSponsored or acceptedAboveR or balanceReclaimUp)
        bool shortPriceHealthy = strategy.position_size < 0 and not bearContradicted and not sellerCounterWeak and
             (dnTerritory or dnHolding or sellerSponsored or acceptedBelowS or balanceReclaimDn)
        bool longFlowHealthy = strategy.position_size > 0 and
             (not fpHas or fpLongSupport or fpLongConstructive or fpSellerAbsorbed or
              (not fpLongContradiction and not fpLongExhaustion))
        bool shortFlowHealthy = strategy.position_size < 0 and
             (not fpHas or fpShortSupport or fpShortConstructive or fpBuyerAbsorbed or
              (not fpShortContradiction and not fpShortExhaustion))
        bool longFreshDistribution = strategy.position_size > 0 and amdState == AMD_DIST_UP and
             not na(amdStateBar) and bar_index - amdStateBar <= 8
        bool shortFreshDistribution = strategy.position_size < 0 and amdState == AMD_DIST_DN and
             not na(amdStateBar) and bar_index - amdStateBar <= 8
        bool longAgingDistribution = strategy.position_size > 0 and amdState == AMD_DIST_UP and
             not na(amdStateBar) and bar_index - amdStateBar >= 12
        bool shortAgingDistribution = strategy.position_size < 0 and amdState == AMD_DIST_DN and
             not na(amdStateBar) and bar_index - amdStateBar >= 12
        bool longExpandingLife = strategy.position_size > 0 and longPriceHealthy and
             (auctionCode == AUC_EXP_UP or upTerritory or longFreshDistribution) and
             buyerResult >= moveMinResult and
             (not fpHas or fpLongSupport or fpLongConstructive or fpSellerAbsorbed or longFreshDistribution) and
             not longLevelFriction
        bool shortExpandingLife = strategy.position_size < 0 and shortPriceHealthy and
             (auctionCode == AUC_EXP_DN or dnTerritory or shortFreshDistribution) and
             sellerResult >= moveMinResult and
             (not fpHas or fpShortSupport or fpShortConstructive or fpBuyerAbsorbed or shortFreshDistribution) and
             not shortLevelFriction
        bool longHealthyLife = strategy.position_size > 0 and longPriceHealthy and
             (longFlowHealthy or amdSupportsLong) and not fpLongContradiction
        bool shortHealthyLife = strategy.position_size < 0 and shortPriceHealthy and
             (shortFlowHealthy or amdSupportsShort) and not fpShortContradiction
        bool longExhaustSignal = strategy.position_size > 0 and
             (fpLongExhaustion or
              (buyerPoorResult and (sellerSponsored or dnHolding)) or
              (longLevelFriction and not fpLongSupport and not fpSellerAbsorbed))
        bool shortExhaustSignal = strategy.position_size < 0 and
             (fpShortExhaustion or
              (sellerPoorResult and (buyerSponsored or upHolding)) or
              (shortLevelFriction and not fpShortSupport and not fpBuyerAbsorbed))
        bool longOpponentControl = strategy.position_size > 0 and
             (longFailure or bullContradicted or
              (fpLongContradiction and (dnTerritory or sellerSponsored)) or
              (acceptedBelowS and dnTerritory))
        bool shortOpponentControl = strategy.position_size < 0 and
             (shortFailure or bearContradicted or
              (fpShortContradiction and (upTerritory or buyerSponsored)) or
              (acceptedAboveR and upTerritory))
        bool lifeSameSideExpanding = strategy.position_size > 0 ? longExpandingLife : shortExpandingLife
        bool lifeSameSideHealthy = strategy.position_size > 0 ? longHealthyLife : shortHealthyLife
        bool lifeExhaustSignal = strategy.position_size > 0 ? longExhaustSignal : shortExhaustSignal
        bool lifeOpponentControl = strategy.position_size > 0 ? longOpponentControl : shortOpponentControl
        bool lifeLevelFriction = strategy.position_size > 0 ? longLevelFriction : shortLevelFriction
        bool lifeAgingDistribution = strategy.position_size > 0 ? longAgingDistribution : shortAgingDistribution
        if not activeIsReentry
            if lifeExhaustSignal and lifeProvedDistance
                tradeLifeExhaustBars += 1
            else if lifeSameSideExpanding
                tradeLifeExhaustBars := 0
            else
                tradeLifeExhaustBars := math.max(tradeLifeExhaustBars - 1, 0)
            bool exhaustionConfirmed = tradeLifeExhaustBars >= 2 or
                 (lifeExhaustSignal and lifeLevelFriction and lifeRunnerDistance)
            int desiredLife = LIFE_PROVING
            if lifeOpponentControl
                desiredLife := LIFE_TRANSFER
            else if exhaustionConfirmed
                desiredLife := LIFE_EXHAUSTING
            else if lifeRunnerDistance and
                 (lifeLevelFriction or lifeAgingDistribution or
                  ((auctionCode == AUC_BALANCE or auctionCode == AUC_CHOP) and not lifeSameSideExpanding))
                desiredLife := LIFE_MATURE
            else if lifeSameSideExpanding
                desiredLife := LIFE_EXPANDING
            else if lifeProvedDistance and lifeSameSideHealthy
                desiredLife := LIFE_HEALTHY
            else
                desiredLife := LIFE_PROVING
            if desiredLife != tradeLifeState
                tradeLifeState := desiredLife
                tradeLifeStateBar := bar_index
            if tradePrevPeakMovePts >= lifeProofPts
                float lifeCorridor = tradeLifeState == LIFE_EXPANDING ? lifeWideGivebackPts :
                     tradeLifeState == LIFE_HEALTHY ? lifeHealthyGivebackPts :
                     lifeMatureGivebackPts
                float earnedLockPts = math.max(lifeMinLockedPts, tradePrevPeakMovePts - lifeCorridor)
                if earnedLockPts > 0
                    float proposedFloor = strategy.position_size > 0 ?
                         tradeEntry + earnedLockPts : tradeEntry - earnedLockPts
                    tradeProfitFloor := na(tradeProfitFloor) ? proposedFloor :
                         strategy.position_size > 0 ? math.max(tradeProfitFloor, proposedFloor) :
                         math.min(tradeProfitFloor, proposedFloor)
        else
            tradeLifeState := LIFE_HEALTHY
            tradeLifeStateBar := bar_index
            tradeLifeExhaustBars := 0
            tradeProfitFloor := na
        bool mainFlowFailureLong =
             not activeIsReentry and strategy.position_size > 0 and
             tradePrevPeakMovePts < lifeProofPts and
             ((not na(tradeExecInvalid) and close < tradeExecInvalid) or
              (fpPocDown and (fpValueDown or fpAggSell) and (dnTerritory or sellerSponsored)) or
              fpLongEffortRejected or bullContradicted)
        bool mainFlowFailureShort =
             not activeIsReentry and strategy.position_size < 0 and
             tradePrevPeakMovePts < lifeProofPts and
             ((not na(tradeExecInvalid) and close > tradeExecInvalid) or
              (fpPocUp and (fpValueUp or fpAggBuy) and (upTerritory or buyerSponsored)) or
              fpShortEffortRejected or bearContradicted)
        bool mainFlowFailure = mainFlowFailureLong or mainFlowFailureShort
        bool longFloorBreached = not activeIsReentry and strategy.position_size > 0 and
             not na(tradeProfitFloor) and close <= tradeProfitFloor
        bool shortFloorBreached = not activeIsReentry and strategy.position_size < 0 and
             not na(tradeProfitFloor) and close >= tradeProfitFloor
        bool lifeWeakening = lifeExhaustSignal or lifeLevelFriction or lifeOpponentControl or
             ((auctionCode == AUC_BALANCE or auctionCode == AUC_CHOP) and not lifeSameSideHealthy)
        bool mainLifeBank =
             not activeIsReentry and closeMovePts >= lifeMinBankPts and
             (tradeLifeState == LIFE_EXHAUSTING or tradeLifeState == LIFE_TRANSFER or
              (tradeLifeState == LIFE_MATURE and givebackPts >= lifeMatureGivebackPts) or
              (tradeLifeState == LIFE_HEALTHY and lifeWeakening and givebackPts >= lifeHealthyGivebackPts))
        bool reentryEarlyFailure =
             activeIsReentry and heldBars >= 1 and
             ((strategy.position_size > 0 and
               (bullContradicted or fpLongContradiction or
                ((sellerSponsored or fpAggSell) and (dnTerritory or buyerPoorResult)) or
                auctionCode == AUC_FAIL_UP)) or
              (strategy.position_size < 0 and
               (bearContradicted or fpShortContradiction or
                ((buyerSponsored or fpAggBuy) and (upTerritory or sellerPoorResult)) or
                auctionCode == AUC_FAIL_DN)))
        if longFloorBreached
            strategy.close("L", comment="LIFE_FLOOR_BREACH", alert_message=f_autoExit("LIFE_FLOOR_BREACH", "PRIMARY"), immediately=true)
            actionText := "SELL"
            internalNote := "EARNED PROFIT FLOOR ALREADY BREACHED · BANK NOW"
        else if shortFloorBreached
            strategy.close("S", comment="LIFE_FLOOR_BREACH", alert_message=f_autoExit("LIFE_FLOOR_BREACH", "PRIMARY"), immediately=true)
            actionText := "SELL"
            internalNote := "EARNED PROFIT FLOOR ALREADY BREACHED · BANK NOW"
        else if mainFlowFailure and strategy.position_size > 0
            strategy.close("L", comment="FLOW_FAIL", alert_message=f_autoExit("FLOW_FAIL", "PRIMARY"), immediately=true)
            actionText := "SELL"
            internalNote := "ENTRY PROOF FAILED · LOCAL ACCEPTANCE LOST"
        else if mainFlowFailure and strategy.position_size < 0
            strategy.close("S", comment="FLOW_FAIL", alert_message=f_autoExit("FLOW_FAIL", "PRIMARY"), immediately=true)
            actionText := "SELL"
            internalNote := "ENTRY PROOF FAILED · LOCAL ACCEPTANCE LOST"
        else if mainLifeBank and strategy.position_size > 0
            strategy.close("L", comment="LIFE_BANK", alert_message=f_autoExit("LIFE_BANK", "PRIMARY"), immediately=true)
            actionText := "SELL"
            internalNote := "MOVE LIFE " + f_lifeText(tradeLifeState) + " · BANK CALL PROFIT"
        else if mainLifeBank and strategy.position_size < 0
            strategy.close("S", comment="LIFE_BANK", alert_message=f_autoExit("LIFE_BANK", "PRIMARY"), immediately=true)
            actionText := "SELL"
            internalNote := "MOVE LIFE " + f_lifeText(tradeLifeState) + " · BANK PUT PROFIT"
        else if reentryEarlyFailure and strategy.position_size > 0
            strategy.close("L2", comment="SELL AGAIN EARLY", alert_message=f_autoExit("REENTRY_EARLY", "REENTRY"), immediately=true)
            actionText := "SELL AGAIN"
            internalNote := "ENTER AGAIN LOST MOVE LIFE BEFORE +$1"
        else if reentryEarlyFailure and strategy.position_size < 0
            strategy.close("S2", comment="SELL AGAIN EARLY", alert_message=f_autoExit("REENTRY_EARLY", "REENTRY"), immediately=true)
            actionText := "SELL AGAIN"
            internalNote := "ENTER AGAIN LOST MOVE LIFE BEFORE +$1"
        else if provenProtection and strategy.position_size > 0
            string protectPathL = tradeControlTransferPath == CT_PATH_RESPONSE_FAILURE ? "RF" : tradeControlTransferPath == CT_PATH_NO_RESPONSE_RETENTION ? "NR" : "NA"
            string protectConfirmL = adverseStructuralAcceptance ? "STRUCT" : transferProgress ? "PROGRESS" : "NA"
            string protectCommentL = "PROTECT|CH=" + f_ctEventTag(tradeControlChallengeCode) + "|PATH=" + protectPathL + "|CF=" + protectConfirmL + "|EV=" + f_ctEventTag(tradeControlProtectEvent) + "|OA=" + (adverseOriginAcceptance ? "1" : "0") + "|RS=" + (tradeControlResponseSeen ? "1" : "0") + "|B=" + str.tostring(na(tradeControlChallengeBar) ? 0 : bar_index - tradeControlChallengeBar)
            if activeIsReentry
                strategy.close("L2", comment="SELL AGAIN PROTECT", alert_message=f_autoExit("REENTRY_PROTECT", "REENTRY"), immediately=true)
                actionText := "SELL AGAIN"
            else
                strategy.close("L", comment=protectCommentL, alert_message=f_autoExit(protectCommentL, "PRIMARY"), immediately=true)
                actionText := "SELL"
            internalNote := "CONTROL TRANSFER · " + f_ctEventText(tradeControlProtectEvent) + " · CHALLENGE " + f_ctEventText(tradeControlChallengeCode)
        else if provenProtection and strategy.position_size < 0
            string protectPathS = tradeControlTransferPath == CT_PATH_RESPONSE_FAILURE ? "RF" : tradeControlTransferPath == CT_PATH_NO_RESPONSE_RETENTION ? "NR" : "NA"
            string protectConfirmS = adverseStructuralAcceptance ? "STRUCT" : transferProgress ? "PROGRESS" : "NA"
            string protectCommentS = "PROTECT|CH=" + f_ctEventTag(tradeControlChallengeCode) + "|PATH=" + protectPathS + "|CF=" + protectConfirmS + "|EV=" + f_ctEventTag(tradeControlProtectEvent) + "|OA=" + (adverseOriginAcceptance ? "1" : "0") + "|RS=" + (tradeControlResponseSeen ? "1" : "0") + "|B=" + str.tostring(na(tradeControlChallengeBar) ? 0 : bar_index - tradeControlChallengeBar)
            if activeIsReentry
                strategy.close("S2", comment="SELL AGAIN PROTECT", alert_message=f_autoExit("REENTRY_PROTECT", "REENTRY"), immediately=true)
                actionText := "SELL AGAIN"
            else
                strategy.close("S", comment=protectCommentS, alert_message=f_autoExit(protectCommentS, "PRIMARY"), immediately=true)
                actionText := "SELL"
            internalNote := "CONTROL TRANSFER · " + f_ctEventText(tradeControlProtectEvent) + " · CHALLENGE " + f_ctEventText(tradeControlChallengeCode)
        else if enableEarlyExit and longFailure
            if activeIsReentry
                strategy.close("L2", comment="SELL AGAIN EARLY", alert_message=f_autoExit("REENTRY_EARLY", "REENTRY"), immediately=true)
                actionText := "SELL AGAIN"
            else
                strategy.close("L", comment="EARLY", alert_message=f_autoExit("EARLY", "PRIMARY"), immediately=true)
                actionText := "SELL"
            internalNote := "LONG THESIS FAILED"
        else if enableEarlyExit and shortFailure
            if activeIsReentry
                strategy.close("S2", comment="SELL AGAIN EARLY", alert_message=f_autoExit("REENTRY_EARLY", "REENTRY"), immediately=true)
                actionText := "SELL AGAIN"
            else
                strategy.close("S", comment="EARLY", alert_message=f_autoExit("EARLY", "PRIMARY"), immediately=true)
                actionText := "SELL"
            internalNote := "SHORT THESIS FAILED"
        else
            bool longMoveExhausted = enableMoveExhaustionSell and strategy.position_size > 0 and
                 heldBars >= minEarlyBars and
                 (auctionCode == AUC_BALANCE or auctionCode == AUC_CHOP) and
                 not upTerritory and not upHolding and buyerResult < moveMinResult and
                 (sellerSponsored or buyerCounterWeak or dnHolding or dnTerritory)
            bool shortMoveExhausted = enableMoveExhaustionSell and strategy.position_size < 0 and
                 heldBars >= minEarlyBars and
                 (auctionCode == AUC_BALANCE or auctionCode == AUC_CHOP) and
                 not dnTerritory and not dnHolding and sellerResult < moveMinResult and
                 (buyerSponsored or sellerCounterWeak or upHolding or upTerritory)
            if longMoveExhausted
                if activeIsReentry
                    strategy.close("L2", comment="SELL AGAIN EXHAUST", alert_message=f_autoExit("REENTRY_EXHAUST", "REENTRY"), immediately=true)
                    actionText := "SELL AGAIN"
                else
                    strategy.close("L", comment=closeMovePts > 0 ? "LIFE_BANK_EXHAUST" : "SELL_EXHAUST", alert_message=f_autoExit(closeMovePts > 0 ? "LIFE_BANK_EXHAUST" : "SELL_EXHAUST", "PRIMARY"), immediately=true)
                    actionText := "SELL"
                internalNote := "MOVE LOST CHARACTER · BUYERS NO LONGER PRODUCING PROGRESS"
            else if shortMoveExhausted
                if activeIsReentry
                    strategy.close("S2", comment="SELL AGAIN EXHAUST", alert_message=f_autoExit("REENTRY_EXHAUST", "REENTRY"), immediately=true)
                    actionText := "SELL AGAIN"
                else
                    strategy.close("S", comment=closeMovePts > 0 ? "LIFE_BANK_EXHAUST" : "SELL_EXHAUST", alert_message=f_autoExit(closeMovePts > 0 ? "LIFE_BANK_EXHAUST" : "SELL_EXHAUST", "PRIMARY"), immediately=true)
                    actionText := "SELL"
                internalNote := "MOVE LOST CHARACTER · SELLERS NO LONGER PRODUCING PROGRESS"
            else
                actionText := activeIsReentry ?
                     (strategy.position_size > 0 ? "CALL AGAIN ACTIVE" : "PUT AGAIN ACTIVE") :
                     strategy.position_size > 0 ? "CALL " + f_lifeText(tradeLifeState) : "PUT " + f_lifeText(tradeLifeState)
                if not activeIsReentry
                    internalNote := "MOVE LIFE " + f_lifeText(tradeLifeState) +
                         " · FP " + f_fpText() + " · AMD " + f_amdText(amdState)
    else if reentryPendingSide != SIDE_NONE
        bool reStale = bar_index - reentryArmBar >= armTriggerFreshBars
        bool reInvalidated = reentryPendingSide == SIDE_LONG ? low <= reentryInvalid : high >= reentryInvalid
        bool reContradicted = reentryPendingSide == SIDE_LONG ? bullContradicted : bearContradicted
        bool reOppositeTookOver = reentryPendingSide == SIDE_LONG ? bearSupported : bullSupported
        bool reRouteCollapsed = reentryPendingSide == SIDE_LONG ?
             (not longReentryRouteReady or not longContinuationQuality) :
             (not shortReentryRouteReady or not shortContinuationQuality)
        bool reSessionClosed = not entriesAllowedNow
        if reStale or reInvalidated or reContradicted or reOppositeTookOver or reRouteCollapsed or reSessionClosed
            if reentryPendingSide == SIDE_LONG
                strategy.cancel("L2")
                strategy.cancel("L2-X")
            else
                strategy.cancel("S2")
                strategy.cancel("S2-X")
            internalNote := reInvalidated ? "ENTER AGAIN INVALIDATED BEFORE FILL" :
                 reContradicted ? "ENTER AGAIN THESIS CONTRADICTED" :
                 reOppositeTookOver ? "ENTER AGAIN OPPOSING SIDE TOOK OVER" :
                 reRouteCollapsed ? "ENTER AGAIN NO LONGER HAS CLEAN +$1 ROUTE" :
                 reSessionClosed ? "ENTER AGAIN WINDOW CLOSED" :
                 "ENTER AGAIN TRIGGER EXPIRED"
            reentryPendingSide := SIDE_NONE
            reentryTrigger := na
            reentryInvalid := na
            reentryTarget := na
            reentryArmBar := na
            reentryReason := ""
            continuationWatch := false
            continuationResetSeen := false
            continuationResetBar := na
            continuationResetExtreme := na
            actionText := "WAIT"
        else
            actionText := reentryPendingSide == SIDE_LONG ? "ARM AGAIN CALL" : "ARM AGAIN PUT"
            internalNote := "ONE-TIME CONTINUATION · WAITING FOR FRESH PRICE CONFIRMATION"
    else if pendingSide != SIDE_NONE
        bool triggerStale = bar_index - armBar >= armTriggerFreshBars
        bool invalidated = pendingSide == SIDE_LONG ? low <= armInvalid : high >= armInvalid
        bool contradicted = pendingSide == SIDE_LONG ?
             (storyState == STORY_FAILED or longHardFailureNow) :
             (storyState == STORY_FAILED or shortHardFailureNow)
        bool oppositeTookOver = pendingSide == SIDE_LONG ?
             (storySide == SIDE_SHORT and shortControlNow) :
             (storySide == SIDE_LONG and longControlNow)
        bool routeCollapsed = storyStageCode == STORY_STAGE_EXHAUSTED or
             (not na(storyCapacityPts) and storyCapacityPts < storyMinCapacityPts * 0.50)
        bool fuelContradicted = pendingSide == SIDE_LONG ?
             (fpHas and fpLongEffortRejected and (dnTerritory or dnHolding)) :
             (fpHas and fpShortEffortRejected and (upTerritory or upHolding))
        bool sessionNoLongerAllowsEntry = not entriesAllowedNow
        if invalidated or contradicted or oppositeTookOver or routeCollapsed or fuelContradicted or sessionNoLongerAllowsEntry
            if pendingSide == SIDE_LONG
                strategy.cancel("L")
                strategy.cancel("L-X")
            else
                strategy.cancel("S")
                strategy.cancel("S-X")
            internalNote := invalidated ? "THESIS INVALIDATED BEFORE ENTRY" :
                 contradicted ? "THESIS CONTRADICTED" :
                 oppositeTookOver ? "OPPOSING THESIS TOOK OVER" :
                 routeCollapsed ? "ROUTE COLLAPSED" :
                 fuelContradicted ? "FOOTPRINT / AMD FUEL CONTRADICTED" :
                 propShieldActive ? "PROP SHIELD ACTIVE · PENDING ARM CANCELED" :
                 "PROP EXECUTION WINDOW CLOSED"
            pendingSide := SIDE_NONE
            armTrigger := na
            armInvalid := na
            armExecInvalid := na
            armTarget := na
            armBar := na
            armReason := ""
            armMeta := ""
            armRefreshCount := 0
            episodeUsed := true
            storyUsedForMain := true
            actionText := "WAIT"
        else if triggerStale
            if pendingSide == SIDE_LONG
                strategy.cancel("L")
                strategy.cancel("L-X")
            else
                strategy.cancel("S")
                strategy.cancel("S-X")
            int releasedSide = pendingSide
            pendingSide := SIDE_NONE
            armTrigger := na
            armInvalid := na
            armExecInvalid := na
            armTarget := na
            armBar := na
            armReason := ""
            armMeta := ""
            armRefreshCount := 0
            episodeUsed := true
            storyUsedForMain := true
            actionText := releasedSide == SIDE_LONG ?
                 "CALL THESIS · ATTEMPT EXPIRED" :
                 "PUT THESIS · ATTEMPT EXPIRED"
            internalNote := "STALE ARM EXPIRED · WAIT FOR FRESH EPISODE"
        else
            if pendingSide == SIDE_LONG
                strategy.entry("L", strategy.long, stop=armTrigger, comment=armMeta, alert_message=f_autoEntry("LONG", "PRIMARY", armTrigger, armTarget, armInvalid))
                strategy.exit("L-X", from_entry="L", stop=armInvalid,
                     comment_loss="STOP", alert_loss=f_autoExit("STOP", "PRIMARY"))
                actionText := "ARM CALL"
            else
                strategy.entry("S", strategy.short, stop=armTrigger, comment=armMeta, alert_message=f_autoEntry("SHORT", "PRIMARY", armTrigger, armTarget, armInvalid))
                strategy.exit("S-X", from_entry="S", stop=armInvalid,
                     comment_loss="STOP", alert_loss=f_autoExit("STOP", "PRIMARY"))
                actionText := "ARM PUT"
    else
        bool bullAlive = bullDeveloping and not bullContradicted
        bool bearAlive = bearDeveloping and not bearContradicted
        if episodeSide == SIDE_LONG
            if bullAlive
                episodeQuietBars := 0
            else
                episodeQuietBars += 1
        else if episodeSide == SIDE_SHORT
            if bearAlive
                episodeQuietBars := 0
            else
                episodeQuietBars += 1
        if episodeSide == SIDE_LONG and bearSupported and not bullSupported
            episodeSide := SIDE_SHORT
            episodeStartBar := bar_index
            episodeQuietBars := 0
            episodeUsed := false
            episodeReason := shortReason
            shortMaturityWait := false
            shortPullbackSeen := false
            shortMaturityLow := na
            shortMaturityBar := na
            longControlWait := false
            shortControlWait := false
            longControlRearm := false
            shortControlRearm := false
            continuationWatch := false
            continuationSide := SIDE_NONE
            continuationExitBar := na
            reentryPendingSide := SIDE_NONE
        else if episodeSide == SIDE_SHORT and bullSupported and not bearSupported
            episodeSide := SIDE_LONG
            episodeStartBar := bar_index
            episodeQuietBars := 0
            episodeUsed := false
            episodeReason := longReason
            shortMaturityWait := false
            shortPullbackSeen := false
            shortMaturityLow := na
            shortMaturityBar := na
            longControlWait := false
            shortControlWait := false
            longControlRearm := false
            shortControlRearm := false
            continuationWatch := false
            continuationSide := SIDE_NONE
            continuationExitBar := na
            reentryPendingSide := SIDE_NONE
        if episodeSide != SIDE_NONE and episodeQuietBars >= episodeResetBars
            episodeSide := SIDE_NONE
            episodeStartBar := na
            episodeQuietBars := 0
            episodeUsed := false
            episodeReason := ""
            shortMaturityWait := false
            shortPullbackSeen := false
            shortMaturityLow := na
            shortMaturityBar := na
            longControlWait := false
            shortControlWait := false
            longControlRearm := false
            shortControlRearm := false
            continuationWatch := false
            continuationSide := SIDE_NONE
            continuationExitBar := na
            reentryPendingSide := SIDE_NONE
        if episodeSide == SIDE_NONE
            if bullAlive and not bearAlive
                episodeSide := SIDE_LONG
                episodeStartBar := bar_index
                episodeReason := longReason
                shortMaturityWait := false
                shortPullbackSeen := false
                shortMaturityLow := na
                shortMaturityBar := na
                longControlWait := false
                shortControlWait := false
                longControlRearm := false
                shortControlRearm := false
            else if bearAlive and not bullAlive
                episodeSide := SIDE_SHORT
                episodeStartBar := bar_index
                episodeReason := shortReason
                shortMaturityWait := false
                shortPullbackSeen := false
                shortMaturityLow := na
                shortMaturityBar := na
                longControlWait := false
                shortControlWait := false
                longControlRearm := false
                shortControlRearm := false
        if episodeSide == SIDE_LONG and not episodeUsed
            if longReversalUnprovenNow and not longControlWait
                longControlWait := true
                longControlRearm := false
            bool longControlTransferred =
                 longControlWait and
                 not dnTerritory and not dnHolding and
                 (upTerritory or upHolding or
                  (not upTerritory and not dnTerritory and not upHolding and not dnHolding) or
                  auctionCode == AUC_EXP_UP or
                  acceptedAboveR)
            if longControlTransferred
                longControlWait := false
                longControlRearm := true
        if episodeSide == SIDE_SHORT and not episodeUsed
            if shortReversalUnprovenNow and not shortControlWait
                shortControlWait := true
                shortControlRearm := false
            bool shortControlTransferred =
                 shortControlWait and
                 not upTerritory and not upHolding and
                 (dnTerritory or dnHolding or
                  (not upTerritory and not dnTerritory and not upHolding and not dnHolding) or
                  auctionCode == AUC_EXP_DN or
                  acceptedBelowS)
            if shortControlTransferred
                shortControlWait := false
                shortControlRearm := true
        if episodeSide == SIDE_SHORT and not episodeUsed
            if shortMoveMatureNow and not shortMaturityWait
                shortMaturityWait := true
                shortPullbackSeen := false
                shortMaturityLow := low
                shortMaturityBar := bar_index
            if shortMaturityWait
                shortMaturityLow := na(shortMaturityLow) ? low : math.min(shortMaturityLow, low)
                bool meaningfulShortPullback =
                     bar_index > shortMaturityBar and
                     close >= shortMaturityLow + atr * territoryMinAtr and
                     (buyerResult >= 0.14 or close > open)
                if meaningfulShortPullback
                    shortPullbackSeen := true
        bool shortFreshResponse =
             shortMaturityWait and shortPullbackSeen and
             (rejectedAtR or balanceReclaimDn or
              (close < open and sellerResult >= 0.14 and not sellerPoorResult))
        bool longControlReady = not longControlWait
        bool longBaseArmReady =
             entriesAllowedNow and busValid and
             episodeSide == SIDE_LONG and not episodeUsed and
             bullSupported and not bearSupported and
             not bullContradicted and
             not buyerCounterWeak and
             longControlReady and
             longSessionRunwayReady and
             longRouteUsable and
             longOptionsBase
        bool shortWorthTaking =
             not shortMaturityWait or shortFreshResponse
        bool shortControlReady = not shortControlWait
        bool downShockStabilizing =
             ctxValid and shockStateCtx == 3 and shockDirCtx < 0
        bool r1AcceptedAboveConflict =
             ctxValid and r1ReactionCtx == 7
        bool failedUpCausalConflict =
             enableCausalReset and shortFailedUp and
             (downShockStabilizing or r1AcceptedAboveConflict)
        bool freshShortDiscoveryEvent =
             shortDiscovery and not shortDiscovery[1]
        bool freshShortAcceptanceEvent =
             shortAcceptance and not shortAcceptance[1]
        bool freshShortDefenseEvent =
             shortResistanceDefense and not shortResistanceDefense[1] and
             not r1AcceptedAboveConflict
        bool freshSellerResetEvent =
             freshShortAcceptanceEvent or
             freshShortDiscoveryEvent or
             freshShortDefenseEvent
        bool shortCausalReady =
             not failedUpCausalConflict or freshSellerResetEvent
        string shortCausalReason =
             freshShortAcceptanceEvent ? "BREAKDOWN + ACCEPTANCE" :
             freshShortDiscoveryEvent ? "DOWNWARD DISCOVERY" :
             freshShortDefenseEvent ? "RESISTANCE DEFENSE" :
             shortReason
        string auditSnapshotNow = ""
        bool shortBaseArmReady =
             entriesAllowedNow and busValid and
             episodeSide == SIDE_SHORT and not episodeUsed and
             bearSupported and not bullSupported and
             not bearContradicted and
             not sellerCounterWeak and
             shortWorthTaking and
             shortControlReady and
             shortCausalReady and
             shortParticipationReady and
             shortRouteUsable and
             shortOptionsBase
        bool longStoryGeometryReady = not na(longStop) and longStop < high + tick
        bool shortStoryGeometryReady = not na(shortStop) and shortStop > low - tick

        bool longGlobalRenewalNow =
             longExpansionCanBreak and storySide == SIDE_LONG and storyCurrentControl
        bool shortGlobalRenewalNow =
             shortExpansionCanBreak and storySide == SIDE_SHORT and storyCurrentControl

        int longMemoryRefreshReason = f_directionalRefreshReason(
             enableDirectionalEpisodeMemory, SIDE_LONG, dirMemoryConsumed, dirMemorySide,
             dirMemoryBalanceSeen, storyCause, storyParticipationState,
             storyChallengeQuality, storyChallengeReclaimFrac, storyAnchor, dirMemoryAnchor,
             storyCurrentControl, storyActionState, longGlobalRenewalNow, atr)
        int shortMemoryRefreshReason = f_directionalRefreshReason(
             enableDirectionalEpisodeMemory, SIDE_SHORT, dirMemoryConsumed, dirMemorySide,
             dirMemoryBalanceSeen, storyCause, storyParticipationState,
             storyChallengeQuality, storyChallengeReclaimFrac, storyAnchor, dirMemoryAnchor,
             storyCurrentControl, storyActionState, shortGlobalRenewalNow, atr)

        bool longDirectionalMemoryReady = not enableDirectionalEpisodeMemory or
             not dirMemoryConsumed or dirMemorySide != SIDE_LONG or longMemoryRefreshReason > 0
        bool shortDirectionalMemoryReady = not enableDirectionalEpisodeMemory or
             not dirMemoryConsumed or dirMemorySide != SIDE_SHORT or shortMemoryRefreshReason > 0

        bool longDirectEvidenceKnown = storyParticipationState != PART_DIRECT or
             not enableUnknownFlowAwareness or not longFlowUnknown
        bool shortDirectEvidenceKnown = storyParticipationState != PART_DIRECT or
             not enableUnknownFlowAwareness or not shortFlowUnknown

        bool longArmReady = entriesAllowedNow and busValid and longStoryBrainReady and
             longStoryParticipationReady and longStoryGeometryReady and longSessionRunwayReady and
             longDirectionalMemoryReady and longDirectEvidenceKnown
        bool shortArmReady = entriesAllowedNow and busValid and shortStoryBrainReady and
             shortStoryParticipationReady and shortStoryGeometryReady and
             shortDirectionalMemoryReady and shortDirectEvidenceKnown
        flowWatchSide := SIDE_NONE
        flowWatchBar := na
        if storySide == SIDE_LONG and not longArmReady
            actionText := not longDirectionalMemoryReady and storyParticipationState == PART_REACCEL ?
                 "CALL STORY · LOCAL RECLAIM · WAIT GLOBAL RENEWAL" :
                 not longDirectionalMemoryReady and storyParticipationReady ?
                 "CALL STORY · OLD DIRECTIONAL INFO · WAIT REAL RESET" :                 not longDirectEvidenceKnown and storyParticipationReady ?
                 "CALL STORY · FLOW UNKNOWN · WAIT OBSERVABLE PROOF" :
                 storyParticipationCause == STORY_CAUSE_DEFENSE and enableResponsiveInitiativeReasoning and
                 not storyInitiativeNow and storyActionState ?
                 "CALL STORY · DEFENSE HELD · WAIT BUYER INITIATIVE" :
                 "CALL STORY · " + f_storyText(storyState) + " · " + storyParticipationWhy
        else if storySide == SIDE_SHORT and not shortArmReady
            actionText := not shortDirectionalMemoryReady and storyParticipationState == PART_REACCEL ?
                 "PUT STORY · LOCAL RECLAIM · WAIT GLOBAL RENEWAL" :
                 not shortDirectionalMemoryReady and storyParticipationReady ?
                 "PUT STORY · OLD DIRECTIONAL INFO · WAIT REAL RESET" :                 not shortDirectEvidenceKnown and storyParticipationReady ?
                 "PUT STORY · FLOW UNKNOWN · WAIT OBSERVABLE PROOF" :
                 storyParticipationCause == STORY_CAUSE_DEFENSE and enableResponsiveInitiativeReasoning and
                 not storyInitiativeNow and storyActionState ?
                 "PUT STORY · DEFENSE HELD · WAIT SELLER INITIATIVE" :
                 "PUT STORY · " + f_storyText(storyState) + " · " + storyParticipationWhy
        if continuationWatch and not continuationAttempted and not na(continuationExitBar)
            bool continuationExpired = bar_index - continuationExitBar > reentryWatchBars
            bool continuationInvalid = continuationSide == SIDE_LONG ? bullContradicted : bearContradicted
            bool continuationOpposite = continuationSide == SIDE_LONG ?
                 (bearSupported and not bullSupported) : (bullSupported and not bearSupported)
            if continuationExpired or continuationInvalid or continuationOpposite
                continuationWatch := false
                continuationResetSeen := false
                continuationResetBar := na
                continuationResetExtreme := na
            else if bar_index > continuationExitBar and not continuationResetSeen
                bool longResetNow = continuationSide == SIDE_LONG and not bullContradicted and
                     (close < close[1] or low < low[1] or auctionCode == AUC_TEST_DN or
                      auctionCode == AUC_BALANCE or dnHolding or fpAggSell) and
                     not (acceptedBelowS and dnTerritory)
                bool shortResetNow = continuationSide == SIDE_SHORT and not bearContradicted and
                     (close > close[1] or high > high[1] or auctionCode == AUC_TEST_UP or
                      auctionCode == AUC_BALANCE or upHolding or fpAggBuy) and
                     not (acceptedAboveR and upTerritory)
                if longResetNow or shortResetNow
                    continuationResetSeen := true
                    continuationResetBar := bar_index
                    continuationResetExtreme := longResetNow ? low : high
        bool longReaccelerating = continuationWatch and continuationResetSeen and
             continuationSide == SIDE_LONG and not na(continuationResetBar) and bar_index > continuationResetBar and
             close > close[1] and high > high[1] and
             (upTerritory or buyerSponsored or auctionCode == AUC_EXP_UP or longAcceptance) and
             (not fpHas or fpLongSupport or fpLongConstructive or fpSellerAbsorbed or amdState == AMD_DIST_UP) and
             not fpLongContradiction
        bool shortReaccelerating = continuationWatch and continuationResetSeen and
             continuationSide == SIDE_SHORT and not na(continuationResetBar) and bar_index > continuationResetBar and
             close < close[1] and low < low[1] and
             (dnTerritory or sellerSponsored or auctionCode == AUC_EXP_DN or shortAcceptance) and
             (not fpHas or fpShortSupport or fpShortConstructive or fpBuyerAbsorbed or amdState == AMD_DIST_DN) and
             not fpShortContradiction
        float longReStopNow = math.max(longStop, low - stopBuf)
        float shortReStopNow = math.min(shortStop, high + stopBuf)
        float longReRiskNow = math.max(longReentryTriggerNow - longReStopNow, tick)
        float shortReRiskNow = math.max(shortReStopNow - shortReentryTriggerNow, tick)
        bool longReentryReady =
             continuationWatch and not continuationAttempted and continuationResetSeen and longReaccelerating and
             continuationSide == SIDE_LONG and
             not na(continuationExitBar) and bar_index > continuationExitBar and
             bar_index - continuationExitBar <= reentryWatchBars and
             entriesAllowedNow and busValid and
             episodeSide == SIDE_LONG and episodeUsed and
             bullSupported and not bearSupported and
             longContinuationQuality and longReentryRouteReady and
             longReStopNow < longReentryTriggerNow - tick and
             longReRiskNow <= reentryMaxRiskPts and
             longSessionRunwayReady
        bool shortReentryReady =
             continuationWatch and not continuationAttempted and continuationResetSeen and shortReaccelerating and
             continuationSide == SIDE_SHORT and
             not na(continuationExitBar) and bar_index > continuationExitBar and
             bar_index - continuationExitBar <= reentryWatchBars and
             entriesAllowedNow and busValid and
             episodeSide == SIDE_SHORT and episodeUsed and
             bearSupported and not bullSupported and
             shortContinuationQuality and shortReentryRouteReady and
             shortReStopNow > shortReentryTriggerNow + tick and
             shortReRiskNow <= reentryMaxRiskPts and
             shortCausalReady
        if longReentryReady
            reentryPendingSide := SIDE_LONG
            reentryTrigger := longReentryTriggerNow
            reentryInvalid := longReStopNow
            reentryTarget := reentryTrigger + reentryTargetPts
            reentryArmBar := bar_index
            reentryReason := "CONTINUATION AGAIN"
            continuationAttempted := true
            string reMetaL =
                 "V=OPT2B191|RE=1|SD=L|F=CONT_AGAIN|PT=" + str.tostring(hour(time, TRADE_TZ), "00") + str.tostring(minute(time, TRADE_TZ), "00") +
                 "|TRG=" + str.tostring(reentryTrigger, format.mintick) +
                 "|SL=" + str.tostring(reentryInvalid, format.mintick) +
                 "|TP=" + str.tostring(reentryTarget, format.mintick) +
                 "|ROOM=" + (na(longReentryRoomNow) ? "NA" : str.tostring(longReentryRoomNow, "#.##")) +
                 "|EFF=" + str.tostring(territoryEfficiency, "#.###") +
                 "|RV=" + str.tostring(moveParticipation, "#.###") +
                 "|RP=" + str.tostring(moveRangePace, "#.###") +
                 "|FPD=" + f_num(fpDeltaPct, "#.###") +
                 "|AMD=" + str.tostring(amdState)
            strategy.entry("L2", strategy.long, stop=reentryTrigger, comment=reMetaL, alert_message=f_autoEntry("LONG", "REENTRY", reentryTrigger, reentryTarget, reentryInvalid))
            strategy.exit("L2-X", from_entry="L2", stop=reentryInvalid, limit=reentryTarget,
                 comment_profit="SELL AGAIN", comment_loss="STOP AGAIN",
                 alert_profit=f_autoExit("REENTRY_TARGET", "REENTRY"), alert_loss=f_autoExit("REENTRY_STOP", "REENTRY"))
            actionText := "ARM AGAIN CALL"
            internalNote := "MAIN PROFIT BANKED · ONE-TIME +$1 CONTINUATION READY"
            if showSignals
                label.new(bar_index, low, "ARM AGAIN CALL",
                     style=label.style_label_up, textcolor=color.black,
                     color=color.new(color.lime, 20), size=size.tiny)
            alert(f_autoArm("LONG", "REENTRY", reentryTrigger), alert.freq_once_per_bar_close)
        else if shortReentryReady
            reentryPendingSide := SIDE_SHORT
            reentryTrigger := shortReentryTriggerNow
            reentryInvalid := shortReStopNow
            reentryTarget := reentryTrigger - reentryTargetPts
            reentryArmBar := bar_index
            reentryReason := "CONTINUATION AGAIN"
            continuationAttempted := true
            string reMetaS =
                 "V=OPT2B191|RE=1|SD=S|F=CONT_AGAIN|PT=" + str.tostring(hour(time, TRADE_TZ), "00") + str.tostring(minute(time, TRADE_TZ), "00") +
                 "|TRG=" + str.tostring(reentryTrigger, format.mintick) +
                 "|SL=" + str.tostring(reentryInvalid, format.mintick) +
                 "|TP=" + str.tostring(reentryTarget, format.mintick) +
                 "|ROOM=" + (na(shortReentryRoomNow) ? "NA" : str.tostring(shortReentryRoomNow, "#.##")) +
                 "|EFF=" + str.tostring(territoryEfficiency, "#.###") +
                 "|RV=" + str.tostring(moveParticipation, "#.###") +
                 "|RP=" + str.tostring(moveRangePace, "#.###") +
                 "|FPD=" + f_num(fpDeltaPct, "#.###") +
                 "|AMD=" + str.tostring(amdState)
            strategy.entry("S2", strategy.short, stop=reentryTrigger, comment=reMetaS, alert_message=f_autoEntry("SHORT", "REENTRY", reentryTrigger, reentryTarget, reentryInvalid))
            strategy.exit("S2-X", from_entry="S2", stop=reentryInvalid, limit=reentryTarget,
                 comment_profit="SELL AGAIN", comment_loss="STOP AGAIN",
                 alert_profit=f_autoExit("REENTRY_TARGET", "REENTRY"), alert_loss=f_autoExit("REENTRY_STOP", "REENTRY"))
            actionText := "ARM AGAIN PUT"
            internalNote := "MAIN PROFIT BANKED · ONE-TIME +$1 CONTINUATION READY"
            if showSignals
                label.new(bar_index, high, "ARM AGAIN PUT",
                     style=label.style_label_down, textcolor=color.white,
                     color=color.new(color.red, 20), size=size.tiny)
            alert(f_autoArm("SHORT", "REENTRY", reentryTrigger), alert.freq_once_per_bar_close)
        else if longArmReady
            pendingSide := SIDE_LONG
            armTrigger := high + tick
            armInvalid := longStop
            armExecInvalid := storyParticipationState == PART_REACCEL and storyQuestionGeometry ?
                 math.max(longStop, storyQuestionInvalid) :
                 math.max(longStop, math.min(low, low[1]) - stopBuf)
            float armRisk = math.max(armTrigger - armInvalid, tick)
            armQuickAtr := atr
            armQuickObjectivePts := moveMilestonePts
            armTarget := armTrigger + moveMilestonePts
            armBar := bar_index
            armReason := f_storyCauseText(storyCause) + " · " + f_storyText(storyState) + " · " +
                 f_participationText(storyParticipationState) +
                 (storyQuestionGeometry ? " · qR " + f_num(storyQuestionTargetPts, "#.##") + "/" +
                  f_num(storyQuestionRiskPts, "#.##") : "")
            armStoryCause := storyCause
            armStoryAnchor := storyAnchor
            armRefreshCount := 0
            string longSessionTag =
                 lateFailedDownLong ? "LATE_FD_PROVED" : "NORMAL"
            armMeta := f_buildArmMeta("L", armReason, longRoomR, armTrigger, armInvalid, armTarget,
                 "NA", longControlRearm ? "XFER" : "FRESH", "NA", armRefreshCount, longSessionTag,
                 propDailyRealizedR, propDailyStops, auditSnapshotNow) +
                      "|DMR=" + str.tostring(longMemoryRefreshReason) +
                      "|DMC=" + str.tostring(dirMemorySameSideCount) +
                      "|DMB=" + (dirMemoryBalanceSeen ? "1" : "0") +
                      "|DMO=" + (dirMemoryOppControlSeen ? "1" : "0") +
                      "|R2I=" + (storyInitiativeNow ? "1" : "0") +
                      "|EKN=" + (longDirectEvidenceKnown ? "1" : "0") +                      "|GXR=" + (longGlobalRenewalNow ? "1" : "0")
            longControlRearm := false
            episodeUsed := true
            storyUsedForMain := true
            eventArmLong := true
            actionText := "ARM CALL"
            strategy.entry("L", strategy.long, stop=armTrigger, comment=armMeta, alert_message=f_autoEntry("LONG", "PRIMARY", armTrigger, armTarget, armInvalid))
            strategy.exit("L-X", from_entry="L", stop=armInvalid,
                 comment_loss="STOP", alert_loss=f_autoExit("STOP", "PRIMARY"))
            alert(f_autoArm("LONG", "PRIMARY", armTrigger), alert.freq_once_per_bar_close)
        else if shortArmReady
            pendingSide := SIDE_SHORT
            armTrigger := low - tick
            armInvalid := shortStop
            armExecInvalid := storyParticipationState == PART_REACCEL and storyQuestionGeometry ?
                 math.min(shortStop, storyQuestionInvalid) :
                 math.min(shortStop, math.max(high, high[1]) + stopBuf)
            float armRisk = math.max(armInvalid - armTrigger, tick)
            armQuickAtr := atr
            armQuickObjectivePts := moveMilestonePts
            armTarget := armTrigger - moveMilestonePts
            armBar := bar_index
            armReason := f_storyCauseText(storyCause) + " · " + f_storyText(storyState) + " · " +
                 f_participationText(storyParticipationState) +
                 (storyQuestionGeometry ? " · qR " + f_num(storyQuestionTargetPts, "#.##") + "/" +
                  f_num(storyQuestionRiskPts, "#.##") : "")
            armStoryCause := storyCause
            armStoryAnchor := storyAnchor
            armRefreshCount := 0
            armMeta := f_buildArmMeta("S", armReason, shortRoomR, armTrigger, armInvalid, armTarget,
                 shortMaturityWait ? "PULLBACK_REARM" : "FRESH",
                 shortControlRearm ? "XFER" : "FRESH", "READY", armRefreshCount, "NORMAL",
                 propDailyRealizedR, propDailyStops, auditSnapshotNow) +
                      "|DMR=" + str.tostring(shortMemoryRefreshReason) +
                      "|DMC=" + str.tostring(dirMemorySameSideCount) +
                      "|DMB=" + (dirMemoryBalanceSeen ? "1" : "0") +
                      "|DMO=" + (dirMemoryOppControlSeen ? "1" : "0") +
                      "|R2I=" + (storyInitiativeNow ? "1" : "0") +
                      "|EKN=" + (shortDirectEvidenceKnown ? "1" : "0") +                      "|GXR=" + (shortGlobalRenewalNow ? "1" : "0")
            shortControlRearm := false
            shortMaturityWait := false
            shortPullbackSeen := false
            shortMaturityLow := na
            shortMaturityBar := na
            longControlWait := false
            shortControlWait := false
            longControlRearm := false
            shortControlRearm := false
            episodeUsed := true
            storyUsedForMain := true
            eventArmShort := true
            actionText := "ARM PUT"
            strategy.entry("S", strategy.short, stop=armTrigger, comment=armMeta, alert_message=f_autoEntry("SHORT", "PRIMARY", armTrigger, armTarget, armInvalid))
            strategy.exit("S-X", from_entry="S", stop=armInvalid,
                 comment_loss="STOP", alert_loss=f_autoExit("STOP", "PRIMARY"))
            alert(f_autoArm("SHORT", "PRIMARY", armTrigger), alert.freq_once_per_bar_close)
        else
            actionText := continuationWatch and continuationSide == SIDE_LONG ? "WATCH CALL AGAIN" :
                 continuationWatch and continuationSide == SIDE_SHORT ? "WATCH PUT AGAIN" :
                 episodeSide == SIDE_LONG and longControlWait ? "REVERSAL UNPROVEN — WAIT CONTROL" :
                 episodeSide == SIDE_SHORT and shortControlWait ? "REVERSAL UNPROVEN — WAIT CONTROL" :
                 episodeSide == SIDE_LONG and lateFailedDownLong and not longSessionRunwayReady ? "CALL REVERSAL — WAIT RUNWAY PROOF" :
                 episodeSide == SIDE_LONG and not longOptionsSuitable ? "CALL THESIS · WAIT MOVE PROOF" :
                 episodeSide == SIDE_LONG ? "CALL DEVELOPING" :
                 episodeSide == SIDE_SHORT and shortMaturityWait and not shortPullbackSeen ? "SHORT MATURE — WAIT PULLBACK" :
                 episodeSide == SIDE_SHORT and shortMaturityWait and shortPullbackSeen ? "WAIT FRESH SELLER RESPONSE" :
                 episodeSide == SIDE_SHORT and failedUpCausalConflict and not freshSellerResetEvent ? "SHORT THESIS CONFLICT — WAIT NEW SELLER EVENT" :
                 episodeSide == SIDE_SHORT and not shortParticipationReady ? "SHORT DEVELOPING — WAIT PARTICIPATION" :
                 episodeSide == SIDE_SHORT ? "SHORT DEVELOPING" :
                 not propExecutionWindow ? "WAIT — OUTSIDE PROP WINDOW" :
                 auctionCode == AUC_CHOP ? "WAIT — ROTATION" :
                 auctionCode == AUC_BALANCE ? "WATCH BALANCE EDGES" : "WAIT"
            if continuationWatch
                internalNote := "MAIN PROFIT BANKED · WAITING FOR ONE STRONG +$1 CONTINUATION"
if propShieldActive and strategy.position_size == 0
    actionText := "PROP SHIELD — SHADOW ONLY"
    internalNote := "STRUCTURAL STOP + DAY R <= 0 · EXECUTION LOCKED UNTIL NEXT PT DAY"
if strategy.closedtrades > lastClosedSeen
    int idx = strategy.closedtrades - 1
    string exitComment = strategy.closedtrades.exit_comment(idx)
    string exitEntryId = strategy.closedtrades.entry_id(idx)
    float exitPrice = strategy.closedtrades.exit_price(idx)
    float exitEntryPrice = strategy.closedtrades.entry_price(idx)
    bool exitedReentry = exitEntryId == "L2" or exitEntryId == "S2"
    bool exitedMain = exitEntryId == "L" or exitEntryId == "S"
    bool exitWasLong = str.startswith(exitEntryId, "L")
    int exitedSide = exitWasLong ? SIDE_LONG : SIDE_SHORT
    bool exitIsProtect = str.startswith(exitComment, "PROTECT")
    bool exitIsLock = str.startswith(exitComment, "LOCK")
    bool exitIsLifeBank = str.startswith(exitComment, "LIFE_BANK") or exitComment == "LOCK_FLOOR" or exitComment == "LIFE_FLOOR_BREACH"
    bool exitIsProfitBank = exitIsLock or exitIsLifeBank
    float realizedMovePts = exitWasLong ? exitPrice - exitEntryPrice : exitEntryPrice - exitPrice
    lastExitText := exitedReentry ? "SELL AGAIN" : "SELL"
    if exitIsProtect
        lastProtectCode := tradeProtectCode
        lastControlProtectEvent := tradeControlProtectEvent
    lastExitPrice := exitPrice
    eventExitTarget := false
    eventExitAgain := exitedReentry
    eventStop := not exitedReentry and (exitComment == "STOP" or exitComment == "FLOW_STOP")
    eventExitEarly := not exitedReentry and (str.startswith(exitComment, "EARLY") or exitIsProfitBank or
         exitComment == "LIFE_FAIL_LAUNCH")
    eventExitProtect := not exitedReentry and exitIsProtect
    eventExitTime := not exitedReentry and (exitComment == "TIME" or exitComment == "SELL_EXHAUST")
    bool continuationContextValid =
         not noTradeWindow and not sessionTransitionWindow and not sessionTransitionBoundary and
         episodeSide == exitedSide
    if exitedMain and exitIsProfitBank and realizedMovePts > 0 and continuationContextValid
        continuationWatch := true
        continuationSide := exitedSide
        continuationExitBar := bar_index
        continuationAttempted := false
        continuationResetSeen := false
        continuationResetBar := na
        continuationResetExtreme := na
    else if exitedMain
        continuationWatch := false
        continuationSide := SIDE_NONE
        continuationExitBar := na
        continuationAttempted := false
        continuationResetSeen := false
        continuationResetBar := na
        continuationResetExtreme := na
    if exitedReentry
        continuationWatch := false
        continuationSide := SIDE_NONE
        continuationExitBar := na
        continuationAttempted := true
        continuationResetSeen := false
        continuationResetBar := na
        continuationResetExtreme := na
        reentryPendingSide := SIDE_NONE
        reentryTrigger := na
        reentryInvalid := na
        reentryTarget := na
        reentryArmBar := na
        reentryReason := ""
    if exitedMain
        pendingSide := SIDE_NONE
        armTrigger := na
        armInvalid := na
        armExecInvalid := na
        armTarget := na
        armBar := na
        armReason := ""
        armMeta := ""
    episodeUsed := true
    tradeEntry := na
    tradeStop := na
    tradeExecInvalid := na
    tradeTarget := na
    tradeEntryBar := na
    tradeReason := ""
    tradeMeta := ""
    tradeQuickAtr := na
    tradeQuickObjectivePts := na
    tradeInitialRisk := na
    tradeMfeR := na
    tradeMaeR := na
    tradeProved05 := false
    tradeProved075 := false
    tradeProved100 := false
    tradeProof05Bar := na
    tradeCloseR := na
    tradeGivebackR := na
    tradeProtectEvidence := 0
    tradeProtectCode := 0
    tradeControlState := CT_UNPROVEN
    tradeControlEventId := 0
    tradeControlLastEvent := CT_EVT_NONE
    tradeControlChallengeCode := CT_EVT_NONE
    tradeControlChallengeBar := na
    tradeControlTransferBar := na
    tradeControlChallengeOrigin := na
    tradeControlChallengeExtreme := na
    tradeControlResponseSeen := false
    tradeControlChallengeCount := 0
    tradeControlRecoveryCount := 0
    tradeControlProtectEvent := CT_EVT_NONE
    tradeControlTransferPath := CT_PATH_NONE
    tradeControlTransferExtreme := na
    tradeMovePaid := false
    tradeMovePaidBar := na
    tradePeakMovePts := 0.0
    tradePrevPeakMovePts := 0.0
    tradeLifeState := LIFE_NONE
    tradeLifeStateBar := na
    tradeLifeExhaustBars := 0
    tradeProfitFloor := na
    activeIsReentry := false
    actionText := lastExitText
    lastClosedSeen := strategy.closedtrades
plotshape(showSignals and eventArmLong, title="ARM CALL", style=shape.labelup,
     location=location.belowbar, size=size.tiny, color=color.new(color.lime, 10),
     text="ARM CALL", textcolor=color.black)
plotshape(showSignals and eventArmShort, title="ARM PUT", style=shape.labeldown,
     location=location.abovebar, size=size.tiny, color=color.new(color.red, 10),
     text="ARM PUT", textcolor=color.white)
plotshape(showSignals and eventEnterLong, title="ENTER CALL", style=shape.labelup,
     location=location.belowbar, size=size.small, color=color.lime,
     text="ENTER CALL", textcolor=color.black)
plotshape(showSignals and eventEnterShort, title="ENTER PUT", style=shape.labeldown,
     location=location.abovebar, size=size.small, color=color.red,
     text="ENTER PUT", textcolor=color.white)
if showSignals and eventReenterLong
    label.new(bar_index, low, "ENTER AGAIN CALL",
         style=label.style_label_up, textcolor=color.black,
         color=color.new(color.lime, 0), size=size.small)
if showSignals and eventReenterShort
    label.new(bar_index, high, "ENTER AGAIN PUT",
         style=label.style_label_down, textcolor=color.white,
         color=color.new(color.red, 0), size=size.small)
if showSignals and eventExitAgain
    label.new(bar_index, close, "SELL AGAIN",
         style=label.style_label_down, textcolor=color.black,
         color=color.new(color.yellow, 0), size=size.small)
plotshape(showSignals and eventStop, title="STOP LOSS", style=shape.labeldown,
     location=location.abovebar, size=size.small, color=color.new(color.red, 0),
     text="STOP", textcolor=color.white)
plotshape(showSignals and eventExitEarly, title="EARLY EXIT", style=shape.labeldown,
     location=location.abovebar, size=size.small, color=color.new(color.orange, 0),
     text="SELL", textcolor=color.black)
plotshape(showSignals and eventExitProtect, title="PROVEN TRADE PROTECT", style=shape.labeldown,
     location=location.abovebar, size=size.small, color=color.new(color.yellow, 0),
     text="SELL", textcolor=color.black)
plotshape(showSignals and eventExitTime, title="MOVE EXHAUSTION / TIME EXIT", style=shape.labeldown,
     location=location.abovebar, size=size.small, color=color.new(color.gray, 10),
     text="SELL", textcolor=color.white)
plot(showTradeGeometry ? (reentryPendingSide != SIDE_NONE ? reentryTrigger :
     pendingSide != SIDE_NONE ? armTrigger : na) : na,
     "ARM Trigger", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(showTradeGeometry ? (reentryPendingSide != SIDE_NONE ? reentryInvalid :
     pendingSide != SIDE_NONE ? armInvalid : na) : na,
     "ARM Invalidation", color=color.red, linewidth=2, style=plot.style_linebr)
plot(showTradeGeometry and strategy.position_size != 0 ? tradeEntry : na,
     "Trade Entry", color=color.yellow, linewidth=2, style=plot.style_linebr)
plot(showTradeGeometry and strategy.position_size != 0 ?
     (not activeIsReentry and not na(tradeProfitFloor) ?
      (strategy.position_size > 0 ? math.max(tradeStop, tradeProfitFloor) : math.min(tradeStop, tradeProfitFloor)) :
      tradeStop) : na,
     "Trade Stop / Profit Floor", color=color.red, linewidth=2, style=plot.style_linebr)
